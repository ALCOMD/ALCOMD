{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "MCP project and backup workflows",
    "x-capability": "mcp.project-workflows.v1",
    "$id": "https://alcomd.vrclearn.com/schema/rpc/m8-mcp-project-workflows-v1.json",
    "x-methods": {
        "mcp.projectPaths.approve": {
            "params": "approvePath",
            "result": "approval"
        },
        "mcp.projects.register": {
            "params": "register",
            "result": "registration"
        },
        "projectTemplates.list": {
            "params": "listTemplates",
            "result": "templates"
        },
        "mcp.projects.create": {
            "params": "create",
            "result": "projectAccepted"
        },
        "mcp.projects.planCopy": {
            "params": "planCopy",
            "result": "copyPlan"
        },
        "mcp.projects.applyCopy": {
            "params": "applyCopy",
            "result": "copyAccepted"
        },
        "backups.list": {
            "params": "listBackups",
            "result": "backups"
        },
        "backups.get": {
            "params": "getBackup",
            "result": "backup"
        },
        "backups.create": {
            "params": "createBackup",
            "result": "backupAccepted"
        },
        "mcp.backups.planRestore": {
            "params": "planRestore",
            "result": "restorePlan"
        },
        "mcp.backups.applyRestore": {
            "params": "applyRestore",
            "result": "projectAccepted"
        }
    },
    "$defs": {
        "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
        },
        "integer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
        },
        "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "default"
                        },
                        "relativePath": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                        }
                    },
                    "required": [
                        "kind",
                        "relativePath"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "approved"
                        },
                        "approvalId": {
                            "$ref": "#/$defs/id"
                        }
                    },
                    "required": [
                        "kind",
                        "approvalId"
                    ]
                }
            ]
        },
        "target": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "default"
                        },
                        "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 255
                        }
                    },
                    "required": [
                        "kind",
                        "name"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "approved"
                        },
                        "approvalId": {
                            "$ref": "#/$defs/id"
                        }
                    },
                    "required": [
                        "kind",
                        "approvalId"
                    ]
                }
            ]
        },
        "templateReference": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "revision": {
                    "$ref": "#/$defs/revision"
                }
            },
            "required": [
                "id",
                "revision"
            ]
        },
        "register": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "source": {
                    "$ref": "#/$defs/source"
                },
                "idempotencyKey": {
                    "$ref": "#/$defs/key"
                }
            },
            "required": [
                "source",
                "idempotencyKey"
            ]
        },
        "registration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "project": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "projectId": {
                            "$ref": "#/$defs/id"
                        },
                        "revision": {
                            "$ref": "#/$defs/revision"
                        },
                        "displayName": {
                            "anyOf": [
                                {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 255
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "projectType": {
                            "enum": [
                                "avatars",
                                "worlds",
                                "legacy-avatars",
                                "legacy-worlds",
                                "unknown",
                                "vpm-starter",
                                "upm-avatars",
                                "upm-worlds",
                                "upm-starter",
                                "legacy-sdk2"
                            ]
                        },
                        "unityVersion": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                        }
                    },
                    "required": [
                        "projectId",
                        "revision",
                        "displayName",
                        "projectType",
                        "unityVersion"
                    ]
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "project",
                "replayed"
            ]
        },
        "approvePath": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "clientId": {
                    "$ref": "#/$defs/id"
                },
                "purpose": {
                    "enum": [
                        "register",
                        "create",
                        "copy",
                        "restore"
                    ]
                },
                "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                },
                "confirm": {
                    "const": true
                }
            },
            "required": [
                "clientId",
                "purpose",
                "path",
                "confirm"
            ]
        },
        "approval": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "approvalId": {
                    "$ref": "#/$defs/id"
                },
                "expiresAtMs": {
                    "$ref": "#/$defs/integer"
                }
            },
            "required": [
                "approvalId",
                "expiresAtMs"
            ]
        },
        "listTemplates": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "cursor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                }
            }
        },
        "templates": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "templates": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "id": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                            },
                            "name": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                            },
                            "editorVersion": {
                                "anyOf": [
                                    {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 128
                                    },
                                    {
                                        "type": "null"
                                    }
                                ]
                            },
                            "revision": {
                                "$ref": "#/$defs/revision"
                            },
                            "locked": {
                                "type": "boolean"
                            }
                        },
                        "required": [
                            "id",
                            "name",
                            "revision",
                            "locked"
                        ]
                    },
                    "maxItems": 100
                },
                "nextCursor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                }
            },
            "required": [
                "templates"
            ]
        },
        "create": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "target": {
                    "$ref": "#/$defs/target"
                },
                "unityVersion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "template": {
                    "$ref": "#/$defs/templateReference"
                },
                "idempotencyKey": {
                    "$ref": "#/$defs/key"
                }
            },
            "required": [
                "target",
                "unityVersion",
                "idempotencyKey"
            ]
        },
        "projectAccepted": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "operationId": {
                    "$ref": "#/$defs/id"
                },
                "projectId": {
                    "$ref": "#/$defs/id"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "operationId",
                "projectId",
                "replayed"
            ]
        },
        "planCopy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "sourceProjectId": {
                    "$ref": "#/$defs/id"
                },
                "expectedRevision": {
                    "$ref": "#/$defs/revision"
                },
                "target": {
                    "$ref": "#/$defs/target"
                },
                "idempotencyKey": {
                    "$ref": "#/$defs/key"
                }
            },
            "required": [
                "sourceProjectId",
                "expectedRevision",
                "target",
                "idempotencyKey"
            ]
        },
        "applyCopy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "planId": {
                    "$ref": "#/$defs/id"
                },
                "expectedRevision": {
                    "$ref": "#/$defs/revision"
                },
                "confirm": {
                    "const": true
                },
                "idempotencyKey": {
                    "$ref": "#/$defs/key"
                },
                "pathApprovalId": {
                    "$ref": "#/$defs/id"
                }
            },
            "required": [
                "planId",
                "expectedRevision",
                "confirm",
                "idempotencyKey"
            ]
        },
        "copyAccepted": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "operationId": {
                    "$ref": "#/$defs/id"
                },
                "targetProjectId": {
                    "$ref": "#/$defs/id"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "operationId",
                "targetProjectId",
                "replayed"
            ]
        },
        "copyPlan": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "planId": {
                    "$ref": "#/$defs/id"
                },
                "sourceProjectId": {
                    "$ref": "#/$defs/id"
                },
                "expectedRevision": {
                    "$ref": "#/$defs/revision"
                },
                "targetName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                },
                "targetProjectId": {
                    "$ref": "#/$defs/id"
                },
                "writerEvidence": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "state": {
                            "enum": [
                                "running_confirmed",
                                "running_suspected",
                                "not_observed",
                                "unknown"
                            ]
                        },
                        "observedAtMs": {
                            "$ref": "#/$defs/integer"
                        }
                    },
                    "required": [
                        "state",
                        "observedAtMs"
                    ]
                },
                "profile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                        },
                        "version": {
                            "$ref": "#/$defs/revision"
                        },
                        "includes": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                            },
                            "maxItems": 32
                        },
                        "excludes": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                            },
                            "maxItems": 32
                        },
                        "rejects": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                            },
                            "maxItems": 32
                        },
                        "quota": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "maxEntries": {
                                    "$ref": "#/$defs/integer"
                                },
                                "maxSingleFileBytes": {
                                    "$ref": "#/$defs/integer"
                                },
                                "maxTotalRegularFileBytes": {
                                    "$ref": "#/$defs/integer"
                                },
                                "maxDepth": {
                                    "$ref": "#/$defs/integer"
                                },
                                "maxNormalizedPathUtf8Bytes": {
                                    "$ref": "#/$defs/integer"
                                }
                            },
                            "required": [
                                "maxEntries",
                                "maxSingleFileBytes",
                                "maxTotalRegularFileBytes",
                                "maxDepth",
                                "maxNormalizedPathUtf8Bytes"
                            ]
                        }
                    },
                    "required": [
                        "id",
                        "version",
                        "includes",
                        "excludes",
                        "rejects",
                        "quota"
                    ]
                },
                "expiresAtMs": {
                    "$ref": "#/$defs/integer"
                },
                "planFingerprint": {
                    "$ref": "#/$defs/fingerprint"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "planId",
                "sourceProjectId",
                "expectedRevision",
                "targetName",
                "targetProjectId",
                "writerEvidence",
                "profile",
                "expiresAtMs",
                "planFingerprint",
                "replayed"
            ]
        },
        "compression": {
            "enum": [
                "store",
                "fast",
                "level3",
                "level5",
                "level7",
                "maximum"
            ]
        },
        "listBackups": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "projectId": {
                    "$ref": "#/$defs/id"
                },
                "cursor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                }
            }
        },
        "backups": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "backups": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/backup"
                    },
                    "maxItems": 1000
                },
                "nextCursor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                }
            },
            "required": [
                "backups"
            ]
        },
        "getBackup": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "backupId": {
                    "$ref": "#/$defs/id"
                }
            },
            "required": [
                "backupId"
            ]
        },
        "backup": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "backupId": {
                    "$ref": "#/$defs/id"
                },
                "sourceProjectId": {
                    "$ref": "#/$defs/id"
                },
                "archiveSha256": {
                    "$ref": "#/$defs/fingerprint"
                },
                "archiveBytes": {
                    "$ref": "#/$defs/integer"
                },
                "formatVersion": {
                    "$ref": "#/$defs/revision"
                },
                "createdAtMs": {
                    "$ref": "#/$defs/integer"
                },
                "compressionMode": {
                    "$ref": "#/$defs/compression"
                },
                "excludeVpmPackages": {
                    "type": "boolean"
                }
            },
            "required": [
                "backupId",
                "sourceProjectId",
                "archiveSha256",
                "archiveBytes",
                "formatVersion",
                "createdAtMs",
                "compressionMode",
                "excludeVpmPackages"
            ]
        },
        "createBackup": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "projectId": {
                    "$ref": "#/$defs/id"
                },
                "expectedRevision": {
                    "$ref": "#/$defs/revision"
                },
                "compressionMode": {
                    "$ref": "#/$defs/compression"
                },
                "excludeVpmPackages": {
                    "type": "boolean"
                },
                "includeLibrary": {
                    "type": "boolean"
                },
                "idempotencyKey": {
                    "$ref": "#/$defs/key"
                }
            },
            "required": [
                "projectId",
                "expectedRevision",
                "idempotencyKey"
            ]
        },
        "backupAccepted": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "operationId": {
                    "$ref": "#/$defs/id"
                },
                "backupId": {
                    "$ref": "#/$defs/id"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "operationId",
                "backupId",
                "replayed"
            ]
        },
        "planRestore": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "backupId": {
                    "$ref": "#/$defs/id"
                },
                "target": {
                    "$ref": "#/$defs/target"
                }
            },
            "required": [
                "backupId",
                "target"
            ]
        },
        "restorePlan": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "planId": {
                    "$ref": "#/$defs/id"
                },
                "projectId": {
                    "$ref": "#/$defs/id"
                },
                "backupId": {
                    "$ref": "#/$defs/id"
                },
                "targetName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                },
                "archiveSha256": {
                    "$ref": "#/$defs/fingerprint"
                },
                "packagesRequireResolve": {
                    "type": "boolean"
                },
                "excludedPackages": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "packageId": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                            },
                            "version": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                            }
                        },
                        "required": [
                            "packageId",
                            "version"
                        ]
                    },
                    "maxItems": 4096
                },
                "planFingerprint": {
                    "$ref": "#/$defs/fingerprint"
                }
            },
            "required": [
                "planId",
                "projectId",
                "backupId",
                "targetName",
                "archiveSha256",
                "packagesRequireResolve",
                "excludedPackages",
                "planFingerprint"
            ]
        },
        "applyRestore": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "planId": {
                    "$ref": "#/$defs/id"
                },
                "confirm": {
                    "const": true
                },
                "idempotencyKey": {
                    "$ref": "#/$defs/key"
                },
                "pathApprovalId": {
                    "$ref": "#/$defs/id"
                }
            },
            "required": [
                "planId",
                "confirm",
                "idempotencyKey"
            ]
        }
    }
}
