{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.vrclearn.com/schema/rpc/v1/m7-official-gui.json",
    "title": "ALCOMD RPC v1 M7 official GUI support contract",
    "x-alcomd-publication": "active-unreleased-breaking-replacement-rpc-v1",
    "x-alcomd-method-permissions": {
        "settings.get": [
            "settings.read"
        ],
        "settings.update": [
            "settings.manage"
        ],
        "unity.hub.open": [
            "settings.read",
            "unity.hub.open"
        ]
    },
    "x-alcomd-capability": null,
    "x-alcomd-method-capabilities": {
        "unity.hub.open": "unity.hub.open.v1"
    },
    "x-alcomd-redaction": {
        "forbidden": [
            "token",
            "authorization",
            "raw-argv",
            "environment",
            "full-private-path",
            "raw-sql",
            "rust-debug",
            "backtrace",
            "extension-owned-value",
            "portable-ui-payload",
            "raw-request-json",
            "raw-result-json"
        ],
        "authorizedSettingsPathException": [
            "settings.unity.hubPath",
            "unityHub.path",
            "settings.paths.projectDirectory",
            "settings.paths.backupDirectory",
            "directories.projectDirectory",
            "directories.backupDirectory"
        ]
    },
    "x-alcomd-field-permissions": {
        "settings.update.unity.defaultLaunchArguments": [
            "settings.manage",
            "unity.manage"
        ],
        "settings.update.projects.autoDiscover": [
            "settings.manage",
            "projects.manage"
        ]
    },
    "x-alcomd-conditional-field-permissions": {
        "settings.update.paths.projectDirectory": {
            "when": {
                "field": "projects.autoDiscover",
                "equals": true,
                "source": "effective-update"
            },
            "permissions": [
                "settings.manage",
                "projects.manage"
            ]
        }
    },
    "$defs": {
        "methodName": {
            "enum": [
                "settings.get",
                "settings.update",
                "unity.hub.open"
            ]
        },
        "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18446744073709551615
        },
        "hubOpenParams": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "expectedRevision",
                "expectedPath"
            ],
            "properties": {
                "expectedRevision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 18446744073709551615
                },
                "expectedPath": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
                }
            }
        },
        "hubOpenResult": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "outcome"
            ],
            "properties": {
                "outcome": {
                    "enum": [
                        "spawned",
                        "download_required"
                    ]
                }
            }
        },
        "settingsGetParams": {
            "type": "object",
            "additionalProperties": false
        },
        "unityHubLocation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "status",
                "source",
                "path",
                "configuredPathStatus"
            ],
            "properties": {
                "status": {
                    "enum": [
                        "available",
                        "not_found",
                        "unavailable"
                    ]
                },
                "source": {
                    "enum": [
                        "configured",
                        "discovered",
                        "none"
                    ]
                },
                "path": {
                    "$ref": "https://alcomd.vrclearn.com/schema/config/settings-v12.json#/$defs/hubPath"
                },
                "configuredPathStatus": {
                    "enum": [
                        "unset",
                        "available",
                        "invalid",
                        "unavailable"
                    ]
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "status": {
                                "const": "available"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "source": {
                                "enum": [
                                    "configured",
                                    "discovered"
                                ]
                            },
                            "path": {
                                "type": "string"
                            }
                        }
                    },
                    "else": {
                        "properties": {
                            "source": {
                                "const": "none"
                            },
                            "path": {
                                "type": "null"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "source": {
                                "const": "configured"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "configuredPathStatus": {
                                "const": "available"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "configuredPathStatus": {
                                "const": "available"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "source": {
                                "const": "configured"
                            },
                            "status": {
                                "const": "available"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "configuredPathStatus": {
                                "const": "unavailable"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "status": {
                                "const": "unavailable"
                            }
                        }
                    }
                }
            ]
        },
        "settingsGetResult": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "configSchema",
                "revision",
                "settings",
                "unityHub",
                "directories"
            ],
            "properties": {
                "configSchema": {
                    "const": 12
                },
                "revision": {
                    "$ref": "#/$defs/revision"
                },
                "settings": {
                    "$ref": "https://alcomd.vrclearn.com/schema/config/settings-v12.json#/$defs/settings"
                },
                "unityHub": {
                    "$ref": "#/$defs/unityHubLocation"
                },
                "directories": {
                    "$ref": "https://alcomd.vrclearn.com/schema/config/settings-v12.json#/$defs/storageDirectories"
                }
            }
        },
        "settingsUpdateParams": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "expectedRevision",
                "update"
            ],
            "properties": {
                "expectedRevision": {
                    "$ref": "#/$defs/revision"
                },
                "update": {
                    "$ref": "https://alcomd.vrclearn.com/schema/config/settings-v12.json#/$defs/partialUpdate"
                }
            }
        },
        "settingsUpdateResult": {
            "$ref": "#/$defs/settingsGetResult"
        }
    }
}
