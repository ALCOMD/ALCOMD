{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.vrclearn.com/schema/rpc/m8-mcp-repositories-v1.json",
    "title": "MCP repository management",
    "x-capability": "mcp.repositories.v1",
    "x-methods": {
        "mcp.repositories.list": {
            "params": "listInput",
            "result": "listResult"
        },
        "mcp.repositories.inspect": {
            "params": "inspectInput",
            "result": "inspectResult"
        },
        "mcp.repositories.register": {
            "params": "registerInput",
            "result": "writeResult"
        },
        "mcp.repositories.remove": {
            "params": "removeInput",
            "result": "writeResult"
        }
    },
    "$defs": {
        "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "safe": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
        },
        "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[!-~]+$"
        },
        "cursor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "registeredAtMs": {
                    "$ref": "#/$defs/safe"
                },
                "id": {
                    "$ref": "#/$defs/id"
                },
                "orderFingerprint": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                }
            },
            "required": [
                "registeredAtMs",
                "id",
                "orderFingerprint"
            ]
        },
        "entry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "repositoryId": {
                    "$ref": "#/$defs/id"
                },
                "displayName": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "revision": {
                    "$ref": "#/$defs/revision"
                },
                "sourceKind": {
                    "enum": [
                        "local",
                        "remote"
                    ]
                },
                "builtin": {
                    "type": "boolean"
                },
                "available": {
                    "type": "boolean"
                }
            },
            "required": [
                "repositoryId",
                "displayName",
                "revision",
                "sourceKind",
                "builtin",
                "available"
            ]
        },
        "listInput": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "cursor": {
                    "$ref": "#/$defs/cursor"
                },
                "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                }
            }
        },
        "listResult": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "repositories": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/entry"
                    },
                    "maxItems": 1000
                },
                "nextCursor": {
                    "$ref": "#/$defs/cursor"
                }
            },
            "required": [
                "repositories"
            ]
        },
        "inspectInput": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                }
            },
            "required": [
                "url"
            ]
        },
        "inspectResult": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "previewId": {
                    "$ref": "#/$defs/id"
                },
                "displayName": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "versionCount": {
                    "$ref": "#/$defs/safe"
                }
            },
            "required": [
                "displayName",
                "versionCount"
            ]
        },
        "registerInput": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "previewId": {
                    "$ref": "#/$defs/id"
                },
                "confirm": {
                    "const": true
                },
                "idempotencyKey": {
                    "$ref": "#/$defs/key"
                }
            },
            "required": [
                "previewId",
                "confirm",
                "idempotencyKey"
            ]
        },
        "removeInput": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "repositoryId": {
                    "$ref": "#/$defs/id"
                },
                "expectedRevision": {
                    "$ref": "#/$defs/revision"
                },
                "confirm": {
                    "const": true
                },
                "idempotencyKey": {
                    "$ref": "#/$defs/key"
                }
            },
            "required": [
                "repositoryId",
                "expectedRevision",
                "confirm",
                "idempotencyKey"
            ]
        },
        "writeResult": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "repositoryId": {
                    "$ref": "#/$defs/id"
                },
                "revision": {
                    "$ref": "#/$defs/revision"
                },
                "repository": {
                    "$ref": "#/$defs/entry"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "repositoryId",
                "revision",
                "replayed"
            ]
        }
    }
}
