{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.vrclearn.com/schema/rpc/v1/m7-repository-list.json",
    "title": "ALCOMD RPC v1 repository list file exchange",
    "description": "Explicit export writes user remote repositories in VCC list format, including saved request headers for authenticated entries. Built-in repositories are omitted and credentials are not returned in RPC results.",
    "$defs": {
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "absolutePath": {"type": "string", "minLength": 1, "maxLength": 32768},
        "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "line": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 100},
        "inspectListFileParams": {
            "type": "object", "additionalProperties": false, "required": ["path"],
            "properties": {"path": {"$ref": "#/$defs/absolutePath"}}
        },
        "importListFileParams": {
            "type": "object", "additionalProperties": false, "required": ["path", "expectedFingerprint", "idempotencyKey"],
            "properties": {
                "path": {"$ref": "#/$defs/absolutePath"},
                "expectedFingerprint": {"$ref": "#/$defs/fingerprint"},
                "idempotencyKey": {"$ref": "#/$defs/idempotencyKey"}
            }
        },
        "importListFileResult": {
            "type": "object", "additionalProperties": false, "required": ["items"],
            "properties": {"items": {"type": "array", "maxItems": 4096, "items": {
                "oneOf": [
                    {"type": "object", "additionalProperties": false, "required": ["line", "status"], "properties": {"line": {"$ref": "#/$defs/line"}, "status": {"enum": ["added", "existing", "unprocessed"]}}},
                    {"type": "object", "additionalProperties": false, "required": ["line", "status", "code"], "properties": {"line": {"$ref": "#/$defs/line"}, "status": {"enum": ["failed", "unknown"]}, "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 128}}}
                ]
            }}}
        },
        "cancelListRegistrationParams": {
            "type": "object", "additionalProperties": false, "required": ["idempotencyKey"],
            "properties": {"idempotencyKey": {"$ref": "#/$defs/idempotencyKey"}}
        },
        "cancelListRegistrationResult": {
            "type": "object", "additionalProperties": false, "required": ["stopped"],
            "properties": {"stopped": {"type": "boolean"}}
        },
        "remoteSource": {
            "type": "object", "additionalProperties": false, "required": ["kind", "url"],
            "properties": {"kind": {"const": "remote"}, "url": {"type": "string", "minLength": 1, "maxLength": 2048}}
        },
        "entry": {
            "type": "object", "additionalProperties": false, "required": ["line", "status"],
            "properties": {
                "line": {"$ref": "#/$defs/line"},
                "status": {"enum": ["candidate", "duplicate", "invalid", "unsupported"]},
                "source": {"$ref": "#/$defs/remoteSource"},
                "credentialsConfigured": {"type": "boolean"},
                "reason": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 128}
            },
            "allOf": [
                {"if": {"properties": {"status": {"enum": ["candidate", "duplicate"]}}}, "then": {"required": ["source"]}},
                {"if": {"properties": {"status": {"enum": ["invalid", "unsupported"]}}}, "then": {"required": ["reason"], "not": {"required": ["source"]}}}
            ]
        },
        "inspectListFileResult": {
            "type": "object", "additionalProperties": false, "required": ["entries", "ignoredLines", "fingerprint"],
            "properties": {
                "entries": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/entry"}},
                "ignoredLines": {"type": "integer", "minimum": 0, "maximum": 1048576},
                "fingerprint": {"$ref": "#/$defs/fingerprint"}
            }
        },
        "previewListExportParams": {"type": "object", "additionalProperties": false},
        "exclusion": {
            "type": "object", "additionalProperties": false, "required": ["repositoryId", "reason"],
            "properties": {
                "repositoryId": {"$ref": "#/$defs/uuid"},
                "reason": {"enum": ["local_source", "authentication_not_supported", "unsupported_source"]}
            }
        },
        "previewListExportResult": {
            "type": "object", "additionalProperties": false,
            "required": ["exportableCount", "excluded", "byteCount", "fingerprint"],
            "properties": {
                "exportableCount": {"type": "integer", "minimum": 0, "maximum": 4096},
                "excluded": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/exclusion"}},
                "byteCount": {"type": "integer", "minimum": 0, "maximum": 1048576},
                "fingerprint": {"$ref": "#/$defs/fingerprint"}
            }
        },
        "exportListFileParams": {
            "type": "object", "additionalProperties": false, "required": ["targetPath", "expectedFingerprint"],
            "properties": {
                "targetPath": {"$ref": "#/$defs/absolutePath"},
                "expectedFingerprint": {"$ref": "#/$defs/fingerprint"}
            }
        },
        "exportListFileResult": {
            "type": "object", "additionalProperties": false, "required": ["exportedCount", "byteCount", "sha256"],
            "properties": {
                "exportedCount": {"type": "integer", "minimum": 0, "maximum": 4096},
                "byteCount": {"type": "integer", "minimum": 0, "maximum": 1048576},
                "sha256": {"$ref": "#/$defs/fingerprint"}
            }
        }
    },
    "type": "object",
    "additionalProperties": true
}
