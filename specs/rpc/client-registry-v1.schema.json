{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.vrclearn.com/schema/rpc/v1/client-registry.json",
    "$defs": {
        "clientsListParams": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
                "cursor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 128
                }
            }
        },
        "clientInstancesListParams": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "programKey"
            ],
            "properties": {
                "programKey": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                },
                "cursor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 128
                }
            }
        },
        "clientsDisconnectParams": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "expectedCoreInstanceId",
                "target",
                "idempotencyKey"
            ],
            "properties": {
                "expectedCoreInstanceId": {
                    "type": "string",
                    "format": "uuid"
                },
                "target": {
                    "oneOf": [
                        {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "kind",
                                "id"
                            ],
                            "properties": {
                                "kind": {
                                    "const": "connection"
                                },
                                "id": {
                                    "type": "string",
                                    "format": "uuid"
                                }
                            }
                        },
                        {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "kind",
                                "id"
                            ],
                            "properties": {
                                "kind": {
                                    "const": "instance"
                                },
                                "id": {
                                    "type": "string",
                                    "format": "uuid"
                                }
                            }
                        }
                    ]
                },
                "idempotencyKey": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                }
            }
        },
        "clientsDisconnectResult": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "disconnectedConnectionIds"
            ],
            "properties": {
                "disconnectedConnectionIds": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "maxItems": 1024
                }
            }
        },
        "installation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "scope",
                "productVersion"
            ],
            "properties": {
                "scope": {
                    "enum": [
                        "user",
                        "machine"
                    ]
                },
                "productVersion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                }
            }
        },
        "program": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "programKey",
                "displayName",
                "kind",
                "installations",
                "activeInstanceCount",
                "activeConnectionCount"
            ],
            "properties": {
                "programKey": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                },
                "programId": {
                    "type": "string",
                    "maxLength": 128,
                    "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
                },
                "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                },
                "kind": {
                    "enum": [
                        "gui",
                        "cli",
                        "mcp",
                        "unknown"
                    ]
                },
                "installations": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/installation"
                    },
                    "maxItems": 3
                },
                "activeInstanceCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1024
                },
                "activeConnectionCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1024
                }
            }
        },
        "reported": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "version",
                "instanceId"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                },
                "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                },
                "instanceId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                }
            }
        },
        "connection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "connectionId",
                "connectedAtMs",
                "reported"
            ],
            "properties": {
                "connectionId": {
                    "type": "string",
                    "format": "uuid"
                },
                "connectedAtMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                },
                "reported": {
                    "$ref": "#/$defs/reported"
                }
            }
        },
        "instance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "instanceId",
                "connections"
            ],
            "properties": {
                "instanceId": {
                    "type": "string",
                    "format": "uuid"
                },
                "connections": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/connection"
                    },
                    "maxItems": 1024
                }
            }
        },
        "clientsListResult": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "coreInstanceId",
                "items",
                "coverageIncomplete"
            ],
            "properties": {
                "coreInstanceId": {
                    "type": "string",
                    "format": "uuid"
                },
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/program"
                    },
                    "maxItems": 128
                },
                "nextCursor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "coverageIncomplete": {
                    "type": "boolean"
                }
            }
        },
        "clientInstancesListResult": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "coreInstanceId",
                "items"
            ],
            "properties": {
                "coreInstanceId": {
                    "type": "string",
                    "format": "uuid"
                },
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/instance"
                    },
                    "maxItems": 128
                },
                "nextCursor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                }
            }
        }
    }
}
