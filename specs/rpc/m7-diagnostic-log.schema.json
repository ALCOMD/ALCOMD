{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.cqmhv.com/schema/rpc/v1/m7-diagnostic-log.json",
    "title": "ALCOMD bounded safe Core log reads",
    "x-alcomd-method-permissions": {"diagnostics.log.read": ["diagnostics.read"]},
    "x-alcomd-method-capabilities": {"diagnostics.log.read": "diagnostics.log.v1"},
    "x-alcomd-method-params": {"diagnostics.log.read": "#/$defs/readParams"},
    "x-alcomd-method-results": {"diagnostics.log.read": "#/$defs/readResult"},
    "x-alcomd-local-owner-only": true,
    "x-alcomd-buffer-capacity": 1024,
    "$defs": {
        "methodName": {"const": "diagnostics.log.read"},
        "safeInteger": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "identity": {"type": "string", "minLength": 36, "maxLength": 36, "pattern": "^[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$"},
        "code": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z][a-z0-9._-]*$"},
        "cursor": {
            "type": "object", "additionalProperties": false, "required": ["instanceId", "sequence"],
            "properties": {"instanceId": {"$ref": "#/$defs/identity"}, "sequence": {"$ref": "#/$defs/safeInteger"}}
        },
        "readParams": {
            "type": "object", "additionalProperties": false,
            "properties": {
                "cursor": {"$ref": "#/$defs/cursor"},
                "limit": {"type": "integer", "minimum": 1, "maximum": 200, "default": 100},
                "waitMs": {"type": "integer", "minimum": 0, "maximum": 20000, "default": 0}
            }
        },
        "item": {
            "type": "object", "additionalProperties": false,
            "required": ["instanceId", "sequence", "occurredAtMs", "level", "code", "notify"],
            "properties": {
                "instanceId": {"$ref": "#/$defs/identity"},
                "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
                "occurredAtMs": {"$ref": "#/$defs/safeInteger"},
                "level": {"enum": ["trace", "debug", "info", "warning", "error"]},
                "code": {"$ref": "#/$defs/code"},
                "diagnosticId": {"$ref": "#/$defs/identity"},
                "notify": {"type": "boolean"}
            }
        },
        "readResult": {
            "type": "object", "additionalProperties": false, "required": ["items", "nextCursor", "reset", "gap"],
            "properties": {
                "items": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/item"}},
                "nextCursor": {"$ref": "#/$defs/cursor"},
                "reset": {"type": "boolean"},
                "gap": {"type": "boolean"}
            }
        }
    }
}
