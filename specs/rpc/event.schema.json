{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.vrclearn.com/schema/rpc/v1/event.json",
    "title": "ALCOMD RPC v1 durable Event",
    "type": "object",
    "additionalProperties": true,
    "required": ["sequence", "eventId", "kind", "aggregateKind", "aggregateId", "aggregateRevision", "occurredAtMs", "payload"],
    "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "eventId": {"type": "string", "format": "uuid"},
        "kind": {"type": "string", "minLength": 1, "maxLength": 128},
        "aggregateKind": {"type": "string", "enum": ["operation", "project", "repository", "unity-installation", "project-editor-preference", "project-unity-launch-config", "project-template", "user-package"]},
        "aggregateId": {"type": "string", "format": "uuid"},
        "aggregateRevision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "occurredAtMs": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "payload": {"type": "object"}
    }
}
