{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.cqmhv.com/schema/rpc/v1/state-check.response.json",
    "title": "ALCOMD RPC v1 state.check response",
    "type": "object",
    "additionalProperties": true,
    "required": ["id", "result"],
    "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "result": {
            "type": "object",
            "additionalProperties": true,
            "required": ["operationId", "replayed"],
            "properties": {
                "operationId": {"type": "string", "format": "uuid"},
                "replayed": {"type": "boolean"}
            }
        }
    }
}
