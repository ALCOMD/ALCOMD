{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.vrclearn.com/schema/mcp/repositories-v1.json",
    "title": "MCP repository management",
    "x-capability": "mcp.repositories.v1",
    "x-alcomd-tools": [
        {
            "name": "alcomd_list_repositories",
            "title": "List registered repositories",
            "description": "Read the shared repository registry.",
            "inputSchema": {
                "type": "object",
                "$ref": "#/$defs/listInput"
            },
            "outputSchema": {
                "oneOf": [
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "data": {
                                "$ref": "#/$defs/listResult"
                            }
                        },
                        "required": [
                            "data"
                        ]
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "error": {
                                "$ref": "#/$defs/toolError"
                            }
                        },
                        "required": [
                            "error"
                        ]
                    }
                ]
            },
            "effect": "read",
            "requiredPermissions": [
                "repositories.read"
            ],
            "annotations": {
                "readOnlyHint": true,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false
            }
        },
        {
            "name": "alcomd_inspect_repository",
            "title": "Inspect a repository",
            "description": "Inspect a remote URL before confirming registration.",
            "inputSchema": {
                "type": "object",
                "$ref": "#/$defs/inspectInput"
            },
            "outputSchema": {
                "oneOf": [
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "data": {
                                "$ref": "#/$defs/inspectResult"
                            }
                        },
                        "required": [
                            "data"
                        ]
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "error": {
                                "$ref": "#/$defs/toolError"
                            }
                        },
                        "required": [
                            "error"
                        ]
                    }
                ]
            },
            "effect": "read",
            "requiredPermissions": [
                "repositories.read"
            ],
            "annotations": {
                "readOnlyHint": true,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": true
            }
        },
        {
            "name": "alcomd_register_repository",
            "title": "Register a reviewed repository",
            "description": "Confirm the inspected preview ID to add that repository.",
            "inputSchema": {
                "type": "object",
                "$ref": "#/$defs/registerInput"
            },
            "outputSchema": {
                "oneOf": [
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "data": {
                                "$ref": "#/$defs/writeResult"
                            }
                        },
                        "required": [
                            "data"
                        ]
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "error": {
                                "$ref": "#/$defs/toolError"
                            }
                        },
                        "required": [
                            "error"
                        ]
                    }
                ]
            },
            "effect": "apply",
            "requiredPermissions": [
                "repositories.manage"
            ],
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": true
            }
        },
        {
            "name": "alcomd_refresh_repository",
            "title": "Refresh a repository",
            "description": "Refresh the registered source using its current revision.",
            "inputSchema": {
                "type": "object",
                "$ref": "#/$defs/refreshInput"
            },
            "outputSchema": {
                "oneOf": [
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "data": {
                                "$ref": "#/$defs/writeResult"
                            }
                        },
                        "required": [
                            "data"
                        ]
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "error": {
                                "$ref": "#/$defs/toolError"
                            }
                        },
                        "required": [
                            "error"
                        ]
                    }
                ]
            },
            "effect": "apply",
            "requiredPermissions": [
                "repositories.manage"
            ],
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": true
            }
        },
        {
            "name": "alcomd_remove_repository",
            "title": "Remove a repository",
            "description": "Confirm removal of a registered non-builtin repository at the expected revision.",
            "inputSchema": {
                "type": "object",
                "$ref": "#/$defs/removeInput"
            },
            "outputSchema": {
                "oneOf": [
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "data": {
                                "$ref": "#/$defs/writeResult"
                            }
                        },
                        "required": [
                            "data"
                        ]
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "error": {
                                "$ref": "#/$defs/toolError"
                            }
                        },
                        "required": [
                            "error"
                        ]
                    }
                ]
            },
            "effect": "apply",
            "requiredPermissions": [
                "repositories.manage"
            ],
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": true,
                "idempotentHint": true,
                "openWorldHint": false
            }
        }
    ],
    "$defs": {
        "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "safe": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
        },
        "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[!-~]+$"
        },
        "cursor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "registered_at_ms": {
                    "$ref": "#/$defs/safe"
                },
                "id": {
                    "$ref": "#/$defs/id"
                }
            },
            "required": [
                "registered_at_ms",
                "id"
            ]
        },
        "entry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "repository_id": {
                    "$ref": "#/$defs/id"
                },
                "display_name": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "revision": {
                    "$ref": "#/$defs/revision"
                },
                "source_kind": {
                    "enum": [
                        "local",
                        "remote"
                    ]
                },
                "builtin": {
                    "type": "boolean"
                },
                "available": {
                    "type": "boolean"
                }
            },
            "required": [
                "repository_id",
                "display_name",
                "revision",
                "source_kind",
                "builtin",
                "available"
            ]
        },
        "listInput": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "cursor": {
                    "$ref": "#/$defs/cursor"
                },
                "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                }
            }
        },
        "listResult": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "repositories": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/entry"
                    },
                    "maxItems": 1000
                },
                "next_cursor": {
                    "$ref": "#/$defs/cursor"
                }
            },
            "required": [
                "repositories"
            ]
        },
        "inspectInput": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                }
            },
            "required": [
                "url"
            ]
        },
        "inspectResult": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "preview_id": {
                    "$ref": "#/$defs/id"
                },
                "display_name": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "version_count": {
                    "$ref": "#/$defs/safe"
                }
            },
            "required": [
                "display_name",
                "version_count"
            ]
        },
        "registerInput": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "preview_id": {
                    "$ref": "#/$defs/id"
                },
                "confirm": {
                    "const": true
                },
                "idempotency_key": {
                    "$ref": "#/$defs/key"
                }
            },
            "required": [
                "preview_id",
                "confirm",
                "idempotency_key"
            ]
        },
        "refreshInput": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "repository_id": {
                    "$ref": "#/$defs/id"
                },
                "expected_revision": {
                    "$ref": "#/$defs/revision"
                },
                "idempotency_key": {
                    "$ref": "#/$defs/key"
                }
            },
            "required": [
                "repository_id",
                "expected_revision",
                "idempotency_key"
            ]
        },
        "removeInput": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "repository_id": {
                    "$ref": "#/$defs/id"
                },
                "expected_revision": {
                    "$ref": "#/$defs/revision"
                },
                "confirm": {
                    "const": true
                },
                "idempotency_key": {
                    "$ref": "#/$defs/key"
                }
            },
            "required": [
                "repository_id",
                "expected_revision",
                "confirm",
                "idempotency_key"
            ]
        },
        "writeResult": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "repository_id": {
                    "$ref": "#/$defs/id"
                },
                "revision": {
                    "$ref": "#/$defs/revision"
                },
                "repository": {
                    "$ref": "#/$defs/entry"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "repository_id",
                "revision",
                "replayed"
            ]
        },
        "toolError": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                },
                "retryable": {
                    "type": "boolean"
                },
                "diagnostic_id": {
                    "type": "string",
                    "maxLength": 128
                },
                "outcome": {
                    "const": "unknown"
                }
            },
            "required": [
                "code",
                "message",
                "retryable"
            ]
        }
    }
}
