{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.vrclearn.com/schema/rpc/m8-mcp-packages-v1.json",
    "title": "Approved MCP package catalog and plan projection",
    "x-capability": "mcp.packages.catalog-plan.v1",
    "x-methods": {
        "mcp.packages.query": {
            "params": "queryParams",
            "result": "queryResult"
        },
        "mcp.packages.plan": {
            "params": "planParams",
            "result": "planResult"
        }
    },
    "$defs": {
        "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
        },
        "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "packageId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "cursor": {
            "type": "string",
            "pattern": "^[0-9]{1,8}\\.[0-9a-f]{64}$"
        },
        "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
        },
        "source": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "repository"
                        },
                        "repositoryId": {
                            "$ref": "#/$defs/id"
                        }
                    },
                    "required": [
                        "kind",
                        "repositoryId"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "user_package"
                        },
                        "userPackageId": {
                            "$ref": "#/$defs/id"
                        }
                    },
                    "required": [
                        "kind",
                        "userPackageId"
                    ]
                }
            ]
        },
        "selector": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "latest_compatible"
                        }
                    },
                    "required": [
                        "kind"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "exact"
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                        }
                    },
                    "required": [
                        "kind",
                        "version"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "range"
                        },
                        "range": {
                            "$ref": "#/$defs/versionRange"
                        }
                    },
                    "required": [
                        "kind",
                        "range"
                    ]
                }
            ]
        },
        "compatibility": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "unity": {
                    "enum": [
                        "not_required",
                        "compatible",
                        "incompatible",
                        "unknown"
                    ]
                },
                "eligibility": {
                    "enum": [
                        "eligible",
                        "blocked",
                        "unknown"
                    ]
                },
                "reasons": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                    }
                }
            },
            "required": [
                "unity",
                "eligibility",
                "reasons"
            ]
        },
        "sourceItem": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "source": {
                    "$ref": "#/$defs/source"
                },
                "displayName": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "availability": {
                    "enum": [
                        "available",
                        "hidden",
                        "authentication_required",
                        "unsupported",
                        "refresh_required"
                    ]
                }
            },
            "required": [
                "source",
                "displayName",
                "availability"
            ]
        },
        "summaryItem": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "packageId": {
                    "$ref": "#/$defs/packageId"
                },
                "displayName": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                },
                "lockedVersion": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "sources": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/source"
                    },
                    "maxItems": 4096
                },
                "compatibility": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/compatibility"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "packageId",
                "displayName",
                "version",
                "lockedVersion",
                "sources",
                "compatibility"
            ]
        },
        "versionItem": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "packageId": {
                    "$ref": "#/$defs/packageId"
                },
                "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                },
                "source": {
                    "$ref": "#/$defs/source"
                },
                "displayName": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "description": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 65536
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "unity": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "unityRelease": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "documentationUrl": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 8192
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "changelogUrl": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 8192
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "aliases": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                    },
                    "maxItems": 128
                },
                "keywords": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                    },
                    "maxItems": 128
                },
                "legacyPackages": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/packageId"
                    },
                    "maxItems": 128
                },
                "dependencies": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                    }
                },
                "yanked": {
                    "type": "boolean"
                },
                "compatibility": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/compatibility"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "packageId",
                "version",
                "source",
                "displayName",
                "description",
                "unity",
                "unityRelease",
                "documentationUrl",
                "changelogUrl",
                "aliases",
                "keywords",
                "legacyPackages",
                "dependencies",
                "yanked",
                "compatibility"
            ]
        },
        "planMutation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "enum": [
                        "install",
                        "remove",
                        "replace"
                    ]
                },
                "packageId": {
                    "$ref": "#/$defs/packageId"
                },
                "fromVersion": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "toVersion": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "source": {
                    "type": "null"
                }
            },
            "required": [
                "kind",
                "packageId",
                "fromVersion",
                "toVersion",
                "source"
            ]
        },
        "planChanges": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "formatVersion": {
                    "const": 1
                },
                "mutations": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/planMutation"
                    },
                    "maxItems": 4096
                },
                "dependencyEdges": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "fromPackageId": {
                                "$ref": "#/$defs/packageId"
                            },
                            "toPackageId": {
                                "$ref": "#/$defs/packageId"
                            },
                            "range": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 4096
                            },
                            "direct": {
                                "type": "boolean"
                            }
                        },
                        "required": [
                            "fromPackageId",
                            "toPackageId",
                            "range",
                            "direct"
                        ]
                    }
                },
                "legacyRemovals": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "path": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 4096
                            },
                            "kind": {
                                "enum": [
                                    "file",
                                    "directory"
                                ]
                            },
                            "packageId": {
                                "$ref": "#/$defs/packageId"
                            }
                        },
                        "required": [
                            "path",
                            "kind",
                            "packageId"
                        ]
                    }
                },
                "vpmManifestSha256": {
                    "$ref": "#/$defs/hash"
                },
                "removalConflicts": {
                    "type": "array",
                    "items": {
                        "type": "object"
                    }
                },
                "unityCompatibilityOverrides": {
                    "type": "array",
                    "items": {
                        "type": "object"
                    }
                }
            },
            "required": [
                "formatVersion",
                "mutations",
                "dependencyEdges",
                "vpmManifestSha256"
            ]
        },
        "plan": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "planId": {
                    "$ref": "#/$defs/id"
                },
                "projectId": {
                    "$ref": "#/$defs/id"
                },
                "projectRevision": {
                    "$ref": "#/$defs/revision"
                },
                "action": {
                    "enum": [
                        "install",
                        "remove",
                        "upgrade",
                        "downgrade",
                        "resolve",
                        "reinstall",
                        "bulk"
                    ]
                },
                "state": {
                    "const": "unapplied"
                },
                "changeSetFingerprint": {
                    "$ref": "#/$defs/hash"
                },
                "changeSet": {
                    "$ref": "#/$defs/planChanges"
                }
            },
            "required": [
                "planId",
                "projectId",
                "projectRevision",
                "action",
                "state",
                "changeSetFingerprint",
                "changeSet"
            ]
        },
        "planSource": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "packageId": {
                    "$ref": "#/$defs/packageId"
                },
                "source": {
                    "$ref": "#/$defs/source"
                },
                "displayName": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "packageId",
                "source",
                "displayName"
            ]
        },
        "project": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "projectId": {
                    "$ref": "#/$defs/id"
                },
                "expectedRevision": {
                    "$ref": "#/$defs/revision",
                    "description": "The registered project's content revision."
                }
            },
            "required": [
                "projectId",
                "expectedRevision"
            ]
        },
        "view": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "sources"
                        }
                    },
                    "required": [
                        "kind"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "summary"
                        },
                        "query": {
                            "anyOf": [
                                {
                                    "type": "string",
                                    "maxLength": 256,
                                    "minLength": 0
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "repositoryId": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/id"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        }
                    },
                    "required": [
                        "kind"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "versions"
                        },
                        "packageId": {
                            "$ref": "#/$defs/packageId"
                        },
                        "version": {
                            "anyOf": [
                                {
                                    "type": "string",
                                    "maxLength": 256,
                                    "minLength": 1
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "source": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/source"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        }
                    },
                    "required": [
                        "kind",
                        "packageId"
                    ]
                }
            ]
        },
        "queryParams": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "view": {
                    "$ref": "#/$defs/view"
                },
                "project": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/project"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "cursor": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/cursor"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "limit": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/limit"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "view"
            ],
            "if": {
                "properties": {
                    "view": {
                        "properties": {
                            "kind": {
                                "const": "sources"
                            }
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "project": {
                        "type": "null"
                    }
                }
            }
        },
        "queryResult": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "sources"
                        },
                        "items": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/sourceItem"
                            },
                            "maxItems": 200
                        },
                        "snapshot": {
                            "$ref": "#/$defs/hash"
                        },
                        "catalogComplete": {
                            "type": "boolean"
                        },
                        "nextCursor": {
                            "$ref": "#/$defs/cursor"
                        }
                    },
                    "required": [
                        "kind",
                        "items",
                        "snapshot",
                        "catalogComplete"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "summary"
                        },
                        "items": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/summaryItem"
                            },
                            "maxItems": 200
                        },
                        "snapshot": {
                            "$ref": "#/$defs/hash"
                        },
                        "catalogComplete": {
                            "type": "boolean"
                        },
                        "nextCursor": {
                            "$ref": "#/$defs/cursor"
                        }
                    },
                    "required": [
                        "kind",
                        "items",
                        "snapshot",
                        "catalogComplete"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "versions"
                        },
                        "items": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/versionItem"
                            },
                            "maxItems": 200
                        },
                        "snapshot": {
                            "$ref": "#/$defs/hash"
                        },
                        "catalogComplete": {
                            "type": "boolean"
                        },
                        "nextCursor": {
                            "$ref": "#/$defs/cursor"
                        }
                    },
                    "required": [
                        "kind",
                        "items",
                        "snapshot",
                        "catalogComplete"
                    ]
                }
            ]
        },
        "intent": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "install"
                        },
                        "versionSelector": {
                            "$ref": "#/$defs/selector",
                            "description": "Omit to use the Core recommendation. Specify an exact version or range to constrain selection."
                        },
                        "includePrerelease": {
                            "type": "boolean"
                        },
                        "allowUnityIncompatible": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "kind"
                    ],
                    "allOf": [
                        {
                            "if": {
                                "required": [
                                    "allowUnityIncompatible"
                                ],
                                "properties": {
                                    "allowUnityIncompatible": {
                                        "const": true
                                    }
                                }
                            },
                            "then": {
                                "properties": {
                                    "versionSelector": {
                                        "properties": {
                                            "kind": {
                                                "const": "exact"
                                            }
                                        }
                                    }
                                },
                                "required": [
                                    "versionSelector"
                                ]
                            }
                        }
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "upgrade"
                        },
                        "versionSelector": {
                            "$ref": "#/$defs/selector",
                            "description": "Omit to use the Core recommendation. Specify an exact version or range to constrain selection."
                        },
                        "includePrerelease": {
                            "type": "boolean"
                        },
                        "allowUnityIncompatible": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "kind"
                    ],
                    "allOf": [
                        {
                            "if": {
                                "required": [
                                    "allowUnityIncompatible"
                                ],
                                "properties": {
                                    "allowUnityIncompatible": {
                                        "const": true
                                    }
                                }
                            },
                            "then": {
                                "properties": {
                                    "versionSelector": {
                                        "properties": {
                                            "kind": {
                                                "const": "exact"
                                            }
                                        }
                                    }
                                },
                                "required": [
                                    "versionSelector"
                                ]
                            }
                        }
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "downgrade"
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                        },
                        "allowUnityIncompatible": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "kind",
                        "version"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "remove"
                        }
                    },
                    "required": [
                        "kind"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "resolve"
                        },
                        "includePrerelease": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "kind"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "reinstall"
                        },
                        "selection": {
                            "$ref": "#/$defs/reinstallSelection"
                        },
                        "sources": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/reinstallSource"
                            },
                            "minItems": 0,
                            "maxItems": 256
                        }
                    },
                    "required": [
                        "kind"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "bulk"
                        },
                        "intents": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/bulkIntent"
                            },
                            "minItems": 1,
                            "maxItems": 256
                        }
                    },
                    "required": [
                        "kind",
                        "intents"
                    ]
                }
            ]
        },
        "planParams": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "project": {
                    "$ref": "#/$defs/project"
                },
                "packageId": {
                    "$ref": "#/$defs/packageId"
                },
                "intent": {
                    "$ref": "#/$defs/intent"
                },
                "source": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/source"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "project",
                "intent"
            ],
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "intent": {
                                "properties": {
                                    "kind": {
                                        "enum": [
                                            "install",
                                            "upgrade",
                                            "downgrade",
                                            "remove"
                                        ]
                                    }
                                }
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "packageId"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "intent": {
                                "properties": {
                                    "kind": {
                                        "enum": [
                                            "resolve",
                                            "bulk"
                                        ]
                                    }
                                }
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "packageId": false,
                            "source": false
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "intent": {
                                "properties": {
                                    "kind": {
                                        "const": "reinstall"
                                    }
                                },
                                "required": [
                                    "selection"
                                ]
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "packageId": false,
                            "source": false
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "intent": {
                                "properties": {
                                    "kind": {
                                        "const": "reinstall"
                                    }
                                },
                                "not": {
                                    "required": [
                                        "selection"
                                    ]
                                }
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "packageId"
                        ]
                    }
                }
            ]
        },
        "planResult": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "plan": {
                    "$ref": "#/$defs/plan"
                },
                "sources": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/planSource"
                    },
                    "maxItems": 4096
                }
            },
            "required": [
                "plan",
                "sources"
            ]
        },
        "versionRange": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
        },
        "reinstallSelection": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "all"
                        }
                    },
                    "required": [
                        "kind"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "packages"
                        },
                        "packageIds": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/packageId"
                            },
                            "minItems": 1,
                            "maxItems": 256
                        }
                    },
                    "required": [
                        "kind",
                        "packageIds"
                    ]
                }
            ]
        },
        "reinstallSource": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "packageId": {
                    "$ref": "#/$defs/packageId"
                },
                "source": {
                    "$ref": "#/$defs/source"
                }
            },
            "required": [
                "packageId",
                "source"
            ]
        },
        "bulkIntent": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "install"
                        },
                        "packageId": {
                            "$ref": "#/$defs/packageId"
                        },
                        "versionRange": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/versionRange"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "source": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/source"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "includePrerelease": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "kind",
                        "packageId"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "upgrade"
                        },
                        "packageId": {
                            "$ref": "#/$defs/packageId"
                        },
                        "versionRange": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/versionRange"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "source": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/source"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "includePrerelease": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "kind",
                        "packageId"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "remove"
                        },
                        "packageId": {
                            "$ref": "#/$defs/packageId"
                        }
                    },
                    "required": [
                        "kind",
                        "packageId"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "reinstall"
                        },
                        "packageId": {
                            "$ref": "#/$defs/packageId"
                        },
                        "source": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/source"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        }
                    },
                    "required": [
                        "kind",
                        "packageId"
                    ]
                }
            ]
        }
    }
}
