{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.cqmhv.com/schema/gui/proposal/m7-settings-appearance-v1.json",
    "title": "ALCOMD M7 appearance settings v1 proposal",
    "description": "Stop A proposal only; not a published RPC or State Schema contract.",
    "$defs": {
        "appearanceMode": {
            "enum": ["system", "light", "dark"]
        },
        "themeSourceColor": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
        },
        "density": {
            "enum": ["comfortable", "compact"]
        },
        "motion": {
            "enum": ["system", "reduced"]
        },
        "locale": {
            "enum": ["system", "de", "en", "fr", "ja", "ko", "zh-Hans", "zh-Hant"]
        },
        "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
        },
        "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[!-~]+$"
        },
        "settings": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "appearanceMode",
                "themeSourceColor",
                "density",
                "motion",
                "locale",
                "revision",
                "updatedAtMs"
            ],
            "properties": {
                "appearanceMode": {"$ref": "#/$defs/appearanceMode"},
                "themeSourceColor": {"$ref": "#/$defs/themeSourceColor"},
                "density": {"$ref": "#/$defs/density"},
                "motion": {"$ref": "#/$defs/motion"},
                "locale": {"$ref": "#/$defs/locale"},
                "revision": {"$ref": "#/$defs/revision"},
                "updatedAtMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                }
            }
        },
        "getRequest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "params"],
            "properties": {
                "method": {"const": "settings.appearance.get"},
                "params": {
                    "type": "object",
                    "additionalProperties": false
                }
            }
        },
        "getResponse": {
            "$ref": "#/$defs/settings"
        },
        "updateRequest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "method",
                "appearanceMode",
                "themeSourceColor",
                "density",
                "motion",
                "locale",
                "expectedRevision",
                "idempotencyKey"
            ],
            "properties": {
                "method": {"const": "settings.appearance.update"},
                "appearanceMode": {"$ref": "#/$defs/appearanceMode"},
                "themeSourceColor": {"$ref": "#/$defs/themeSourceColor"},
                "density": {"$ref": "#/$defs/density"},
                "motion": {"$ref": "#/$defs/motion"},
                "locale": {"$ref": "#/$defs/locale"},
                "expectedRevision": {"$ref": "#/$defs/revision"},
                "idempotencyKey": {"$ref": "#/$defs/idempotencyKey"}
            }
        },
        "updateResponse": {
            "type": "object",
            "additionalProperties": false,
            "required": ["settings", "replayed"],
            "properties": {
                "settings": {"$ref": "#/$defs/settings"},
                "replayed": {"type": "boolean"}
            }
        },
        "localViewState": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema", "drawerCollapsed", "projectView", "lastTabs"],
            "properties": {
                "schema": {"const": 1},
                "drawerCollapsed": {"type": "boolean"},
                "projectView": {"enum": ["list", "grid"]},
                "lastTabs": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["project", "extension"],
                    "properties": {
                        "project": {"enum": ["overview", "packages", "unity", "backups"]},
                        "extension": {"enum": ["overview", "permissions", "ui"]}
                    }
                }
            }
        }
    },
    "oneOf": [
        {"$ref": "#/$defs/settings"},
        {"$ref": "#/$defs/getRequest"},
        {"$ref": "#/$defs/updateRequest"},
        {"$ref": "#/$defs/updateResponse"},
        {"$ref": "#/$defs/localViewState"}
    ],
    "x-alcomd-proposal": {
        "persistence": "state.db Schema v9 singleton row",
        "capability": "settings.appearance.v1",
        "methodPermissions": {
            "settings.appearance.get": ["settings.read"],
            "settings.appearance.update": ["settings.manage"]
        },
        "localStorageKey": "alcomd.gui.view-state.v1",
        "localStorageMaxUtf8Bytes": 4096
    }
}
