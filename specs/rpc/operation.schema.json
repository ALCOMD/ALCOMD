{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.cqmhv.com/schema/rpc/v1/operation.json",
    "title": "ALCOMD RPC v1 Operation",
    "type": "object",
    "additionalProperties": true,
    "required": ["operationId", "kind", "state", "revision", "createdAtMs", "updatedAtMs"],
    "properties": {
        "operationId": {"type": "string", "format": "uuid"},
        "kind": {
            "type": "string",
            "enum": [
                "state.check",
                "packages.apply",
                "templates.import",
                "templates.derive",
                "templates.create-project",
                "backups.create",
                "backups.restore",
                "extensions.install",
                "extensions.uninstall"
            ]
        },
        "state": {
            "type": "string",
            "enum": ["queued", "planning", "waiting_for_input", "running", "cancelling", "succeeded", "failed", "cancelled", "interrupted", "recovering"]
        },
        "revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "createdAtMs": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "updatedAtMs": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "startedAtMs": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "completedAtMs": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "result": {"type": "object"},
        "errorCode": {"type": "string", "minLength": 1, "maxLength": 128},
        "diagnosticId": {"type": "string", "format": "uuid"},
        "progress": {"$ref": "m4-package-transaction.schema.json#/$defs/operationProgress"}
    }
}
