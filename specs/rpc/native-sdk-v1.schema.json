{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.vrclearn.com/schema/rpc/v1/native-sdk-v1.schema.json",
    "title": "ALCOMD native SDK v1 additional wire shapes",
    "$defs": {
        "EmptyParams": {
            "type": "object",
            "additionalProperties": false
        },
        "PackageBulkIntent": {
            "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/bulkIntent"
        },
        "PackageChangeSet": {
            "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/changeSet"
        },
        "PackageMutation": {
            "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/packageMutation"
        },
        "PackagePlan": {
            "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/plan"
        },
        "PackagePlanBulkParams": {
            "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/planBulkParams"
        },
        "PackagePlanDowngradeParams": {
            "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/planDowngradeParams"
        },
        "PackagePlanInstallParams": {
            "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/planInstallParams"
        },
        "ProjectResult": {
            "type": "object",
            "properties": {
                "project": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m3-project-repository.json#/$defs/projectSnapshot"
                }
            },
            "required": [
                "project"
            ]
        },
        "ProjectUnregisterResult": {
            "type": "object",
            "properties": {
                "projectId": {
                    "type": "string"
                },
                "revision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                },
                "unregistered": {
                    "type": "boolean"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "projectId",
                "revision",
                "unregistered",
                "replayed"
            ]
        },
        "ProjectWriteResult": {
            "type": "object",
            "properties": {
                "project": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m3-project-repository.json#/$defs/projectSnapshot"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "project",
                "replayed"
            ]
        },
        "RepositoriesListResult": {
            "type": "object",
            "properties": {
                "orderFingerprint": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m3-project-repository.json#/$defs/repositoryOrderFingerprint"
                },
                "repositories": {
                    "type": "array",
                    "items": {
                        "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m3-project-repository.json#/$defs/repository"
                    }
                },
                "nextCursor": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m3-project-repository.json#/$defs/registryCursor"
                }
            },
            "required": [
                "repositories",
                "orderFingerprint"
            ]
        },
        "RepositoryMoveResult": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "changed": {
                    "type": "boolean"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "changed",
                "replayed"
            ]
        },
        "RepositoryPackagesResult": {
            "type": "object",
            "properties": {
                "packages": {
                    "type": "array",
                    "items": {
                        "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m3-project-repository.json#/$defs/packageVersion"
                    }
                },
                "nextCursor": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m3-project-repository.json#/$defs/packageCursor"
                }
            },
            "required": [
                "packages"
            ]
        },
        "RepositoryResult": {
            "type": "object",
            "properties": {
                "repository": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m3-project-repository.json#/$defs/repository"
                }
            },
            "required": [
                "repository"
            ]
        },
        "RepositoryUnregisterResult": {
            "type": "object",
            "properties": {
                "repositoryId": {
                    "type": "string"
                },
                "revision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                },
                "unregistered": {
                    "type": "boolean"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "repositoryId",
                "revision",
                "unregistered",
                "replayed"
            ]
        },
        "RepositoryWriteResult": {
            "type": "object",
            "properties": {
                "repository": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m3-project-repository.json#/$defs/repository"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "repository",
                "replayed"
            ]
        },
        "SettingsGetResult": {
            "type": "object",
            "additionalProperties": true,
            "required": [
                "configSchema",
                "revision",
                "settings",
                "unityHub",
                "directories"
            ],
            "properties": {
                "configSchema": {
                    "const": 1
                },
                "revision": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m7-official-gui.json#/$defs/revision"
                },
                "settings": {
                    "$ref": "https://alcomd.vrclearn.com/schema/config/settings-v1.json#/$defs/settings"
                },
                "unityHub": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m7-official-gui.json#/$defs/unityHubLocation"
                },
                "directories": {
                    "$ref": "https://alcomd.vrclearn.com/schema/config/settings-v1.json#/$defs/storageDirectories"
                }
            }
        },
        "UnityInstallationRemoveResult": {
            "type": "object",
            "properties": {
                "installationId": {
                    "type": "string"
                },
                "removed": {
                    "type": "boolean"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "installationId",
                "removed",
                "replayed"
            ]
        },
        "UnityInstallationResult": {
            "type": "object",
            "properties": {
                "installation": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m5-unity.json#/$defs/unityInstallation"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "installation",
                "replayed"
            ]
        },
        "UnityLaunchResult": {
            "type": "object",
            "properties": {
                "launch": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m5-unity.json#/$defs/launchRecord"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "launch",
                "replayed"
            ]
        },
        "UserPackageCursor": {
            "type": "object",
            "properties": {
                "updatedAtMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                },
                "userPackageId": {
                    "type": "string"
                }
            },
            "required": [
                "updatedAtMs",
                "userPackageId"
            ]
        },
        "UserPackageRemoveResult": {
            "type": "object",
            "properties": {
                "userPackageId": {
                    "type": "string"
                },
                "revision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                },
                "removed": {
                    "type": "boolean"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "userPackageId",
                "revision",
                "removed",
                "replayed"
            ]
        },
        "UserPackageResult": {
            "type": "object",
            "properties": {
                "userPackage": {
                    "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/userPackageRecord"
                }
            },
            "required": [
                "userPackage"
            ]
        },
        "UserPackageWriteResult": {
            "type": "object",
            "properties": {
                "userPackage": {
                    "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/userPackageRecord"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "userPackage",
                "replayed"
            ]
        },
        "UserPackagesListResult": {
            "type": "object",
            "properties": {
                "userPackages": {
                    "type": "array",
                    "items": {
                        "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/userPackageRecord"
                    }
                },
                "nextCursor": {
                    "$ref": "#/$defs/UserPackageCursor"
                }
            },
            "required": [
                "userPackages"
            ]
        },
        "RepositoryInspectResult": {
            "type": "object",
            "properties": {
                "repository": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m3-project-repository.json#/$defs/repository"
                },
                "previewId": {
                    "type": "string",
                    "format": "uuid"
                }
            },
            "required": [
                "repository"
            ]
        }
    }
}
