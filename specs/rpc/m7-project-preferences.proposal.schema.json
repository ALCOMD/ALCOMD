{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.vrclearn.com/schema/proposals/m7-project-preferences.json",
    "title": "ALCOMD registered project favorite",
    "$comment": "Project launch configuration and Unity installation matching are defined in m7-unity-project-version.proposal.schema.json.",
    "x-alcomd-publication": "implemented-active-contract-evidence",
    "x-alcomd-active-rpc-modified": true,
    "x-alcomd-state-schema": 1,
    "$defs": {
        "uuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
        },
        "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[!-~]+$"
        },
        "projectSetFavoriteParams": {
            "type": "object",
            "additionalProperties": false,
            "required": ["projectId", "favorite", "expectedRevision", "idempotencyKey"],
            "properties": {
                "projectId": {"$ref": "#/$defs/uuid"},
                "favorite": {"type": "boolean"},
                "expectedRevision": {"$ref": "#/$defs/revision"},
                "idempotencyKey": {"$ref": "#/$defs/idempotencyKey"}
            }
        },
        "registeredProjectFavoriteExtension": {
            "type": "object",
            "additionalProperties": true,
            "required": ["projectId", "revision", "favorite"],
            "properties": {
                "projectId": {"$ref": "#/$defs/uuid"},
                "revision": {"$ref": "#/$defs/revision"},
                "favorite": {"type": "boolean"}
            },
            "description": "favorite is emitted for registered Project snapshots and omitted from anonymous inspect snapshots."
        },
        "projectSetFavoriteResult": {
            "type": "object",
            "additionalProperties": true,
            "required": ["project", "replayed"],
            "properties": {
                "project": {"$ref": "#/$defs/registeredProjectFavoriteExtension"},
                "replayed": {"type": "boolean"}
            },
            "description": "Reuses the active ProjectWriteResult response shape."
        }
    },
    "type": "object",
    "additionalProperties": false,
    "required": ["contractVersion", "methods", "permissions", "capabilities"],
    "properties": {
        "contractVersion": {"const": 1},
        "methods": {"const": ["projects.setFavorite"]},
        "permissions": {"const": {"projects.setFavorite": ["projects.manage"]}},
        "capabilities": {"const": {"projects.setFavorite": "projects.registry.v1"}},
        "stableErrors": {
            "const": {
                "projects.setFavorite": [
                    "project_not_registered",
                    "revision_conflict",
                    "idempotency_conflict",
                    "permission_denied",
                    "internal_error"
                ]
            }
        }
    }
}
