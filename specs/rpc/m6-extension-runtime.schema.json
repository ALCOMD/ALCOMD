{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.vrclearn.com/schema/rpc/v1/m6-extension-runtime.json",
    "title": "ALCOMD RPC v1 M6 Extension Runtime contract",
    "x-alcomd-publication": "active-production-contract",
    "x-alcomd-method-permissions": {
        "extensions.list": ["extensions.read"],
        "extensions.get": ["extensions.read"],
        "extensions.permissions.list": ["extensions.read"],
        "extensions.planInstall": ["extensions.manage"],
        "extensions.inspectSource": ["extensions.manage"],
        "extensions.planInstallFromSource": ["extensions.manage"],
        "extensions.applyInstall": ["extensions.manage"],
        "extensions.enable": ["extensions.manage"],
        "extensions.disable": ["extensions.manage"],
        "extensions.planUninstall": ["extensions.manage"],
        "extensions.applyUninstall": ["extensions.manage"],
        "extensions.setGrant": ["extensions.permissions.manage"],
        "extensions.revokeGrant": ["extensions.permissions.manage"]
    },
    "x-alcomd-method-results": {
        "extensions.list": "#/$defs/listResult",
        "extensions.get": "#/$defs/extensionResult",
        "extensions.permissions.list": "#/$defs/permissionsListResult",
        "extensions.planInstall": "#/$defs/planResult",
        "extensions.inspectSource": "#/$defs/sourcePreview",
        "extensions.planInstallFromSource": "#/$defs/planResult",
        "extensions.applyInstall": "#/$defs/operationResult",
        "extensions.enable": "#/$defs/extensionResult",
        "extensions.disable": "#/$defs/extensionResult",
        "extensions.planUninstall": "#/$defs/planResult",
        "extensions.applyUninstall": "#/$defs/operationResult",
        "extensions.setGrant": "#/$defs/grantResult",
        "extensions.revokeGrant": "#/$defs/grantResult"
    },
    "x-alcomd-grant-scopes": {
        "background.run": "Extension/<ExtensionId>",
        "projects.read": "Global/*; all current and future registered projects, safe summaries only",
        "mcp.clients.read": "Global/*",
        "mcp.clients.manage": "Global/*"
    },
    "x-alcomd-list-pagination": {
        "kind": "deterministic-keyset",
        "order": "extensionId ascending",
        "cursor": "versioned opaque encoding of format version and last ExtensionId",
        "invalidCursorError": "invalid_request"
    },
    "x-alcomd-permissions-pagination": {
        "kind": "deterministic-keyset",
        "order": ["permission", "resourceKind", "resourceId"],
        "defaultLimit": 100,
        "maximumLimit": 1000,
        "cursor": "versioned opaque encoding bound to ExtensionId, grantRevision and the installed package/record snapshot",
        "snapshot": "one read transaction; declarations come from the corresponding applied immutable install Plan",
        "changedSnapshotError": "revision_conflict",
        "invalidCursorError": "invalid_request",
        "scope": "current extension owner; active grants only; no implicit authorization or persistent query session"
    },
    "x-alcomd-method-params": {
        "extensions.inspectSource": "#/$defs/inspectSourceParams",
        "extensions.planInstallFromSource": "#/$defs/planInstallFromSourceParams",
        "extensions.applyInstall": "#/$defs/installApplyParams",
        "extensions.applyUninstall": "#/$defs/applyPlanParams"
    },
    "x-alcomd-install-consent": {
        "binding": "same frozen Plan fingerprint and signed installation terms/required permissions",
        "permissions": "extensions.manage plus extensions.permissions.manage if requiredPermissions is non-empty",
        "refusal": "no Apply request and no grant or install",
        "initialGrants": "required permissions only, in state commit transaction; recovery does not restore revoked grants"
    },
    "$defs": {
        "installationTerms": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "title",
                "text"
            ],
            "properties": {
                "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384
                }
            }
        },
        "installConsent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "planFingerprint",
                "installationTermsAccepted",
                "requiredPermissionsAccepted"
            ],
            "properties": {
                "planFingerprint": {
                    "$ref": "#/$defs/sha256"
                },
                "installationTermsAccepted": {
                    "type": "boolean"
                },
                "requiredPermissionsAccepted": {
                    "type": "boolean"
                }
            }
        },
        "installApplyParams": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "planId",
                "idempotencyKey",
                "consent"
            ],
            "properties": {
                "planId": {
                    "$ref": "#/$defs/uuid"
                },
                "idempotencyKey": {
                    "$ref": "#/$defs/idempotencyKey"
                },
                "consent": {
                    "$ref": "#/$defs/installConsent"
                }
            }
        },
        "toolPreview": {"type": "object", "additionalProperties": false, "required": ["name", "title", "description", "requiredPermissions", "effect"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 64}, "title": {"type": "string", "minLength": 1, "maxLength": 256}, "description": {"type": "string", "maxLength": 2048}, "requiredPermissions": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}, "effect": {"enum": ["pure", "read", "plan", "apply", "cancel"]}}},
        "methodName": {
            "enum": [
                "extensions.list", "extensions.get", "extensions.permissions.list", "extensions.planInstall",
                "extensions.inspectSource", "extensions.planInstallFromSource",
                "extensions.applyInstall", "extensions.enable", "extensions.disable",
                "extensions.planUninstall", "extensions.applyUninstall",
                "extensions.setGrant", "extensions.revokeGrant"
            ]
        },
        "capability": {"enum": ["extensions.lifecycle.v1", "extensions.remote-install.v1", "extensions.permissions.v1", "extensions.permissions.read.v1"]},
        "extensionId": {
            "type": "string", "minLength": 3, "maxLength": 255,
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
        },
        "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "expectedOptionalRevision": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[!-~]+$"},
        "absolutePath": {"type": "string", "minLength": 1, "maxLength": 32768},
        "desiredState": {"enum": ["installed_disabled", "enabled", "uninstalling"]},
        "quarantineState": {"enum": ["clear", "quarantined"]},
        "runtimeState": {"enum": ["stopped", "starting", "running", "stopping", "crashed"]},
        "uiDeclaration": {
            "type": "object", "additionalProperties": false, "required": ["protocol"],
            "properties": {"protocol": {"const": "portable-v1"}}
        },
        "extensionRecord": {
            "type": "object", "additionalProperties": true,
            "required": [
                "extensionId", "version", "apiMajor", "packageDigest", "publisherFingerprint",
                "desiredState", "quarantineState", "runtimeState", "grantRevision",
                "lifecycleGeneration", "revision"
            ],
            "properties": {
                "extensionId": {"$ref": "#/$defs/extensionId"},
                "version": {"type": "string", "minLength": 5, "maxLength": 128},
                "apiMajor": {"const": 1},
                "packageDigest": {"$ref": "#/$defs/sha256"},
                "publisherFingerprint": {"type": "string", "pattern": "^ed25519-sha256:[0-9a-f]{64}$"},
                "desiredState": {"$ref": "#/$defs/desiredState"},
                "quarantineState": {"$ref": "#/$defs/quarantineState"},
                "runtimeState": {"$ref": "#/$defs/runtimeState"},
                "grantRevision": {"$ref": "#/$defs/revision"},
                "lifecycleGeneration": {"$ref": "#/$defs/revision"},
                "revision": {"$ref": "#/$defs/revision"},
                "ui": {"$ref": "#/$defs/uiDeclaration"}
            }
        },
        "listParams": {
            "type": "object", "additionalProperties": false,
            "properties": {
                "cursor": {"type": "string", "minLength": 1, "maxLength": 1024},
                "limit": {"type": "integer", "minimum": 1, "maximum": 1000}
            }
        },
        "getParams": {
            "type": "object", "additionalProperties": false, "required": ["extensionId"],
            "properties": {"extensionId": {"$ref": "#/$defs/extensionId"}}
        },
        "permissionsListParams": {
            "type": "object", "additionalProperties": false, "required": ["extensionId"],
            "properties": {
                "extensionId": {"$ref": "#/$defs/extensionId"},
                "cursor": {"type": "string", "minLength": 1, "maxLength": 4096},
                "limit": {"type": "integer", "minimum": 1, "maximum": 1000}
            }
        },
        "permissionDeclarations": {
            "type": "array", "maxItems": 64,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "sourceUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "^https://",
            "description": "Anonymous HTTPS; no userinfo or fragment; legal query preserved."
        },
        "inspectSourceParams": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "url"
            ],
            "properties": {
                "url": {
                    "$ref": "#/$defs/sourceUrl"
                }
            }
        },
        "planInstallFromSourceParams": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "url",
                "version",
                "expectedSourceFingerprint"
            ],
            "properties": {
                "url": {
                    "$ref": "#/$defs/sourceUrl"
                },
                "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "expectedSourceFingerprint": {
                    "$ref": "#/$defs/sha256"
                }
            }
        },
        "installationSource": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "url",
                "version"
            ],
            "properties": {
                "url": {
                    "$ref": "#/$defs/sourceUrl"
                },
                "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                }
            }
        },
        "sourcePreview": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "url",
                "extensionId",
                "displayName",
                "publisherFingerprint",
                "versions",
                "sourceFingerprint"
            ],
            "properties": {
                "url": {
                    "$ref": "#/$defs/sourceUrl"
                },
                "extensionId": {
                    "$ref": "#/$defs/extensionId"
                },
                "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                },
                "publisherFingerprint": {
                    "type": "string",
                    "pattern": "^ed25519-sha256:[0-9a-f]{64}$"
                },
                "description": {
                    "type": "string",
                    "maxLength": 2048
                },
                "versions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 256,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "version",
                            "apiMajor"
                        ],
                        "properties": {
                            "version": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                            },
                            "apiMajor": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 4294967295
                            }
                        }
                    }
                },
                "sourceFingerprint": {
                    "$ref": "#/$defs/sha256"
                }
            }
        },
        "planInstallParams": {
            "type": "object", "additionalProperties": false,
            "required": ["sourceKind", "packagePath", "expectedRevision"],
            "properties": {
                "sourceKind": {"enum": ["local_owner_selected", "first_party_packaged"]},
                "packagePath": {"$ref": "#/$defs/absolutePath"},
                "expectedRevision": {"$ref": "#/$defs/expectedOptionalRevision"}
            }
        },
        "planUninstallParams": {
            "type": "object", "additionalProperties": false,
            "required": ["extensionId", "expectedRevision", "dataDisposition"],
            "properties": {
                "extensionId": {"$ref": "#/$defs/extensionId"},
                "expectedRevision": {"$ref": "#/$defs/revision"},
                "dataDisposition": {"enum": ["retain_data", "delete_data"]}
            }
        },
        "planRecord": {
            "type": "object", "additionalProperties": true,
            "required": [
                "planId", "action", "state", "sourceKind", "extensionId", "packageDigest",
                "version", "apiMajor", "profileVersion", "publisherFingerprint",
                "dataDisposition", "planFingerprint", "requiredPermissions", "optionalPermissions", "mcpTools"
            ],
            "properties": {
                "installationTerms": {"$ref": "#/$defs/installationTerms"},
                "installationSource": {"$ref": "#/$defs/installationSource"},
                "mcpTools": {"type":"array","maxItems":32,"items":{"$ref":"#/$defs/toolPreview"}},
                "planId": {"$ref": "#/$defs/uuid"},
                "action": {"enum": ["install", "uninstall"]},
                "state": {"enum": ["unapplied", "applied"]},
                "sourceKind": {"enum": ["not_applicable", "local_owner_selected", "first_party_packaged", "remote_extension_source"]},
                "extensionId": {"$ref": "#/$defs/extensionId"},
                "version": {"type": "string", "minLength": 1, "maxLength": 128},
                "apiMajor": {"const": 1},
                "profileVersion": {"const": 1},
                "packageDigest": {"$ref": "#/$defs/sha256"},
                "publisherFingerprint": {"type": "string", "pattern": "^ed25519-sha256:[0-9a-f]{64}$"},
                "dataDisposition": {"enum": ["not_applicable", "retain_data", "delete_data"]},
                "planFingerprint": {"$ref": "#/$defs/sha256"},
                "requiredPermissions": {"$ref": "#/$defs/permissionDeclarations"},
                "optionalPermissions": {"$ref": "#/$defs/permissionDeclarations"},
                "uiProtocol": {"enum": ["portable-v1"]}
            }
        },
        "applyPlanParams": {
            "type": "object", "additionalProperties": false, "required": ["planId", "idempotencyKey"],
            "properties": {
                "planId": {"$ref": "#/$defs/uuid"},
                "idempotencyKey": {"$ref": "#/$defs/idempotencyKey"}
            }
        },
        "lifecycleParams": {
            "type": "object", "additionalProperties": false,
            "required": ["extensionId", "expectedRevision", "idempotencyKey"],
            "properties": {
                "extensionId": {"$ref": "#/$defs/extensionId"},
                "expectedRevision": {"$ref": "#/$defs/revision"},
                "idempotencyKey": {"$ref": "#/$defs/idempotencyKey"}
            }
        },
        "enableParams": {
            "type": "object", "additionalProperties": false,
            "required": ["extensionId", "expectedRevision", "idempotencyKey"],
            "properties": {
                "extensionId": {"$ref": "#/$defs/extensionId"},
                "expectedRevision": {"$ref": "#/$defs/revision"},
                "idempotencyKey": {"$ref": "#/$defs/idempotencyKey"},
                "activationPackageDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
        },
        "operationResult": {
            "type": "object", "additionalProperties": true,
            "required": ["operationId", "replayed"],
            "properties": {
                "operationId": {"$ref": "#/$defs/uuid"},
                "replayed": {"type": "boolean"}
            }
        },
        "listResult": {
            "type": "object", "additionalProperties": true,
            "required": ["extensions"],
            "properties": {
                "extensions": {
                    "type": "array", "maxItems": 1000,
                    "items": {"$ref": "#/$defs/extensionRecord"}
                },
                "nextCursor": {"type": "string", "minLength": 1, "maxLength": 1024}
            }
        },
        "extensionResult": {
            "type": "object", "additionalProperties": true,
            "required": ["extension"],
            "properties": {
                "extension": {"$ref": "#/$defs/extensionRecord"},
                "installationSource": {"$ref": "#/$defs/installationSource"},
                "mcpTools": {"type":"array","maxItems":32,"items":{"$ref":"#/$defs/toolPreview"}},
                "activationConsent": {
                    "type": "object", "additionalProperties": false, "required": ["packageDigest", "targets"],
                    "properties": {
                        "packageDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                        "targets": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 700}}
                    }
                }
            }
        },
        "planResult": {
            "type": "object", "additionalProperties": true,
            "required": ["plan"],
            "properties": {"plan": {"$ref": "#/$defs/planRecord"}}
        },
        "permissionScope": {
            "oneOf": [
                {"properties": {"permission": {"const": "background.run"}, "resourceKind": {"const": "Extension"}, "resourceId": {"$ref": "#/$defs/extensionId"}}},
                {"properties": {"permission": {"enum": ["projects.read", "mcp.clients.read", "mcp.clients.manage", "mcp.connections.read", "mcp.requests.read", "mcp.subscription-streams.read", "mcp.tools.provide", "repositories.read", "packages.read", "packages.manage", "operations.read", "operations.cancel", "unity.sessions.read"]}, "resourceKind": {"const": "Global"}, "resourceId": {"const": "*"}}},
                {"properties": {"permission": {"const": "local-ipc.connect"}, "resourceKind": {"const": "LocalIpcTarget"}, "resourceId": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]+$"}}}
            ]
        },
        "grantParams": {
            "type": "object", "additionalProperties": false,
            "allOf": [{"$ref": "#/$defs/permissionScope"}],
            "required": [
                "extensionId", "permission", "resourceKind", "resourceId",
                "expectedGrantRevision", "idempotencyKey"
            ],
            "properties": {
                "extensionId": {"$ref": "#/$defs/extensionId"},
                "permission": {"enum": ["background.run", "projects.read", "mcp.clients.read", "mcp.clients.manage", "mcp.connections.read", "mcp.requests.read", "mcp.subscription-streams.read", "mcp.tools.provide", "repositories.read", "packages.read", "packages.manage", "operations.read", "operations.cancel", "unity.sessions.read", "local-ipc.connect"]},
                "resourceKind": {"enum": ["Extension", "Global", "LocalIpcTarget"]},
                "resourceId": {"type": "string", "minLength": 1, "maxLength": 255},
                "expectedGrantRevision": {"$ref": "#/$defs/revision"},
                "idempotencyKey": {"$ref": "#/$defs/idempotencyKey"}
            }
        },
        "grantResult": {
            "type": "object", "additionalProperties": true,
            "required": ["extensionId", "grantRevision", "state", "replayed"],
            "properties": {
                "extensionId": {"$ref": "#/$defs/extensionId"},
                "grantRevision": {"$ref": "#/$defs/revision"},
                "state": {"enum": ["granted", "revoked"]},
                "replayed": {"type": "boolean"}
            }
        },
        "permissionGrant": {
            "type": "object", "additionalProperties": false,
            "allOf": [{"$ref": "#/$defs/permissionScope"}],
            "required": ["permission", "resourceKind", "resourceId"],
            "properties": {
                "permission": {"enum": ["background.run", "projects.read", "mcp.clients.read", "mcp.clients.manage", "mcp.connections.read", "mcp.requests.read", "mcp.subscription-streams.read", "mcp.tools.provide", "repositories.read", "packages.read", "packages.manage", "operations.read", "operations.cancel", "unity.sessions.read", "local-ipc.connect"]},
                "resourceKind": {"enum": ["Extension", "Global", "LocalIpcTarget"]},
                "resourceId": {"type": "string", "minLength": 1, "maxLength": 255}
            }
        },
        "permissionsListResult": {
            "type": "object", "additionalProperties": true,
            "required": ["extensionId", "grantRevision", "requiredPermissions", "optionalPermissions", "grants", "availablePermissions"],
            "properties": {
                "availablePermissions": {"$ref": "#/$defs/permissionDeclarations"},
                "extensionId": {"$ref": "#/$defs/extensionId"},
                "grantRevision": {"$ref": "#/$defs/revision"},
                "requiredPermissions": {"$ref": "#/$defs/permissionDeclarations"},
                "optionalPermissions": {"$ref": "#/$defs/permissionDeclarations"},
                "grants": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/permissionGrant"}},
                "nextCursor": {"type": "string", "minLength": 1, "maxLength": 4096}
            }
        }
    }
}
