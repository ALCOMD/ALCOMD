{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "MCP project and backup workflows",
    "x-capability": "mcp.project-workflows.v1",
    "$id": "https://alcomd.vrclearn.com/schema/mcp/project-workflows-v1.json",
    "x-alcomd-tools": [
        {
            "name": "alcomd_register_project",
            "title": "Register an existing project",
            "description": "Register a project under the default project directory or by its absolute path on the Core machine.",
            "inputSchema": {
                "type": "object",
                "$ref": "#/$defs/register"
            },
            "outputSchema": {
                "oneOf": [
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "data": {
                                "$ref": "#/$defs/registration"
                            }
                        },
                        "required": [
                            "data"
                        ]
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "error": {
                                "$ref": "#/$defs/toolError"
                            }
                        },
                        "required": [
                            "error"
                        ]
                    }
                ]
            },
            "effect": "apply",
            "requiredPermissions": [
                "projects.manage"
            ]
        },
        {
            "name": "alcomd_list_project_templates",
            "title": "List project templates",
            "description": "Read templates available for project creation.",
            "inputSchema": {
                "type": "object",
                "$ref": "#/$defs/listTemplates"
            },
            "outputSchema": {
                "oneOf": [
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "data": {
                                "$ref": "#/$defs/templates"
                            }
                        },
                        "required": [
                            "data"
                        ]
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "error": {
                                "$ref": "#/$defs/toolError"
                            }
                        },
                        "required": [
                            "error"
                        ]
                    }
                ]
            },
            "effect": "read",
            "requiredPermissions": [
                "projects.create"
            ]
        },
        {
            "name": "alcomd_create_project",
            "title": "Create a project",
            "description": "Create a project under the default project directory or at an absolute destination on the Core machine. A template with packages requires the existing package and repository permissions.",
            "inputSchema": {
                "type": "object",
                "$ref": "#/$defs/create"
            },
            "outputSchema": {
                "oneOf": [
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "data": {
                                "$ref": "#/$defs/projectAccepted"
                            }
                        },
                        "required": [
                            "data"
                        ]
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "error": {
                                "$ref": "#/$defs/toolError"
                            }
                        },
                        "required": [
                            "error"
                        ]
                    }
                ]
            },
            "effect": "apply",
            "requiredPermissions": [
                "projects.create"
            ]
        },
        {
            "name": "alcomd_plan_project_copy",
            "title": "Review a project copy",
            "description": "Freeze the source revision and selected destination for review. Choose a name under the default project directory or supply an absolute destination on the Core machine.",
            "inputSchema": {
                "type": "object",
                "$ref": "#/$defs/planCopy"
            },
            "outputSchema": {
                "oneOf": [
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "data": {
                                "$ref": "#/$defs/copyPlan"
                            }
                        },
                        "required": [
                            "data"
                        ]
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "error": {
                                "$ref": "#/$defs/toolError"
                            }
                        },
                        "required": [
                            "error"
                        ]
                    }
                ]
            },
            "effect": "plan",
            "requiredPermissions": [
                "projects.read",
                "projects.create"
            ]
        },
        {
            "name": "alcomd_apply_project_copy",
            "title": "Apply a reviewed project copy",
            "description": "Use the original copy plan after the operator confirms it.",
            "inputSchema": {
                "type": "object",
                "$ref": "#/$defs/applyCopy"
            },
            "outputSchema": {
                "oneOf": [
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "data": {
                                "$ref": "#/$defs/copyAccepted"
                            }
                        },
                        "required": [
                            "data"
                        ]
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "error": {
                                "$ref": "#/$defs/toolError"
                            }
                        },
                        "required": [
                            "error"
                        ]
                    }
                ]
            },
            "effect": "apply",
            "requiredPermissions": [
                "projects.read",
                "projects.create"
            ]
        },
        {
            "name": "alcomd_create_backup",
            "title": "Create a project backup",
            "description": "Write a ZIP to a new absolute file path on the Core host, or use the configured backup directory.",
            "inputSchema": {
                "type": "object",
                "$ref": "#/$defs/createBackup"
            },
            "outputSchema": {
                "oneOf": [
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "data": {
                                "$ref": "#/$defs/backupAccepted"
                            }
                        },
                        "required": [
                            "data"
                        ]
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "error": {
                                "$ref": "#/$defs/toolError"
                            }
                        },
                        "required": [
                            "error"
                        ]
                    }
                ]
            },
            "effect": "apply",
            "requiredPermissions": [
                "projects.read",
                "backups.manage"
            ]
        },
        {
            "name": "alcomd_restore_backup",
            "title": "Restore a Unity project from ZIP",
            "description": "Restore a ZIP whose root is a Unity project. Supply an absolute archive path on the Core host and confirm the restore. An optional destination is a new absolute project directory.",
            "inputSchema": {
                "type": "object",
                "$ref": "#/$defs/restoreBackup"
            },
            "outputSchema": {
                "oneOf": [
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "data": {
                                "$ref": "#/$defs/backupAccepted"
                            }
                        },
                        "required": [
                            "data"
                        ]
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "error": {
                                "$ref": "#/$defs/toolError"
                            }
                        },
                        "required": [
                            "error"
                        ]
                    }
                ]
            },
            "effect": "apply",
            "requiredPermissions": [
                "backups.read",
                "backups.manage",
                "projects.create"
            ]
        },
        {
            "name": "alcomd_plan_unity_migration",
            "title": "Plan a Unity migration",
            "description": "Preflight the source before copying. By default complete a project copy and use its new project ID to plan the migration.",
            "inputSchema": {
                "type": "object",
                "$ref": "#/$defs/planUnityMigrationParams"
            },
            "outputSchema": {
                "oneOf": [
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "data": {
                                "$ref": "#/$defs/planUnityMigrationResult"
                            }
                        },
                        "required": [
                            "data"
                        ]
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "error": {
                                "$ref": "#/$defs/toolError"
                            }
                        },
                        "required": [
                            "error"
                        ]
                    }
                ]
            },
            "effect": "plan",
            "requiredPermissions": [
                "projects.read",
                "unity.read",
                "projects.unity-migrate"
            ]
        },
        {
            "name": "alcomd_apply_unity_migration",
            "title": "Apply a Unity migration",
            "description": "Confirm migration of exactly the reviewed project. Use a copy plan by default. For an original, explicitly confirm in-place upgrade after backup. A Unity 6 upload prevents later updates of that content from Unity 2022.",
            "inputSchema": {
                "type": "object",
                "$ref": "#/$defs/applyUnityMigrationParams"
            },
            "outputSchema": {
                "oneOf": [
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "data": {
                                "$ref": "#/$defs/applyUnityMigrationResult"
                            }
                        },
                        "required": [
                            "data"
                        ]
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "error": {
                                "$ref": "#/$defs/toolError"
                            }
                        },
                        "required": [
                            "error"
                        ]
                    }
                ]
            },
            "effect": "apply",
            "requiredPermissions": [
                "projects.read",
                "unity.read",
                "projects.unity-migrate"
            ]
        }
    ],
    "$defs": {
        "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
        },
        "integer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
        },
        "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "default"
                        },
                        "relative_path": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                        }
                    },
                    "required": [
                        "kind",
                        "relative_path"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "absolute"
                        },
                        "path": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096,
                            "description": "Absolute project directory path on the Core machine."
                        }
                    },
                    "required": [
                        "kind",
                        "path"
                    ]
                }
            ]
        },
        "target": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "default"
                        },
                        "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 255
                        }
                    },
                    "required": [
                        "kind",
                        "name"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "absolute"
                        },
                        "path": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096,
                            "description": "Absolute path to the new project directory on the Core machine."
                        }
                    },
                    "required": [
                        "kind",
                        "path"
                    ]
                }
            ]
        },
        "templateReference": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "revision": {
                    "$ref": "#/$defs/revision"
                }
            },
            "required": [
                "id",
                "revision"
            ]
        },
        "register": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "source": {
                    "$ref": "#/$defs/source"
                },
                "idempotency_key": {
                    "$ref": "#/$defs/key"
                }
            },
            "required": [
                "source",
                "idempotency_key"
            ]
        },
        "registration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "project": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "project_id": {
                            "$ref": "#/$defs/id"
                        },
                        "revision": {
                            "$ref": "#/$defs/revision"
                        },
                        "display_name": {
                            "anyOf": [
                                {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 255
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "project_type": {
                            "enum": [
                                "avatars",
                                "worlds",
                                "legacy-avatars",
                                "legacy-worlds",
                                "unknown",
                                "vpm-starter",
                                "upm-avatars",
                                "upm-worlds",
                                "upm-starter",
                                "legacy-sdk2"
                            ]
                        },
                        "unity_version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                        }
                    },
                    "required": [
                        "project_id",
                        "revision",
                        "display_name",
                        "project_type",
                        "unity_version"
                    ]
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "project",
                "replayed"
            ]
        },
        "listTemplates": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "cursor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                }
            }
        },
        "templates": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "templates": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "id": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                            },
                            "name": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                            },
                            "editor_version": {
                                "anyOf": [
                                    {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 128
                                    },
                                    {
                                        "type": "null"
                                    }
                                ]
                            },
                            "revision": {
                                "$ref": "#/$defs/revision"
                            },
                            "locked": {
                                "type": "boolean"
                            }
                        },
                        "required": [
                            "id",
                            "name",
                            "revision",
                            "locked"
                        ]
                    },
                    "maxItems": 100
                },
                "next_cursor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                }
            },
            "required": [
                "templates"
            ]
        },
        "create": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "target": {
                    "$ref": "#/$defs/target"
                },
                "unity_version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "template": {
                    "$ref": "#/$defs/templateReference"
                },
                "idempotency_key": {
                    "$ref": "#/$defs/key"
                }
            },
            "required": [
                "target",
                "unity_version",
                "idempotency_key"
            ]
        },
        "projectAccepted": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "operation_id": {
                    "$ref": "#/$defs/id"
                },
                "project_id": {
                    "$ref": "#/$defs/id"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "operation_id",
                "project_id",
                "replayed"
            ]
        },
        "planCopy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "source_project_id": {
                    "$ref": "#/$defs/id"
                },
                "expected_revision": {
                    "$ref": "#/$defs/revision"
                },
                "target": {
                    "$ref": "#/$defs/target"
                },
                "idempotency_key": {
                    "$ref": "#/$defs/key"
                }
            },
            "required": [
                "source_project_id",
                "expected_revision",
                "target",
                "idempotency_key"
            ]
        },
        "applyCopy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "plan_id": {
                    "$ref": "#/$defs/id"
                },
                "expected_revision": {
                    "$ref": "#/$defs/revision"
                },
                "confirm": {
                    "const": true
                },
                "idempotency_key": {
                    "$ref": "#/$defs/key"
                }
            },
            "required": [
                "plan_id",
                "expected_revision",
                "confirm",
                "idempotency_key"
            ]
        },
        "copyAccepted": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "operation_id": {
                    "$ref": "#/$defs/id"
                },
                "target_project_id": {
                    "$ref": "#/$defs/id"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "operation_id",
                "target_project_id",
                "replayed"
            ]
        },
        "copyPlan": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "plan_id": {
                    "$ref": "#/$defs/id"
                },
                "source_project_id": {
                    "$ref": "#/$defs/id"
                },
                "expected_revision": {
                    "$ref": "#/$defs/revision"
                },
                "target_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                },
                "target_project_id": {
                    "$ref": "#/$defs/id"
                },
                "writer_evidence": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "state": {
                            "enum": [
                                "running_confirmed",
                                "running_suspected",
                                "not_observed",
                                "unknown"
                            ]
                        },
                        "observed_at_ms": {
                            "$ref": "#/$defs/integer"
                        }
                    },
                    "required": [
                        "state",
                        "observed_at_ms"
                    ]
                },
                "profile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                        },
                        "version": {
                            "$ref": "#/$defs/revision"
                        },
                        "includes": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                            },
                            "maxItems": 32
                        },
                        "excludes": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                            },
                            "maxItems": 32
                        },
                        "rejects": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                            },
                            "maxItems": 32
                        },
                        "quota": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "max_entries": {
                                    "$ref": "#/$defs/integer"
                                },
                                "max_single_file_bytes": {
                                    "$ref": "#/$defs/integer"
                                },
                                "max_total_regular_file_bytes": {
                                    "$ref": "#/$defs/integer"
                                },
                                "max_depth": {
                                    "$ref": "#/$defs/integer"
                                },
                                "max_normalized_path_utf8_bytes": {
                                    "$ref": "#/$defs/integer"
                                }
                            },
                            "required": [
                                "max_entries",
                                "max_single_file_bytes",
                                "max_total_regular_file_bytes",
                                "max_depth",
                                "max_normalized_path_utf8_bytes"
                            ]
                        }
                    },
                    "required": [
                        "id",
                        "version",
                        "includes",
                        "excludes",
                        "rejects",
                        "quota"
                    ]
                },
                "expires_at_ms": {
                    "$ref": "#/$defs/integer"
                },
                "plan_fingerprint": {
                    "$ref": "#/$defs/fingerprint"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "plan_id",
                "source_project_id",
                "expected_revision",
                "target_name",
                "target_project_id",
                "writer_evidence",
                "profile",
                "expires_at_ms",
                "plan_fingerprint",
                "replayed"
            ]
        },
        "compression": {
            "enum": [
                "store",
                "fast",
                "level3",
                "level5",
                "level7",
                "maximum"
            ]
        },
        "createBackup": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "project_id": {
                    "$ref": "#/$defs/id"
                },
                "expected_revision": {
                    "$ref": "#/$defs/revision"
                },
                "compression_mode": {
                    "$ref": "#/$defs/compression"
                },
                "exclude_vpm_packages": {
                    "type": "boolean"
                },
                "include_library": {
                    "type": "boolean"
                },
                "idempotency_key": {
                    "$ref": "#/$defs/key"
                },
                "destination_path": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "required": [
                "project_id",
                "expected_revision",
                "idempotency_key"
            ]
        },
        "backupAccepted": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "operation_id": {
                    "$ref": "#/$defs/id"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "operation_id",
                "replayed"
            ]
        },
        "toolError": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                },
                "retryable": {
                    "type": "boolean"
                },
                "diagnostic_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "outcome": {
                    "const": "unknown"
                },
                "details": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "subreason": {
                            "type": "string",
                            "maxLength": 128,
                            "pattern": "^[a-zA-Z0-9_]*$"
                        }
                    },
                    "required": [
                        "subreason"
                    ]
                }
            },
            "required": [
                "code",
                "message",
                "retryable"
            ]
        },
        "restoreBackup": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "archive_path",
                "idempotency_key",
                "confirm"
            ],
            "properties": {
                "archive_path": {
                    "type": "string",
                    "minLength": 1
                },
                "project_name": {
                    "type": "string",
                    "minLength": 1
                },
                "destination_path": {
                    "type": "string",
                    "minLength": 1
                },
                "idempotency_key": {
                    "$ref": "#/$defs/key"
                },
                "confirm": {
                    "const": true
                }
            },
            "not": {
                "required": [
                    "project_name",
                    "destination_path"
                ]
            }
        },
        "classification": {
            "enum": [
                "patch_or_minor_upgrade",
                "major_upgrade",
                "patch_or_minor_downgrade",
                "major_downgrade",
                "china_variant_change"
            ]
        },
        "projectUnityMigrationClassification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "kind",
                "supported_for_apply"
            ],
            "properties": {
                "kind": {
                    "$ref": "#/$defs/classification"
                },
                "supported_for_apply": {
                    "type": "boolean"
                }
            }
        },
        "canonicalUnityVersion": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)[abfpx][1-9][0-9]*(c[1-9][0-9]*)?$"
        },
        "planUnityMigrationParams": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "project_id",
                "target_installation_id",
                "expected_project_revision",
                "idempotency_key"
            ],
            "properties": {
                "project_id": {
                    "$ref": "#/$defs/id"
                },
                "target_installation_id": {
                    "$ref": "#/$defs/id"
                },
                "expected_project_revision": {
                    "$ref": "#/$defs/revision"
                },
                "idempotency_key": {
                    "$ref": "#/$defs/key"
                },
                "in_place": {
                    "type": "boolean",
                    "default": false
                },
                "copy_operation_id": {
                    "$ref": "#/$defs/id"
                }
            },
            "not": {
                "properties": {
                    "in_place": {
                        "const": true
                    }
                },
                "required": [
                    "in_place",
                    "copy_operation_id"
                ]
            }
        },
        "applyUnityMigrationParams": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "plan_id",
                "idempotency_key",
                "confirm"
            ],
            "properties": {
                "plan_id": {
                    "$ref": "#/$defs/id"
                },
                "idempotency_key": {
                    "$ref": "#/$defs/key"
                },
                "confirm": {
                    "const": true
                },
                "in_place": {
                    "type": "boolean",
                    "default": false
                },
                "copy_operation_id": {
                    "$ref": "#/$defs/id"
                }
            },
            "not": {
                "properties": {
                    "in_place": {
                        "const": true
                    }
                },
                "required": [
                    "in_place",
                    "copy_operation_id"
                ]
            }
        },
        "planUnityMigrationResult": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "kind",
                        "current_version"
                    ],
                    "properties": {
                        "kind": {
                            "const": "no_change"
                        },
                        "current_version": {
                            "$ref": "#/$defs/canonicalUnityVersion"
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "kind",
                        "plan",
                        "replayed"
                    ],
                    "properties": {
                        "kind": {
                            "const": "planned"
                        },
                        "plan": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "plan_id",
                                "project_id",
                                "source_unity_version",
                                "target_unity_version",
                                "target_installation_id",
                                "classification",
                                "expires_at_ms"
                            ],
                            "properties": {
                                "plan_id": {
                                    "$ref": "#/$defs/id"
                                },
                                "project_id": {
                                    "$ref": "#/$defs/id"
                                },
                                "source_unity_version": {
                                    "$ref": "#/$defs/canonicalUnityVersion"
                                },
                                "target_sdk_version": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "target_unity_version": {
                                    "$ref": "#/$defs/canonicalUnityVersion"
                                },
                                "target_installation_id": {
                                    "$ref": "#/$defs/id"
                                },
                                "classification": {
                                    "$ref": "#/$defs/projectUnityMigrationClassification"
                                },
                                "expires_at_ms": {
                                    "type": "integer",
                                    "minimum": 0
                                }
                            }
                        },
                        "destination_path": {
                            "type": "string",
                            "minLength": 1
                        },
                        "replayed": {
                            "type": "boolean"
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "copy_required"
                        },
                        "copy_plan": {
                            "$ref": "#/$defs/copyPlan"
                        },
                        "source_path": {
                            "type": "string"
                        },
                        "destination_path": {
                            "type": "string"
                        },
                        "target_unity_version": {
                            "$ref": "#/$defs/canonicalUnityVersion"
                        },
                        "target_sdk_version": {
                            "type": "string"
                        },
                        "target_installation_id": {
                            "$ref": "#/$defs/id"
                        }
                    },
                    "required": [
                        "kind",
                        "copy_plan",
                        "source_path",
                        "destination_path",
                        "target_unity_version",
                        "target_sdk_version",
                        "target_installation_id"
                    ]
                }
            ]
        },
        "applyUnityMigrationResult": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "operation_id",
                "replayed"
            ],
            "properties": {
                "operation_id": {
                    "$ref": "#/$defs/id"
                },
                "replayed": {
                    "type": "boolean"
                }
            }
        }
    }
}
