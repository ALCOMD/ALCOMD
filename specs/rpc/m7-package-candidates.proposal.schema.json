{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.vrclearn.com/schema/proposals/m7-package-candidates.json",
    "title": "M7 H2-A Project package candidate evidence",
    "x-alcomd-publication": "implemented-local-candidate",
    "x-alcomd-approval": "owner-approved",
    "x-alcomd-active-rpc-modified": true,
    "x-alcomd-method": "packages.queryProjectCandidates",
    "x-alcomd-capability": "packages.candidates.v2",
    "x-alcomd-method-permissions": {
        "packages.queryProjectCandidates": [
            "projects.read",
            "repositories.read",
            "packages.read",
            "settings.read"
        ]
    },
    "x-alcomd-new-errors": [
        "package_candidate_evidence_stale",
        "package_candidate_limit_exceeded"
    ],
    "$defs": {
        "SourceSelector": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "kind": {
                            "const": "repository"
                        },
                        "repository_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                        }
                    },
                    "required": [
                        "kind",
                        "repository_id"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "kind": {
                            "const": "user_package"
                        },
                        "user_package_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                        }
                    },
                    "required": [
                        "kind",
                        "user_package_id"
                    ],
                    "additionalProperties": false
                }
            ]
        },
        "Reasons": {
            "type": "array",
            "items": {
                "enum": [
                    "no_visible_candidate",
                    "source_unavailable",
                    "all_yanked",
                    "prerelease_excluded",
                    "stable_unavailable",
                    "unity_incompatible",
                    "project_unity_unknown",
                    "catalog_incomplete",
                    "metadata_invalid",
                    "classification_unknown",
                    "installed_evidence_unknown",
                    "legacy_metadata",
                    "source_ambiguous"
                ]
            },
            "minItems": 1,
            "maxItems": 13,
            "uniqueItems": true
        },
        "Cursor": {
            "type": "object",
            "properties": {
                "snapshotFingerprint": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                },
                "queryFingerprint": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                },
                "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                }
            },
            "required": [
                "snapshotFingerprint",
                "queryFingerprint",
                "offset"
            ],
            "additionalProperties": false
        },
        "SummaryView": {
            "type": "object",
            "properties": {
                "kind": {
                    "const": "summary"
                },
                "filter": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "search": {
                            "type": "string",
                            "maxLength": 256,
                            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
                        },
                        "status": {
                            "enum": [
                                "installed",
                                "available",
                                "missing"
                            ]
                        },
                        "source": {
                            "enum": [
                                "local",
                                "remote",
                                "user-package"
                            ]
                        }
                    }
                },
                "bulkPackageIds": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "maxItems": 4096,
                    "uniqueItems": true
                },
                "packageIds": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "minItems": 1,
                    "maxItems": 256,
                    "uniqueItems": true
                },
                "sources": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "packageId": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                            },
                            "source": {
                                "$ref": "#/$defs/SourceSelector"
                            }
                        },
                        "required": [
                            "packageId",
                            "source"
                        ],
                        "additionalProperties": false
                    },
                    "minItems": 0,
                    "maxItems": 256
                }
            },
            "required": [
                "kind"
            ],
            "allOf": [
                {
                    "not": {
                        "required": [
                            "bulkPackageIds",
                            "packageIds"
                        ]
                    }
                },
                {
                    "not": {
                        "required": [
                            "bulkPackageIds",
                            "filter"
                        ]
                    }
                }
            ],
            "additionalProperties": false
        },
        "VersionsView": {
            "type": "object",
            "properties": {
                "kind": {
                    "const": "versions"
                },
                "packageId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "source": {
                    "$ref": "#/$defs/SourceSelector"
                }
            },
            "required": [
                "kind",
                "packageId"
            ],
            "additionalProperties": false
        },
        "Request": {
            "type": "object",
            "properties": {
                "projectId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "expectedRevision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                },
                "view": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/SummaryView"
                        },
                        {
                            "$ref": "#/$defs/VersionsView"
                        }
                    ]
                },
                "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 128,
                    "default": 64
                },
                "expectedSnapshot": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                },
                "cursor": {
                    "$ref": "#/$defs/Cursor"
                }
            },
            "required": [
                "projectId",
                "expectedRevision",
                "view"
            ],
            "not": {
                "required": [
                    "view",
                    "cursor"
                ],
                "properties": {
                    "view": {
                        "required": [
                            "bulkPackageIds"
                        ]
                    }
                }
            },
            "additionalProperties": false
        },
        "Installed": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "kind": {
                            "const": "absent"
                        }
                    },
                    "required": [
                        "kind"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "kind": {
                            "const": "locked"
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                        }
                    },
                    "required": [
                        "kind",
                        "version"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "kind": {
                            "const": "unknown"
                        },
                        "reason": {
                            "const": "installed_evidence_unknown"
                        }
                    },
                    "required": [
                        "kind",
                        "reason"
                    ],
                    "additionalProperties": false
                }
            ]
        },
        "Candidate": {
            "type": "object",
            "description": "Core applies source and prerelease visibility before producing this record. Closed sources and policy-excluded prerelease versions are never returned as disabled candidate records.",
            "properties": {
                "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                },
                "source": {
                    "$ref": "#/$defs/SourceSelector"
                },
                "sourceRevision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                },
                "classification": {
                    "enum": [
                        "stable",
                        "prerelease",
                        "unknown"
                    ]
                },
                "relation": {
                    "enum": [
                        "not_installed",
                        "newer",
                        "same_precedence",
                        "older",
                        "unknown"
                    ]
                },
                "unity": {
                    "$comment": "Same numeric package minimum as Plan: unity plus optional unityRelease, a/b/f/p; absent unity adds no minimum, uninterpretable values stay unknown. Legacy metadata alone is not proof that cleanup is required.",
                    "enum": [
                        "not_required",
                        "compatible",
                        "incompatible",
                        "unknown"
                    ]
                },
                "eligibility": {
                    "enum": [
                        "eligible",
                        "blocked",
                        "unknown"
                    ]
                },
                "reasons": {
                    "type": "array",
                    "items": {
                        "enum": [
                            "no_visible_candidate",
                            "source_unavailable",
                            "all_yanked",
                            "prerelease_excluded",
                            "stable_unavailable",
                            "unity_incompatible",
                            "project_unity_unknown",
                            "catalog_incomplete",
                            "metadata_invalid",
                            "classification_unknown",
                            "installed_evidence_unknown",
                            "legacy_metadata",
                            "source_ambiguous"
                        ]
                    },
                    "minItems": 0,
                    "maxItems": 13,
                    "uniqueItems": true
                }
            },
            "required": [
                "version",
                "source",
                "sourceRevision",
                "classification",
                "relation",
                "unity",
                "eligibility",
                "reasons"
            ],
            "additionalProperties": false,
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "eligibility": {
                                "const": "eligible"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "classification": {
                                "enum": [
                                    "stable",
                                    "prerelease"
                                ]
                            },
                            "unity": {
                                "enum": [
                                    "not_required",
                                    "compatible"
                                ]
                            },
                            "reasons": {
                                "maxItems": 0
                            }
                        }
                    },
                    "else": {
                        "properties": {
                            "reasons": {
                                "minItems": 1
                            }
                        }
                    }
                }
            ]
        },
        "Choice": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "kind": {
                            "const": "candidate"
                        },
                        "candidate": {
                            "$ref": "#/$defs/Candidate"
                        }
                    },
                    "required": [
                        "kind",
                        "candidate"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "kind": {
                            "const": "none"
                        },
                        "reasons": {
                            "$ref": "#/$defs/Reasons"
                        }
                    },
                    "required": [
                        "kind",
                        "reasons"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "kind": {
                            "const": "unknown"
                        },
                        "reasons": {
                            "$ref": "#/$defs/Reasons"
                        }
                    },
                    "required": [
                        "kind",
                        "reasons"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "kind": {
                            "const": "ambiguous"
                        },
                        "reason": {
                            "const": "source_ambiguous"
                        }
                    },
                    "required": [
                        "kind",
                        "reason"
                    ],
                    "additionalProperties": false
                }
            ]
        },
        "Update": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "kind": {
                            "const": "target"
                        },
                        "candidate": {
                            "allOf": [
                                {
                                    "$ref": "#/$defs/Candidate"
                                },
                                {
                                    "properties": {
                                        "eligibility": {
                                            "const": "eligible"
                                        },
                                        "relation": {
                                            "const": "newer"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "required": [
                        "kind",
                        "candidate"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "kind": {
                            "const": "no_update"
                        },
                        "reason": {
                            "enum": [
                                "same_precedence",
                                "installed_newer",
                                "not_installed"
                            ]
                        }
                    },
                    "required": [
                        "kind",
                        "reason"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "kind": {
                            "const": "unavailable"
                        },
                        "reasons": {
                            "$ref": "#/$defs/Reasons"
                        }
                    },
                    "required": [
                        "kind",
                        "reasons"
                    ],
                    "additionalProperties": false
                }
            ]
        },
        "Summary": {
            "type": "object",
            "properties": {
                "packageId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "direct": {
                    "type": "boolean"
                },
                "installed": {
                    "$ref": "#/$defs/Installed"
                },
                "latest": {
                    "$ref": "#/$defs/Choice"
                },
                "latestStable": {
                    "$ref": "#/$defs/Choice"
                },
                "projectLatest": {
                    "$ref": "#/$defs/Choice"
                },
                "projectLatestStable": {
                    "$ref": "#/$defs/Choice"
                },
                "update": {
                    "$ref": "#/$defs/Update"
                },
                "stableUpdate": {
                    "$ref": "#/$defs/Update"
                },
                "providers": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Provider"
                    },
                    "maxItems": 4096
                },
                "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                },
                "links": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": false,
                    "properties": {
                        "documentation": {
                            "type": "string",
                            "maxLength": 2048,
                            "pattern": "^https?://"
                        },
                        "changelog": {
                            "type": "string",
                            "maxLength": 2048,
                            "pattern": "^https?://"
                        }
                    }
                },
                "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 65536
                },
                "installedYanked": {
                    "type": "boolean"
                },
                "presentationState": {
                    "$ref": "#/$defs/PresentationState"
                }
            },
            "required": [
                "packageId",
                "direct",
                "installed",
                "latest",
                "latestStable",
                "projectLatest",
                "projectLatestStable",
                "update",
                "stableUpdate",
                "providers",
                "presentationState"
            ],
            "additionalProperties": false
        },
        "Snapshot": {
            "type": "object",
            "properties": {
                "fingerprint": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                },
                "projectRevision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                },
                "configRevision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                }
            },
            "required": [
                "fingerprint",
                "projectRevision",
                "configRevision"
            ],
            "additionalProperties": false
        },
        "BulkIntent": {
            "type": "object",
            "properties": {
                "kind": {
                    "enum": [
                        "install",
                        "upgrade",
                        "remove",
                        "reinstall"
                    ]
                },
                "packageId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "versionRange": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 257
                },
                "source": {
                    "$ref": "#/$defs/SourceSelector"
                },
                "includePrerelease": {
                    "type": "boolean"
                }
            },
            "required": [
                "kind",
                "packageId"
            ],
            "oneOf": [
                {
                    "properties": {
                        "kind": {
                            "enum": [
                                "install",
                                "upgrade"
                            ]
                        }
                    },
                    "required": [
                        "versionRange",
                        "source",
                        "includePrerelease"
                    ]
                },
                {
                    "properties": {
                        "kind": {
                            "const": "remove"
                        },
                        "versionRange": false,
                        "source": false,
                        "includePrerelease": false
                    }
                },
                {
                    "properties": {
                        "kind": {
                            "const": "reinstall"
                        },
                        "versionRange": false,
                        "includePrerelease": false
                    }
                }
            ],
            "additionalProperties": false
        },
        "BulkIntents": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/BulkIntent"
            },
            "maxItems": 256
        },
        "BulkAction": {
            "type": "object",
            "properties": {
                "targetCount": {
                    "type": "integer",
                    "minimum": 0
                },
                "intents": {
                    "$ref": "#/$defs/BulkIntents"
                },
                "exclusions": {
                    "type": "array",
                    "maxItems": 256,
                    "items": {
                        "type": "object",
                        "properties": {
                            "packageId": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                            },
                            "update": {
                                "$ref": "#/$defs/Update"
                            }
                        },
                        "required": [
                            "packageId",
                            "update"
                        ],
                        "additionalProperties": false
                    }
                },
                "omittedExclusions": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "required": [
                "targetCount",
                "intents",
                "exclusions",
                "omittedExclusions"
            ],
            "additionalProperties": false
        },
        "BulkActions": {
            "type": "object",
            "properties": {
                "updateAll": {
                    "$ref": "#/$defs/BulkAction"
                },
                "updateAllStable": {
                    "$ref": "#/$defs/BulkAction"
                },
                "installUpdate": {
                    "$ref": "#/$defs/BulkAction"
                },
                "installUpdateStable": {
                    "$ref": "#/$defs/BulkAction"
                },
                "remove": {
                    "$ref": "#/$defs/BulkIntents"
                },
                "reinstall": {
                    "$ref": "#/$defs/BulkIntents"
                }
            },
            "required": [
                "updateAll",
                "installUpdate",
                "remove",
                "reinstall"
            ],
            "additionalProperties": false
        },
        "SummaryPage": {
            "type": "object",
            "properties": {
                "projectId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "snapshot": {
                    "$ref": "#/$defs/Snapshot"
                },
                "showPrerelease": {
                    "type": "boolean"
                },
                "catalogComplete": {
                    "type": "boolean"
                },
                "nextCursor": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "#/$defs/Cursor"
                        }
                    ]
                },
                "view": {
                    "const": "summary"
                },
                "bulk": {
                    "$ref": "#/$defs/BulkActions"
                },
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Summary"
                    },
                    "minItems": 0,
                    "maxItems": 128
                },
                "presentationComplete": {
                    "type": "boolean"
                }
            },
            "required": [
                "projectId",
                "snapshot",
                "showPrerelease",
                "catalogComplete",
                "nextCursor",
                "view",
                "items",
                "presentationComplete"
            ],
            "if": {
                "required": [
                    "bulk"
                ]
            },
            "then": {
                "properties": {
                    "items": {
                        "maxItems": 0
                    },
                    "nextCursor": {
                        "type": "null"
                    }
                }
            },
            "additionalProperties": false
        },
        "VersionsPage": {
            "type": "object",
            "properties": {
                "projectId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "snapshot": {
                    "$ref": "#/$defs/Snapshot"
                },
                "showPrerelease": {
                    "type": "boolean"
                },
                "catalogComplete": {
                    "type": "boolean"
                },
                "nextCursor": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "#/$defs/Cursor"
                        }
                    ]
                },
                "view": {
                    "const": "versions"
                },
                "packageId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Candidate"
                    },
                    "minItems": 0,
                    "maxItems": 128
                },
                "presentationComplete": {
                    "type": "boolean"
                }
            },
            "required": [
                "projectId",
                "snapshot",
                "showPrerelease",
                "catalogComplete",
                "nextCursor",
                "view",
                "packageId",
                "items",
                "presentationComplete"
            ],
            "additionalProperties": false
        },
        "Result": {
            "oneOf": [
                {
                    "$ref": "#/$defs/SummaryPage"
                },
                {
                    "$ref": "#/$defs/VersionsPage"
                }
            ]
        },
        "Provider": {
            "type": "object",
            "properties": {
                "source": {
                    "$ref": "#/$defs/SourceSelector"
                },
                "sourceRevision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                },
                "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                },
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                },
                "builtin": {
                    "enum": [
                        "official",
                        "curated"
                    ]
                },
                "sourceKind": {
                    "enum": [
                        "remote",
                        "local",
                        "user-package"
                    ]
                },
                "displayOrder": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                }
            },
            "required": [
                "source",
                "sourceRevision",
                "sourceKind",
                "displayOrder"
            ],
            "additionalProperties": false
        },
        "PresentationState": {
            "enum": [
                "complete",
                "partial",
                "unobserved"
            ]
        }
    },
    "oneOf": [
        {
            "$ref": "#/$defs/Request"
        },
        {
            "$ref": "#/$defs/Result"
        }
    ],
    "x-alcomd-breaking-change": true,
    "x-alcomd-quotas": {
        "requestUtf8Bytes": 65536,
        "responseUtf8Bytes": 1048576,
        "defaultPage": 64,
        "maxPage": 128,
        "explicitPackageIds": 256,
        "sourceDescriptors": 4096,
        "relatedVersionRecords": 100000,
        "guiConcurrentRequests": 2,
        "rpcFrameEnvelopeIncluded": true
    },
    "x-alcomd-state-version": 30
}
