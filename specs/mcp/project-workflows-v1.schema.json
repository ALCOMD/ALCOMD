{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "MCP project and backup workflows",
    "$id": "https://alcomd.vrclearn.com/schema/mcp/project-workflows-v1.json",
    "x-alcomd-tools": [
        {
            "name": "alcomd_list_project_templates",
            "title": "List project templates",
            "description": "Read templates available for project creation.",
            "inputSchema": {
                "type": "object",
                "$ref": "#/$defs/listTemplates"
            },
            "outputSchema": {
                "oneOf": [
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "data": {
                                "$ref": "#/$defs/templates"
                            }
                        },
                        "required": [
                            "data"
                        ]
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "error": {
                                "$ref": "#/$defs/toolError"
                            }
                        },
                        "required": [
                            "error"
                        ]
                    }
                ]
            },
            "effect": "read",
            "requiredPermissions": [
                "projects.create"
            ]
        },
        {
            "name": "alcomd_apply_project_copy",
            "title": "Apply a reviewed project copy",
            "description": "Use the original copy plan after the operator confirms it.",
            "inputSchema": {
                "type": "object",
                "$ref": "#/$defs/applyCopy"
            },
            "outputSchema": {
                "oneOf": [
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "data": {
                                "$ref": "#/$defs/copyAccepted"
                            }
                        },
                        "required": [
                            "data"
                        ]
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "error": {
                                "$ref": "#/$defs/toolError"
                            }
                        },
                        "required": [
                            "error"
                        ]
                    }
                ]
            },
            "effect": "apply",
            "requiredPermissions": [
                "projects.read",
                "projects.create"
            ]
        },
        {
            "name": "alcomd_create_backup",
            "title": "Create a project backup",
            "description": "Write a ZIP to a new absolute file path on the Core host, or use the configured backup directory.",
            "inputSchema": {
                "type": "object",
                "$ref": "#/$defs/createBackup"
            },
            "outputSchema": {
                "oneOf": [
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "data": {
                                "$ref": "#/$defs/backupAccepted"
                            }
                        },
                        "required": [
                            "data"
                        ]
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "error": {
                                "$ref": "#/$defs/toolError"
                            }
                        },
                        "required": [
                            "error"
                        ]
                    }
                ]
            },
            "effect": "apply",
            "requiredPermissions": [
                "projects.read",
                "backups.manage"
            ]
        },
        {
            "name": "alcomd_restore_backup",
            "title": "Restore a Unity project from ZIP",
            "description": "Restore a ZIP whose root is a Unity project. Supply an absolute archive path on the Core host and confirm the restore. An optional destination is a new absolute project directory.",
            "inputSchema": {
                "type": "object",
                "$ref": "#/$defs/restoreBackup"
            },
            "outputSchema": {
                "oneOf": [
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "data": {
                                "$ref": "#/$defs/backupAccepted"
                            }
                        },
                        "required": [
                            "data"
                        ]
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "error": {
                                "$ref": "#/$defs/toolError"
                            }
                        },
                        "required": [
                            "error"
                        ]
                    }
                ]
            },
            "effect": "apply",
            "requiredPermissions": [
                "backups.read",
                "backups.manage",
                "projects.create"
            ]
        }
    ],
    "$defs": {
        "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
        },
        "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
        },
        "listTemplates": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "cursor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                }
            }
        },
        "templates": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "templates": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "id": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                            },
                            "name": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                            },
                            "editor_version": {
                                "anyOf": [
                                    {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 128
                                    },
                                    {
                                        "type": "null"
                                    }
                                ]
                            },
                            "revision": {
                                "$ref": "#/$defs/revision"
                            },
                            "locked": {
                                "type": "boolean"
                            }
                        },
                        "required": [
                            "id",
                            "name",
                            "revision",
                            "locked"
                        ]
                    },
                    "maxItems": 100
                },
                "next_cursor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                }
            },
            "required": [
                "templates"
            ]
        },
        "applyCopy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "plan_id": {
                    "$ref": "#/$defs/id"
                },
                "expected_revision": {
                    "$ref": "#/$defs/revision"
                },
                "confirm": {
                    "const": true
                },
                "idempotency_key": {
                    "$ref": "#/$defs/key"
                }
            },
            "required": [
                "plan_id",
                "expected_revision",
                "confirm",
                "idempotency_key"
            ]
        },
        "copyAccepted": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "operation_id": {
                    "$ref": "#/$defs/id"
                },
                "target_project_id": {
                    "$ref": "#/$defs/id"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "operation_id",
                "target_project_id",
                "replayed"
            ]
        },
        "compression": {
            "enum": [
                "store",
                "fast",
                "level3",
                "level5",
                "level7",
                "maximum"
            ]
        },
        "createBackup": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "project_id": {
                    "$ref": "#/$defs/id"
                },
                "expected_revision": {
                    "$ref": "#/$defs/revision"
                },
                "compression_mode": {
                    "$ref": "#/$defs/compression"
                },
                "exclude_vpm_packages": {
                    "type": "boolean"
                },
                "include_library": {
                    "type": "boolean"
                },
                "idempotency_key": {
                    "$ref": "#/$defs/key"
                },
                "destination_path": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "required": [
                "project_id",
                "expected_revision",
                "idempotency_key"
            ]
        },
        "backupAccepted": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "operation_id": {
                    "$ref": "#/$defs/id"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "operation_id",
                "replayed"
            ]
        },
        "toolError": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                },
                "retryable": {
                    "type": "boolean"
                },
                "diagnostic_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "outcome": {
                    "const": "unknown"
                },
                "details": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "subreason": {
                            "type": "string",
                            "maxLength": 128,
                            "pattern": "^[a-zA-Z0-9_]*$"
                        }
                    },
                    "required": [
                        "subreason"
                    ]
                }
            },
            "required": [
                "code",
                "message",
                "retryable"
            ]
        },
        "restoreBackup": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "archive_path",
                "idempotency_key",
                "confirm"
            ],
            "properties": {
                "archive_path": {
                    "type": "string",
                    "minLength": 1
                },
                "project_name": {
                    "type": "string",
                    "minLength": 1
                },
                "destination_path": {
                    "type": "string",
                    "minLength": 1
                },
                "idempotency_key": {
                    "$ref": "#/$defs/key"
                },
                "confirm": {
                    "const": true
                }
            },
            "not": {
                "required": [
                    "project_name",
                    "destination_path"
                ]
            }
        }
    }
}
