        {"nodeId": "refresh-interval", "parentId": "settings-form", "order": 3, "kind": "integer-field", "payload": {"fieldId": "refresh-interval", "label": "Refresh interval seconds", "initialValue": 15, "required": true, "minimum": 5, "maximum": 300, "disabled": false, "readOnly": false}},
        {"nodeId": "status-divider", "parentId": "root", "order": 2, "kind": "divider", "payload": {}},
