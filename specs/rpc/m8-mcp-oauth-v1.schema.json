{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.vrclearn.com/schema/rpc/v1/m8-mcp-oauth-v1.json",
    "title": "M8 OAuth Core RPC with connection-level consent",
    "$defs": {
        "Registration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "oauthClientId": {
                    "type": "string",
                    "maxLength": 36,
                    "minLength": 36
                },
                "clientId": {
                    "type": "string",
                    "maxLength": 36,
                    "minLength": 36
                },
                "issuer": {
                    "type": "string",
                    "maxLength": 2048
                },
                "resource": {
                    "type": "string",
                    "maxLength": 2048
                },
                "redirectUris": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                        "type": "string",
                        "maxLength": 2048
                    },
                    "minItems": 1
                },
                "confidential": {
                    "type": "boolean"
                },
                "allowRefresh": {
                    "type": "boolean"
                },
                "revision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                },
                "createdAtMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                },
                "revokedAtMs": {
                    "anyOf": [
                        {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9223372036854775807
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "oauthClientId",
                "clientId",
                "issuer",
                "resource",
                "redirectUris",
                "confidential",
                "allowRefresh",
                "revision",
                "createdAtMs"
            ]
        },
        "RegistrationSetParams": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "clientId": {
                    "type": "string",
                    "maxLength": 36,
                    "minLength": 36
                },
                "issuer": {
                    "type": "string",
                    "maxLength": 2048
                },
                "resource": {
                    "type": "string",
                    "maxLength": 2048
                },
                "redirectUris": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                        "type": "string",
                        "maxLength": 2048
                    },
                    "minItems": 1
                },
                "confidential": {
                    "type": "boolean"
                },
                "allowRefresh": {
                    "type": "boolean"
                },
                "expectedRevision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                },
                "idempotencyKey": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[!-~]+$"
                }
            },
            "required": [
                "clientId",
                "issuer",
                "resource",
                "redirectUris",
                "confidential",
                "allowRefresh",
                "expectedRevision",
                "idempotencyKey"
            ]
        },
        "RegistrationRevokeParams": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "oauthClientId": {
                    "type": "string",
                    "maxLength": 36,
                    "minLength": 36
                },
                "expectedRevision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                },
                "idempotencyKey": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[!-~]+$"
                }
            },
            "required": [
                "oauthClientId",
                "expectedRevision",
                "idempotencyKey"
            ]
        },
        "PageParams": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "cursor": {
                    "anyOf": [
                        {
                            "type": "string",
                            "maxLength": 512
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "limit": {
                    "anyOf": [
                        {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 128
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": []
        },
        "RegistrationPage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "items": {
                    "type": "array",
                    "maxItems": 128,
                    "items": {
                        "$ref": "#/$defs/Registration"
                    }
                },
                "nextCursor": {
                    "anyOf": [
                        {
                            "type": "string",
                            "maxLength": 2048
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "items"
            ]
        },
        "RegistrationResult": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "registration": {
                    "$ref": "#/$defs/Registration"
                },
                "clientSecret": {
                    "anyOf": [
                        {
                            "type": "string",
                            "maxLength": 64,
                            "minLength": 64,
                            "pattern": "^[0-9a-f]{64}$",
                            "x-alcomd-secret": true
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "registration"
            ]
        },
        "BeginParams": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "oauthClientId": {
                    "type": "string",
                    "maxLength": 36,
                    "minLength": 36
                },
                "issuer": {
                    "type": "string",
                    "maxLength": 2048
                },
                "resource": {
                    "type": "string",
                    "maxLength": 2048
                },
                "redirectUri": {
                    "type": "string",
                    "maxLength": 2048
                },
                "codeChallenge": {
                    "type": "string",
                    "maxLength": 43,
                    "minLength": 43,
                    "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "codeChallengeMethod": {
                    "type": "string",
                    "maxLength": 2048,
                    "const": "S256"
                },
                "scopes": {
                    "const": [
                        "mcp"
                    ]
                },
                "state": {
                    "anyOf": [
                        {
                            "type": "string",
                            "maxLength": 2048
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "oauthClientId",
                "issuer",
                "resource",
                "redirectUri",
                "codeChallenge",
                "codeChallengeMethod",
                "scopes"
            ]
        },
        "BeginResult": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "requestId": {
                    "type": "string",
                    "maxLength": 36,
                    "minLength": 36
                },
                "browserSecret": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 64,
                    "pattern": "^[0-9a-f]{64}$",
                    "x-alcomd-secret": true
                }
            },
            "required": [
                "requestId",
                "browserSecret"
            ]
        },
        "FinishParams": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "requestId": {
                    "type": "string",
                    "maxLength": 36,
                    "minLength": 36
                },
                "browserSecret": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 64,
                    "pattern": "^[0-9a-f]{64}$",
                    "x-alcomd-secret": true,
                    "writeOnly": true
                }
            },
            "required": [
                "requestId",
                "browserSecret"
            ]
        },
        "FinishResult": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "status": {
                    "type": "string",
                    "maxLength": 2048,
                    "enum": [
                        "pending",
                        "denied",
                        "expired",
                        "approved",
                        "consumed"
                    ]
                },
                "redirectUrl": {
                    "anyOf": [
                        {
                            "type": "string",
                            "maxLength": 2048
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "status"
            ]
        },
        "TokenParams": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "grantType": {
                    "type": "string",
                    "maxLength": 2048,
                    "enum": [
                        "authorization_code",
                        "refresh_token"
                    ]
                },
                "oauthClientId": {
                    "type": "string",
                    "maxLength": 36,
                    "minLength": 36
                },
                "resource": {
                    "type": "string",
                    "maxLength": 2048
                },
                "code": {
                    "anyOf": [
                        {
                            "type": "string",
                            "maxLength": 256,
                            "x-alcomd-secret": true,
                            "writeOnly": true
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "redirectUri": {
                    "anyOf": [
                        {
                            "type": "string",
                            "maxLength": 2048
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "codeVerifier": {
                    "anyOf": [
                        {
                            "type": "string",
                            "maxLength": 128,
                            "minLength": 43,
                            "pattern": "^[A-Za-z0-9._~-]+$",
                            "x-alcomd-secret": true,
                            "writeOnly": true
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "refreshToken": {
                    "anyOf": [
                        {
                            "type": "string",
                            "maxLength": 68,
                            "minLength": 68,
                            "pattern": "^or1_[0-9a-f]{64}$",
                            "x-alcomd-secret": true,
                            "writeOnly": true
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "scopes": {
                    "anyOf": [
                        {
                            "const": [
                                "mcp"
                            ]
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "clientSecret": {
                    "anyOf": [
                        {
                            "type": "string",
                            "maxLength": 64,
                            "minLength": 64,
                            "pattern": "^[0-9a-f]{64}$",
                            "x-alcomd-secret": true,
                            "writeOnly": true
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "grantType",
                "oauthClientId",
                "resource"
            ]
        },
        "TokenResult": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "accessToken": {
                    "type": "string",
                    "maxLength": 68,
                    "minLength": 68,
                    "pattern": "^oa1_[0-9a-f]{64}$",
                    "x-alcomd-secret": true
                },
                "tokenType": {
                    "type": "string",
                    "maxLength": 2048,
                    "const": "Bearer"
                },
                "expiresIn": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 600
                },
                "scope": {
                    "const": "mcp"
                },
                "refreshToken": {
                    "anyOf": [
                        {
                            "type": "string",
                            "maxLength": 68,
                            "minLength": 68,
                            "pattern": "^or1_[0-9a-f]{64}$",
                            "x-alcomd-secret": true
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "accessToken",
                "tokenType",
                "expiresIn",
                "scope"
            ]
        },
        "RevokeParams": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "oauthClientId": {
                    "type": "string",
                    "maxLength": 36,
                    "minLength": 36
                },
                "token": {
                    "type": "string",
                    "maxLength": 256,
                    "x-alcomd-secret": true,
                    "writeOnly": true
                },
                "clientSecret": {
                    "anyOf": [
                        {
                            "type": "string",
                            "maxLength": 64,
                            "minLength": 64,
                            "pattern": "^[0-9a-f]{64}$",
                            "x-alcomd-secret": true,
                            "writeOnly": true
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "tokenTypeHint": {
                    "anyOf": [
                        {
                            "type": "string",
                            "maxLength": 2048
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "oauthClientId",
                "token"
            ]
        },
        "RequestGetParams": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "requestId": {
                    "type": "string",
                    "maxLength": 36,
                    "minLength": 36
                }
            },
            "required": [
                "requestId"
            ]
        },
        "RequestReview": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "requestId": {
                    "type": "string",
                    "maxLength": 36,
                    "minLength": 36
                },
                "oauthClientId": {
                    "type": "string",
                    "maxLength": 36,
                    "minLength": 36
                },
                "clientId": {
                    "type": "string",
                    "maxLength": 36,
                    "minLength": 36
                },
                "displayName": {
                    "type": "string",
                    "maxLength": 128
                },
                "issuer": {
                    "type": "string",
                    "maxLength": 2048
                },
                "resource": {
                    "type": "string",
                    "maxLength": 2048
                },
                "redirectUri": {
                    "type": "string",
                    "maxLength": 2048
                },
                "scopes": {
                    "const": [
                        "mcp"
                    ]
                },
                "approvalFingerprint": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 64,
                    "pattern": "^[0-9a-f]{64}$"
                },
                "status": {
                    "type": "string",
                    "maxLength": 2048,
                    "enum": [
                        "pending",
                        "denied",
                        "expired",
                        "approved",
                        "consumed"
                    ]
                },
                "expiresAtMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                }
            },
            "required": [
                "requestId",
                "oauthClientId",
                "clientId",
                "displayName",
                "issuer",
                "resource",
                "redirectUri",
                "scopes",
                "approvalFingerprint",
                "status",
                "expiresAtMs"
            ]
        },
        "RequestDecideParams": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "requestId": {
                    "type": "string",
                    "maxLength": 36,
                    "minLength": 36
                },
                "approve": {
                    "type": "boolean"
                },
                "expectedFingerprint": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 64,
                    "pattern": "^[0-9a-f]{64}$"
                },
                "idempotencyKey": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[!-~]+$"
                }
            },
            "required": [
                "requestId",
                "approve",
                "expectedFingerprint",
                "idempotencyKey"
            ]
        },
        "RequestDecision": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "requestId": {
                    "type": "string",
                    "maxLength": 36,
                    "minLength": 36
                },
                "status": {
                    "type": "string",
                    "maxLength": 2048,
                    "enum": [
                        "pending",
                        "denied",
                        "expired",
                        "approved",
                        "consumed"
                    ]
                }
            },
            "required": [
                "requestId",
                "status"
            ]
        },
        "authentication": {
            "oneOf": [
                {
                    "$ref": "m8-mcp-clients-v1.schema.json#/$defs/authentication"
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "mcp-oauth-endpoint"
                        },
                        "credential": {
                            "const": ""
                        }
                    },
                    "required": [
                        "kind"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "mcp-oauth-access"
                        },
                        "credential": {
                            "type": "string",
                            "pattern": "^oa1_[0-9a-f]{64}$",
                            "writeOnly": true
                        },
                        "resource": {
                            "type": "string",
                            "maxLength": 2048,
                            "pattern": "^https://localhost:[0-9]+/mcp$"
                        }
                    },
                    "required": [
                        "kind",
                        "credential",
                        "resource"
                    ]
                }
            ]
        }
    },
    "x-alcomd-capability": "mcp.oauth.v1",
    "x-alcomd-methods": {
        "mcp.oauth.begin": {
            "params": {
                "$ref": "#/$defs/BeginParams"
            },
            "result": {
                "$ref": "#/$defs/BeginResult"
            }
        },
        "mcp.oauth.finish": {
            "params": {
                "$ref": "#/$defs/FinishParams"
            },
            "result": {
                "$ref": "#/$defs/FinishResult"
            }
        },
        "mcp.oauth.token": {
            "params": {
                "$ref": "#/$defs/TokenParams"
            },
            "result": {
                "$ref": "#/$defs/TokenResult"
            }
        },
        "mcp.oauth.revoke": {
            "params": {
                "$ref": "#/$defs/RevokeParams"
            },
            "result": {
                "type": "object",
                "additionalProperties": false
            }
        },
        "mcp.oauth.registrations.list": {
            "params": {
                "$ref": "#/$defs/PageParams"
            },
            "result": {
                "$ref": "#/$defs/RegistrationPage"
            }
        },
        "mcp.oauth.registrations.set": {
            "params": {
                "$ref": "#/$defs/RegistrationSetParams"
            },
            "result": {
                "$ref": "#/$defs/RegistrationResult"
            }
        },
        "mcp.oauth.registrations.revoke": {
            "params": {
                "$ref": "#/$defs/RegistrationRevokeParams"
            },
            "result": {
                "$ref": "#/$defs/Registration"
            }
        },
        "mcp.oauth.requests.get": {
            "params": {
                "$ref": "#/$defs/RequestGetParams"
            },
            "result": {
                "$ref": "#/$defs/RequestReview"
            }
        },
        "mcp.oauth.requests.decide": {
            "params": {
                "$ref": "#/$defs/RequestDecideParams"
            },
            "result": {
                "$ref": "#/$defs/RequestDecision"
            }
        }
    }
}
