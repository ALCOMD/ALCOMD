{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.cqmhv.com/schema/proposals/m7-unity-project-version.json",
    "title": "ALCOMD M7 Unity project version and exact launch proposal",
    "x-alcomd-publication": "proposal-only-not-active-contract",
    "x-alcomd-active-rpc-modified": false,
    "x-alcomd-state-schema-proposed": 14,
    "x-alcomd-filesystem-writer": "builtin:local-owner",
    "$defs": {
        "uuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
        },
        "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[!-~]+$"
        },
        "canonicalUnityVersion": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)[abfpx][1-9][0-9]*(c[1-9][0-9]*)?$"
        },
        "boundedArguments": {
            "type": "array",
            "maxItems": 64,
            "items": {"type": "string", "maxLength": 4096}
        },
        "classification": {
            "enum": [
                "patch_or_minor_upgrade",
                "major_upgrade",
                "patch_or_minor_downgrade",
                "major_downgrade",
                "china_variant_change",
                "unsupported_or_unsafe"
            ]
        },
        "projectUnityMigrationClassification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "supportedForApply"],
            "properties": {
                "kind": {"$ref": "#/$defs/classification"},
                "supportedForApply": {"type": "boolean"}
            }
        },
        "planUnityMigrationParams": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "projectId",
                "targetInstallationId",
                "expectedProjectRevision",
                "idempotencyKey"
            ],
            "properties": {
                "projectId": {"$ref": "#/$defs/uuid"},
                "targetInstallationId": {"$ref": "#/$defs/uuid"},
                "expectedProjectRevision": {"$ref": "#/$defs/revision"},
                "idempotencyKey": {"$ref": "#/$defs/idempotencyKey"}
            }
        },
        "planUnityMigrationResult": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": true,
                    "required": ["kind", "currentVersion"],
                    "properties": {
                        "kind": {"const": "no_change"},
                        "currentVersion": {"$ref": "#/$defs/canonicalUnityVersion"}
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": true,
                    "required": ["kind", "plan"],
                    "properties": {
                        "kind": {"const": "planned"},
                        "plan": {
                            "type": "object",
                            "additionalProperties": true,
                            "required": [
                                "planId",
                                "projectId",
                                "sourceUnityVersion",
                                "targetUnityVersion",
                                "targetInstallationId",
                                "classification",
                                "expiresAtMs"
                            ],
                            "properties": {
                                "planId": {"$ref": "#/$defs/uuid"},
                                "projectId": {"$ref": "#/$defs/uuid"},
                                "sourceUnityVersion": {"$ref": "#/$defs/canonicalUnityVersion"},
                                "targetUnityVersion": {"$ref": "#/$defs/canonicalUnityVersion"},
                                "targetInstallationId": {"$ref": "#/$defs/uuid"},
                                "classification": {"$ref": "#/$defs/projectUnityMigrationClassification"},
                                "expiresAtMs": {"type": "integer", "minimum": 0}
                            }
                        }
                    }
                }
            ]
        },
        "applyUnityMigrationParams": {
            "type": "object",
            "additionalProperties": false,
            "required": ["planId", "idempotencyKey"],
            "properties": {
                "planId": {"$ref": "#/$defs/uuid"},
                "idempotencyKey": {"$ref": "#/$defs/idempotencyKey"}
            }
        },
        "applyUnityMigrationResult": {
            "type": "object",
            "additionalProperties": true,
            "required": ["operationId", "replayed"],
            "properties": {
                "operationId": {"$ref": "#/$defs/uuid"},
                "replayed": {"type": "boolean"}
            }
        },
        "launchOptionsParams": {
            "type": "object",
            "additionalProperties": false,
            "required": ["projectId", "expectedProjectRevision"],
            "properties": {
                "projectId": {"$ref": "#/$defs/uuid"},
                "expectedProjectRevision": {"$ref": "#/$defs/revision"}
            }
        },
        "launchOptionsResult": {
            "type": "object",
            "additionalProperties": true,
            "required": [
                "projectId",
                "projectRevision",
                "projectUnityVersion",
                "exactMatchingInstallations"
            ],
            "properties": {
                "projectId": {"$ref": "#/$defs/uuid"},
                "projectRevision": {"$ref": "#/$defs/revision"},
                "projectUnityVersion": {"$ref": "#/$defs/canonicalUnityVersion"},
                "exactMatchingInstallations": {
                    "type": "array",
                    "maxItems": 1000,
                    "items": {
                        "type": "object",
                        "description": "Existing UnityInstallation safe DTO with Core-canonicalized unityVersion."
                    }
                }
            }
        },
        "launchParams": {
            "type": "object",
            "additionalProperties": false,
            "required": ["projectId", "installationId", "expectedProjectRevision", "idempotencyKey"],
            "properties": {
                "projectId": {"$ref": "#/$defs/uuid"},
                "installationId": {"$ref": "#/$defs/uuid"},
                "expectedProjectRevision": {"$ref": "#/$defs/revision"},
                "idempotencyKey": {"$ref": "#/$defs/idempotencyKey"}
            },
            "description": "installationId is required one-shot exact-version authority and is never persisted."
        },
        "launchConfigState": {
            "type": "object",
            "additionalProperties": true,
            "required": ["projectId", "arguments", "revision", "updatedAtMs"],
            "properties": {
                "projectId": {"$ref": "#/$defs/uuid"},
                "arguments": {"$ref": "#/$defs/boundedArguments"},
                "revision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                },
                "updatedAtMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                }
            }
        },
        "launchConfigGetParams": {
            "type": "object",
            "additionalProperties": false,
            "required": ["projectId"],
            "properties": {"projectId": {"$ref": "#/$defs/uuid"}}
        },
        "launchConfigSetParams": {
            "type": "object",
            "additionalProperties": false,
            "required": ["projectId", "arguments", "expectedRevision", "idempotencyKey"],
            "properties": {
                "projectId": {"$ref": "#/$defs/uuid"},
                "arguments": {"$ref": "#/$defs/boundedArguments"},
                "expectedRevision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                },
                "idempotencyKey": {"$ref": "#/$defs/idempotencyKey"}
            }
        },
        "launchConfigClearParams": {
            "type": "object",
            "additionalProperties": false,
            "required": ["projectId", "expectedRevision", "idempotencyKey"],
            "properties": {
                "projectId": {"$ref": "#/$defs/uuid"},
                "expectedRevision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                },
                "idempotencyKey": {"$ref": "#/$defs/idempotencyKey"}
            }
        },
        "launchConfigMutationResult": {
            "type": "object",
            "additionalProperties": true,
            "required": ["config", "changed", "replayed"],
            "properties": {
                "config": {"$ref": "#/$defs/launchConfigState"},
                "changed": {"type": "boolean"},
                "replayed": {"type": "boolean"}
            }
        }
    },
    "type": "object",
    "additionalProperties": false,
    "required": [
        "proposalVersion",
        "capabilities",
        "methods",
        "permissions",
        "operationKind",
        "removedSurface",
        "launchCardinality",
        "launchConfigSemantics",
        "launchOptionsAuthority",
        "migrationPlanAuthority",
        "classificationSupport",
        "platformMigrationProcess",
        "secondaryPreparation",
        "stableErrors"
    ],
    "properties": {
        "proposalVersion": {"const": 1},
        "capabilities": {
            "const": {
                "projects.unity-migration.v1": [
                    "projects.planUnityMigration",
                    "projects.applyUnityMigration"
                ],
                "unity.launch.v1": ["unity.launchOptions", "unity.launch"],
                "unity.read.v1": ["unity.projectLaunchConfig.get"],
                "unity.manage.v1": [
                    "unity.projectLaunchConfig.set",
                    "unity.projectLaunchConfig.clear"
                ]
            }
        },
        "methods": {
            "const": [
                "projects.planUnityMigration",
                "projects.applyUnityMigration",
                "unity.projectLaunchConfig.get",
                "unity.projectLaunchConfig.set",
                "unity.projectLaunchConfig.clear",
                "unity.launchOptions",
                "unity.launch"
            ]
        },
        "permissions": {
            "const": {
                "projects.planUnityMigration": ["projects.read", "unity.read", "projects.unity-migrate"],
                "projects.applyUnityMigration": ["projects.unity-migrate"],
                "unity.projectLaunchConfig.get": ["unity.read"],
                "unity.projectLaunchConfig.set": ["unity.manage"],
                "unity.projectLaunchConfig.clear": ["unity.manage"],
                "unity.launchOptions": ["projects.read", "unity.read", "unity.launch"],
                "unity.launch": ["unity.launch"]
            }
        },
        "operationKind": {"const": "projects.unity-migration"},
        "removedSurface": {
            "const": [
                "ProjectEditorPreference",
                "ProjectEditorSelection",
                "ProjectEditorSelectionState",
                "unity.projectEditor.get",
                "unity.projectEditor.set",
                "unity.projectEditor.selection.get",
                "unity.projectEditor.clear"
            ]
        },
        "launchCardinality": {
            "const": {
                "zero": "launch-options-empty-no-launch-call",
                "one": "launch-with-sole-installation-id",
                "many": "one-shot-installation-id-required",
                "selectionPersistence": "none"
            }
        },
        "launchConfigSemantics": {
            "const": {
                "missing": {"arguments": [], "revision": 0, "updatedAtMs": 0},
                "storedRevisionMinimum": 1,
                "sameValueSet": "no-op-no-revision-no-event",
                "clearMissing": "no-op-no-revision-no-event",
                "realChange": "exactly-plus-one-config-revision-and-one-event",
                "event": "unity.project_launch_config_changed",
                "migrationReadsLaunchConfig": false,
                "installationIdStored": false
            }
        },
        "launchOptionsAuthority": {
            "const": {
                "coreCanonicalizesProjectVersion": true,
                "corePerformsExactComparison": true,
                "candidateDto": "existing-UnityInstallation-safe-DTO",
                "candidateOrder": [
                    "canonical-version-bytes",
                    "source-kind-closed-order",
                    "installation-id-bytes"
                ],
                "guiVersionParsingForbidden": true
            }
        },
        "migrationPlanAuthority": {
            "const": {
                "publicInput": [
                    "projectId",
                    "expectedProjectRevision",
                    "targetInstallationId",
                    "idempotencyKey"
                ],
                "targetVersionInputForbidden": true,
                "targetVersionDerivedByCore": true,
                "expiryMs": 900000,
                "expiredError": "project_unity_migration_plan_stale",
                "expiredSafeReason": "expired",
                "sameIdempotencyKeyPermanentlyReplays": true,
                "replanRequiresNewKey": true
            }
        },
        "classificationSupport": {
            "const": {
                "patch_or_minor_upgrade": true,
                "major_upgrade": "true-except-vrchat-2019-to-2022-until-preparation-owner-seal",
                "patch_or_minor_downgrade": false,
                "major_downgrade": false,
                "china_variant_change": "true-only-same-base-release-with-exact-verified-target",
                "unsupported_or_unsafe": false,
                "vrchat_unsupported_unity_version": false
            }
        },
        "platformMigrationProcess": {
            "const": {
                "surface": "spawn_unity_editor_migration(validated_executable, authoritative_project_root) -> UnityMigrationProcess",
                "onlyMethod": "wait(self) -> UnityMigrationExit",
                "exitValues": ["success", "non_zero"],
                "argv": ["-quit", "-batchmode", "-projectPath", "authoritative-project-root"],
                "readsLaunchConfig": false,
                "killOrSignalExposed": false,
                "productionImplemented": false
            }
        },
        "secondaryPreparation": {
            "const": {
                "status": "bounded-private-profile-feasible-owner-seal-required",
                "publicP6Expansion": false,
                "classA": [
                    "resolver",
                    "cache-integrity",
                    "package-tree-and-vpm-manifest-transaction"
                ],
                "classB": [
                    "two-fixed-xr-upm-dependencies",
                    "four-fixed-vrchat-package-ids",
                    "legacy-packages",
                    "unlocked-package-conflicts",
                    "legacy-files-and-folders"
                ],
                "classC": [],
                "stopError": "UNITY_MIGRATION_SECONDARY_CONTRACT_NEEDS_OWNER"
            }
        },
        "stableErrors": {
            "const": [
                "invalid_request",
                "project_not_registered",
                "unity_editor_selection_required",
                "unity_installation_not_found",
                "unity_version_mismatch",
                "project_unity_migration_plan_not_found",
                "project_unity_migration_plan_stale",
                "project_unity_migration_unsupported",
                "project_unity_migration_source_changed",
                "project_unity_migration_recovery_required",
                "unity_project_running",
                "revision_conflict",
                "idempotency_conflict",
                "permission_denied",
                "internal_error"
            ]
        }
    }
}
