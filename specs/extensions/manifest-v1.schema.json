{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.vrclearn.com/schema/extensions/manifest-v1.json",
    "title": "ALCOMD Extension Manifest v1 parsed TOML object",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema", "id", "name", "version", "api", "publisher_name",
        "publisher_key_fingerprint", "license", "entrypoints", "interfaces", "permissions"
    ],
    "properties": {
        "installation_terms": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "title",
                "text"
            ],
            "properties": {
                "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384,
                    "description": "UTF-8 encoded text additionally limited to 16384 bytes; no control characters except CR/LF/TAB."
                }
            }
        },
        "schema": {"const": 1},
        "local_ipc_targets": {
            "type": "object", "maxProperties": 8,
            "propertyNames": {"pattern": "^[a-z0-9-]{1,64}$"},
            "additionalProperties": {
                "type": "object", "additionalProperties": false, "required": ["label"],
                "anyOf": [{"required": ["windows"]}, {"required": ["macos"]}, {"required": ["linux"]}],
                "properties": {
                    "label": {"type": "string", "minLength": 1, "maxLength": 100},
                    "windows": {
                        "type": "object", "additionalProperties": false,
                        "required": ["pipe_names", "executable_name", "publisher"],
                        "properties": {
                            "pipe_names": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]{1,80}$"}},
                            "executable_name": {"type": "string", "pattern": "^[a-z0-9-]{1,76}\\.exe$"},
                            "publisher": {"type": "string", "minLength": 1, "maxLength": 120}
                        }
                    },
                    "macos": {
                        "type": "object", "additionalProperties": false,
                        "required": ["socket_names", "bundle_identifier", "team_identifier"],
                        "properties": {
                            "socket_names": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]{1,80}$"}},
                            "bundle_identifier": {"type": "string", "maxLength": 160, "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$"},
                            "team_identifier": {"type": "string", "pattern": "^[A-Z0-9]{10}$"}
                        }
                    },
                    "linux": {
                        "type": "object", "additionalProperties": false,
                        "required": ["socket_names", "system_executable"],
                        "properties": {
                            "socket_names": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]{1,80}$"}},
                            "system_executable": {"type": "string", "maxLength": 512, "pattern": "^(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)+$"}
                        }
                    }
                }
            }
        },
        "cli": {"type":"object","additionalProperties":false,"required":["commands"],"properties":{"commands":{"const":"component/cli-commands.json"}}},
        "mcp": {"type":"object","additionalProperties":false,"required":["tools"],"properties":{"tools":{"const":"component/mcp-tools.json"}}},
        "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 255,
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
        },
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "version": {
            "type": "string",
            "minLength": 5,
            "maxLength": 128,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "api": {"const": 1},
        "publisher_name": {"type": "string", "minLength": 1, "maxLength": 120},
        "publisher_key_fingerprint": {
            "type": "string",
            "pattern": "^ed25519-sha256:[0-9a-f]{64}$"
        },
        "license": {"type": "string", "minLength": 1, "maxLength": 128},
        "entrypoints": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component"],
            "properties": {
                "component": {"const": "component/extension.wasm"}
            }
        },
        "ui": {
            "type": "object",
            "additionalProperties": false,
            "required": ["protocol"],
            "properties": {
                "protocol": {"const": "portable-v1"}
            }
        },
        "interfaces": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "optional"],
            "properties": {
                "required": {"$ref": "#/$defs/interfaces"},
                "optional": {"$ref": "#/$defs/interfaces"}
            }
        },
        "permissions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "optional"],
            "properties": {
                "required": {"$ref": "#/$defs/permissions"},
                "optional": {"$ref": "#/$defs/permissions"}
            }
        }
    },
    "allOf": [
        {
            "if": {"required": ["local_ipc_targets"], "properties": {"local_ipc_targets": {"minProperties": 1}}},
            "then": {
                "properties": {
                    "permissions": {
                        "properties": {"optional": {"contains": {"const": "local-ipc.connect"}}},
                        "allOf": [
                            {"anyOf": [{"properties": {"required": {"contains": {"const": "background.run"}}}}, {"properties": {"optional": {"contains": {"const": "background.run"}}}}]},
                            {"anyOf": [{"properties": {"required": {"contains": {"const": "projects.read"}}}}, {"properties": {"optional": {"contains": {"const": "projects.read"}}}}]},
                            {"anyOf": [{"properties": {"required": {"contains": {"const": "unity.sessions.read"}}}}, {"properties": {"optional": {"contains": {"const": "unity.sessions.read"}}}}]}
                        ]
                    },
                    "interfaces": {
                        "properties": {
                            "required": {"allOf": [
                                {"contains": {"const": "alcomd:extension/guest-background@1.0.0"}},
                                {"contains": {"const": "alcomd:extension/host-local-ipc@1.0.0"}},
                                {"contains": {"const": "alcomd:extension/host-unity-sessions@1.0.0"}}
                            ]}
                        }
                    }
                }
            },
            "else": {"properties": {"permissions": {"properties": {"optional": {"not": {"contains": {"const": "local-ipc.connect"}}}}}}}
        },
        {"properties": {"permissions": {"properties": {"required": {"not": {"contains": {"const": "local-ipc.connect"}}}}}}}
    ],
    "$defs": {
        "interfaces": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
        },
        "permissions": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9.-]*$"
            }
        }
    }
}
