{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.cqmhv.com/schema/rpc/v1/system-hello.response.json",
    "title": "ALCOMD RPC v1 system.hello success response",
    "type": "object",
    "additionalProperties": true,
    "required": [
        "id",
        "result"
    ],
    "properties": {
        "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
        },
        "result": {
            "type": "object",
            "additionalProperties": true,
            "required": [
                "rpcVersion",
                "daemonVersion",
                "capabilities"
            ],
            "properties": {
                "rpcVersion": {
                    "type": "integer",
                    "const": 1
                },
                "daemonVersion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                },
                "capabilities": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[a-z0-9][a-z0-9._-]*$"
                    },
                    "maxItems": 64,
                    "uniqueItems": true
                },
                "dataSchema": {
                    "type": "integer",
                    "enum": [1, 2, 3, 4, 5, 6, 7, 8, 9]
                },
                "extensionApi": {
                    "type": "object",
                    "additionalProperties": true,
                    "required": ["major", "world"],
                    "properties": {
                        "major": {"const": 1},
                        "world": {"const": "alcomd:extension/extension-v1@1.0.0"}
                    }
                }
            }
        }
    },
    "not": {
        "required": [
            "error"
        ]
    }
}
