{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.cqmhv.com/schema/rpc/v1/system-hello.request.json",
    "title": "ALCOMD RPC v1 system.hello request",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "id",
        "method",
        "params"
    ],
    "properties": {
        "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
        },
        "method": {
            "const": "system.hello"
        },
        "params": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "rpcVersion",
                "client",
                "capabilities"
            ],
            "properties": {
                "rpcVersion": {
                    "type": "integer",
                    "minimum": 0
                },
                "client": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "name",
                        "version",
                        "instanceId"
                    ],
                    "properties": {
                        "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                        },
                        "instanceId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                        }
                    }
                },
                "capabilities": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[a-z0-9][a-z0-9._-]*$"
                    },
                    "maxItems": 64,
                    "uniqueItems": true
                }
            }
        }
    }
}
