{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.cqmhv.com/schema/extensions/manifest-v1.json",
    "title": "ALCOMD Extension Manifest v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "id",
        "name",
        "version",
        "api",
        "publisher",
        "entrypoints",
        "permissions"
    ],
    "properties": {
        "schema": {
            "type": "integer",
            "const": 1
        },
        "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
        },
        "version": {
            "type": "string",
            "minLength": 1
        },
        "api": {
            "type": "string",
            "minLength": 1
        },
        "publisher": {
            "type": "string",
            "minLength": 1
        },
        "license": {
            "type": "string"
        },
        "entrypoints": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "ui": {
                    "type": "string",
                    "minLength": 1
                },
                "background_wasm": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "minProperties": 1
        },
        "activation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "background": {
                    "type": "boolean",
                    "default": false
                },
                "events": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true
                }
            }
        },
        "contributions": {
            "type": "object",
            "additionalProperties": {
                "type": "boolean"
            }
        },
        "permissions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "required",
                "optional"
            ],
            "properties": {
                "required": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true
                },
                "optional": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true
                }
            }
        }
    }
}
