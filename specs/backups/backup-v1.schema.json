{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.cqmhv.com/schema/backups/backup-v1.json",
    "title": "ALCOMD Backup Archive v1 manifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "formatVersion", "createdAtMs", "compressionMode", "excludeVpmPackages",
        "sourceProjectRevision", "sourceProjectFingerprint", "unityVersion",
        "excludedPackages", "packagesRequireResolve"
    ],
    "properties": {
        "formatVersion": {"const": 1},
        "createdAtMs": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "compressionMode": {"enum": ["store", "fast", "maximum"]},
        "excludeVpmPackages": {"type": "boolean"},
        "sourceProjectRevision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "sourceProjectFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "unityVersion": {"type": "string", "minLength": 1, "maxLength": 128},
        "excludedPackages": {
            "type": "array",
            "maxItems": 4096,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["packageId", "version"],
                "properties": {
                    "packageId": {
                        "type": "string", "minLength": 1, "maxLength": 214,
                        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
                    },
                    "version": {"type": "string", "minLength": 1, "maxLength": 128}
                }
            }
        },
        "packagesRequireResolve": {"const": true}
    },
    "allOf": [
        {
            "if": {"properties": {"excludeVpmPackages": {"const": false}}},
            "then": {"properties": {"excludedPackages": {"maxItems": 0}}}
        }
    ]
}
