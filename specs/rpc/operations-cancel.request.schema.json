{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.cqmhv.com/schema/rpc/v1/operations-cancel.request.json",
    "title": "ALCOMD RPC v1 operations.cancel request",
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "method", "params"],
    "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "method": {"const": "operations.cancel"},
        "params": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operationId", "expectedRevision", "idempotencyKey"],
            "properties": {
                "operationId": {"type": "string", "format": "uuid"},
                "expectedRevision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
                "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 128}
            }
        }
    }
}
