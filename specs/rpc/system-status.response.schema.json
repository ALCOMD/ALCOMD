{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.cqmhv.com/schema/rpc/v1/system-status.response.json",
    "title": "ALCOMD RPC v1 system.status success response",
    "type": "object",
    "additionalProperties": true,
    "required": [
        "id",
        "result"
    ],
    "properties": {
        "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
        },
        "result": {
            "type": "object",
            "additionalProperties": true,
            "required": [
                "product",
                "daemonVersion",
                "rpcVersion",
                "state",
                "capabilities"
            ],
            "properties": {
                "product": {
                    "const": "ALCOMD"
                },
                "daemonVersion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                },
                "rpcVersion": {
                    "type": "integer",
                    "const": 1
                },
                "state": {
                    "const": "ready"
                },
                "capabilities": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[a-z0-9][a-z0-9._-]*$"
                    },
                    "maxItems": 64,
                    "uniqueItems": true
                }
            }
        }
    },
    "not": {
        "required": [
            "error"
        ]
    }
}
