{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.cqmhv.com/schema/rpc/v1/m7-portable-ui.json",
    "title": "ALCOMD RPC v1 M7 Portable UI contract",
    "x-alcomd-publication": "active-production-contract",
    "x-alcomd-capability": "extensions.ui.portable.v1",
    "x-alcomd-route": "/extensions/:extensionId/ui",
    "x-alcomd-method-permissions": {
        "extensions.ui.open": ["extensions.read", "extensions.ui.use:ExtensionId"],
        "extensions.ui.refresh": ["extensions.read", "extensions.ui.use:ExtensionId"],
        "extensions.ui.dispatch": ["extensions.read", "extensions.ui.use:ExtensionId"],
        "extensions.ui.close": ["session-owner-best-effort"]
    },
    "x-alcomd-method-results": {
        "extensions.ui.open": "#/$defs/openResult",
        "extensions.ui.refresh": "#/$defs/snapshotResult",
        "extensions.ui.dispatch": "#/$defs/dispatchResult",
        "extensions.ui.close": "#/$defs/closeResult"
    },
    "x-alcomd-dispatch-replay": {
        "scope": "daemon-memory-per-session",
        "capacity": 64,
        "evidence": [
            "sequence",
            "requestId",
            "expectedSnapshotRevision",
            "canonicalActionFingerprint",
            "resultingSnapshot"
        ],
        "fingerprint": {
            "algorithm": "sha256",
            "domainSeparatorAscii": "ALCOMD-PORTABLE-UI-ACTION-V1",
            "separatorByte": 0,
            "encoding": "schema-order-canonical-compact-utf8-json",
            "formValueOrder": "document-node-order"
        },
        "newRequest": {
            "precondition": "sequence-is-last-accepted-plus-one-and-request-id-unused",
            "guestInvocations": 1,
            "replayed": false
        },
        "exactReplay": {
            "match": ["sequence", "requestId", "expectedSnapshotRevision", "canonicalActionFingerprint"],
            "guestInvocations": 0,
            "currentRevisionRequired": true,
            "result": "original-resulting-snapshot-only-if-current",
            "replayed": true
        },
        "historicalExactReplay": {
            "condition": "cached-resulting-revision-is-not-current-session-revision",
            "error": "extension_ui_snapshot_stale",
            "guestInvocations": 0,
            "returnsHistoricalSnapshot": false
        },
        "conflictOrOutOfOrder": {
            "error": "extension_ui_action_invalid",
            "guestInvocations": 0
        },
        "durableAcrossConnectionOrRestart": false
    },
    "x-alcomd-snapshot-monotonicity": {
        "openRevision": 1,
        "successfulGuestRefreshOrDispatch": "checked-u64-increment",
        "overflow": "internal_error-without-wrap",
        "rendererAcceptance": "greater-than-current-or-equal-current-exact-replay"
    },
    "x-alcomd-session-coordination": {
        "scope": "one-in-flight-refresh-dispatch-or-close-per-session",
        "states": ["active", "closing", "closed"],
        "closingRejectsNewInvocations": true,
        "pendingInvocationUsesExistingCancellationAndDeadline": true,
        "outOfOrderSnapshotCommit": false
    },
    "x-alcomd-locale": {
        "canonicalizedAtOpen": true,
        "immutablePerSession": true,
        "change": "confirm-dirty-close-old-open-new",
        "guestAppearanceInputs": []
    },
    "x-alcomd-invocation-capability-matrix": {
        "background": "existing-m6-grant-and-scope",
        "interactive-ui-render": ["host-projects.get-summary", "host-data.get"],
        "interactive-ui-action": ["host-projects.get-summary", "host-data.get", "host-data.set", "host-data.delete"],
        "interactive-ui-close": []
    },
    "x-alcomd-sensitive-payload": {
        "classes": ["ui-document-text", "form-drafts", "actions", "snapshots", "replay-evidence"],
        "forbiddenSinks": ["event", "log", "host-stderr", "crash-evidence", "operation", "state-db", "telemetry", "public-internal-error"],
        "replayMemoryReleasedAtClose": true,
        "secureZeroizationClaimed": false
    },
    "x-alcomd-stable-errors": [
        "invalid_request",
        "extension_not_enabled",
        "extension_ui_not_available",
        "extension_ui_protocol_unsupported",
        "extension_ui_session_not_found",
        "extension_ui_session_stale",
        "extension_ui_snapshot_stale",
        "extension_ui_document_invalid",
        "extension_ui_action_invalid",
        "extension_ui_limit_exceeded",
        "permission_denied",
        "extension_permission_denied",
        "extension_scope_denied",
        "extension_instance_stale",
        "extension_quarantined",
        "extension_crashed",
        "extension_resource_limit",
        "internal_error"
    ],
    "$defs": {
        "methodName": {
            "enum": [
                "extensions.ui.open",
                "extensions.ui.refresh",
                "extensions.ui.dispatch",
                "extensions.ui.close"
            ]
        },
        "extensionId": {
            "type": "string", "minLength": 3, "maxLength": 255,
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sessionId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "locale": {
            "type": "string", "minLength": 2, "maxLength": 15,
            "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$"
        },
        "uiDeclaration": {
            "type": "object",
            "additionalProperties": false,
            "required": ["protocol"],
            "properties": {"protocol": {"const": "portable-v1"}}
        },
        "extensionRecord": {
            "type": "object", "additionalProperties": false,
            "required": [
                "extensionId", "version", "apiMajor", "packageDigest", "publisherFingerprint",
                "trustDecision", "desiredState", "quarantineState", "runtimeState", "grantRevision",
                "lifecycleGeneration", "revision"
            ],
            "properties": {
                "extensionId": {"$ref": "#/$defs/extensionId"},
                "version": {"type": "string", "minLength": 5, "maxLength": 128},
                "apiMajor": {"const": 1},
                "packageDigest": {"$ref": "#/$defs/sha256"},
                "publisherFingerprint": {"type": "string", "pattern": "^ed25519-sha256:[0-9a-f]{64}$"},
                "trustDecision": {"enum": ["official", "user_approved_for_extension"]},
                "desiredState": {"enum": ["installed_disabled", "enabled", "uninstalling"]},
                "quarantineState": {"enum": ["clear", "quarantined"]},
                "runtimeState": {"enum": ["stopped", "starting", "running", "stopping", "crashed"]},
                "grantRevision": {"$ref": "#/$defs/revision"},
                "lifecycleGeneration": {"$ref": "#/$defs/revision"},
                "revision": {"$ref": "#/$defs/revision"},
                "ui": {"$ref": "#/$defs/uiDeclaration"}
            }
        },
        "session": {
            "type": "object", "additionalProperties": false,
            "required": ["sessionId", "extensionId", "locale", "idleTimeoutMs", "absoluteTimeoutMs"],
            "properties": {
                "sessionId": {"$ref": "#/$defs/sessionId"},
                "extensionId": {"$ref": "#/$defs/extensionId"},
                "locale": {"$ref": "#/$defs/locale"},
                "idleTimeoutMs": {"const": 300000},
                "absoluteTimeoutMs": {"const": 3600000}
            }
        },
        "openParams": {
            "type": "object", "additionalProperties": false,
            "required": ["extensionId", "locale"],
            "properties": {
                "extensionId": {"$ref": "#/$defs/extensionId"},
                "locale": {"$ref": "#/$defs/locale"}
            }
        },
        "refreshParams": {
            "type": "object", "additionalProperties": false,
            "required": ["sessionId", "expectedSnapshotRevision"],
            "properties": {
                "sessionId": {"$ref": "#/$defs/sessionId"},
                "expectedSnapshotRevision": {"$ref": "#/$defs/revision"}
            }
        },
        "dispatchParams": {
            "type": "object", "additionalProperties": false,
            "required": ["sessionId", "expectedSnapshotRevision", "sequence", "requestId", "action"],
            "properties": {
                "sessionId": {"$ref": "#/$defs/sessionId"},
                "expectedSnapshotRevision": {"$ref": "#/$defs/revision"},
                "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
                "requestId": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[!-~]+$"},
                "action": {
                    "$ref": "https://alcomd.cqmhv.com/schema/extensions/portable-ui-v1.json#/$defs/action"
                }
            }
        },
        "closeParams": {
            "type": "object", "additionalProperties": false, "required": ["sessionId"],
            "properties": {"sessionId": {"$ref": "#/$defs/sessionId"}}
        },
        "snapshot": {
            "$ref": "https://alcomd.cqmhv.com/schema/extensions/portable-ui-v1.json#/$defs/snapshot"
        },
        "openResult": {
            "type": "object", "additionalProperties": false, "required": ["session", "snapshot"],
            "properties": {
                "session": {"$ref": "#/$defs/session"},
                "snapshot": {"$ref": "#/$defs/snapshot"}
            }
        },
        "snapshotResult": {
            "type": "object", "additionalProperties": false, "required": ["snapshot"],
            "properties": {"snapshot": {"$ref": "#/$defs/snapshot"}}
        },
        "dispatchResult": {
            "type": "object", "additionalProperties": false, "required": ["snapshot", "replayed"],
            "properties": {
                "snapshot": {"$ref": "#/$defs/snapshot"},
                "replayed": {"type": "boolean"}
            }
        },
        "closeResult": {
            "type": "object", "additionalProperties": false, "required": ["closed"],
            "properties": {"closed": {"type": "boolean"}}
        }
    }
}
