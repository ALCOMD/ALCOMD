{
    "contractVersion": 1,
    "status": "implemented",
    "publicationRule": "add-to-command-catalog-and-help-only-after-production-capability-is-implemented",
    "commands": [
        {"path": ["backup", "list"], "rpc": "backups.list", "mutation": false},
        {"path": ["backup", "get"], "aliases": ["info"], "rpc": "backups.get", "mutation": false},
        {
            "path": ["backup", "create"],
            "rpc": "backups.create",
            "mutation": true,
            "planApply": false,
            "options": [
                "--expected-revision", "--compression", "--exclude-vpm-packages", "--include-library",
                "--idempotency-key", "--no-wait"
            ],
            "forbiddenOptions": ["--yes", "--dry-run", "--output"]
        },
        {
            "path": ["backup", "restore"],
            "arguments": ["backup-id", "target-parent", "target-leaf"],
            "rpc": ["backups.planRestore", "backups.applyRestore"],
            "mutation": true,
            "planApply": true,
            "published": true,
            "options": ["--idempotency-key", "--yes", "--dry-run", "--no-wait"],
            "defaultFlow": ["plan", "display-summary", "confirm", "apply", "follow"],
            "nonTtyWithoutYes": "confirmation_required",
            "dryRun": "persist-plan-only-no-operation-no-filesystem-write",
            "noWaitReturns": ["operationId", "projectId"]
        }
    ],
    "createContract": {
        "requiredArgument": "project-id",
        "compressionValues": ["store", "fast", "level3", "level5", "level7", "maximum"],
        "omittedOptionsUseAuthoritativeDefaults": ["compression", "exclude-vpm-packages", "include-library"],
        "booleanOptions": { "bareFlag": true, "explicitFalse": "--option=false" },
        "defaultWaitsForTerminalOperation": true,
        "noWaitReturns": ["operationId", "backupId"],
        "outputModes": ["human", "json", "ndjson"],
        "archiveAccess": "rpc-only-managed-root"
    },
    "plannedCommands": [],
    "restoreContract": {
        "targetState": "nonexistent-new-project-only",
        "forbiddenModes": ["in-place", "overwrite", "merge", "delete-then-restore"],
        "publication": "after-backups.restore.v1-production-capability"
    }
}
