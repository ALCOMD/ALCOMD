{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.vrclearn.com/schema/rpc/m8-mcp-clients-v1.json",
    "title": "M8 MCP client identity (approved; runtime wiring in progress)",
    "$defs": {
        "grant": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "permission": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-z][a-z0-9.-]*$"
                },
                "resourceKind": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[a-z][a-z0-9.-]*$"
                },
                "resourceId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[\\x21-\\x7e]+$"
                }
            },
            "required": [
                "permission",
                "resourceKind",
                "resourceId"
            ]
        },
        "authentication": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "const": "mcp-client"
                },
                "credential": {
                    "type": "string",
                    "minLength": 43,
                    "maxLength": 256,
                    "writeOnly": true,
                    "pattern": "^[\\x21-\\x7e]+$"
                }
            },
            "required": [
                "kind",
                "credential"
            ]
        },
        "createParams": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "grants": {
                    "type": "array",
                    "maxItems": 4096,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/grant"
                    },
                    "default": []
                },
                "idempotencyKey": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                }
            },
            "required": [
                "displayName",
                "idempotencyKey"
            ]
        },
        "mutationParams": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "clientId": {
                    "type": "string",
                    "format": "uuid"
                },
                "expectedRevision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9223372036854775807
                },
                "idempotencyKey": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                }
            },
            "required": [
                "clientId",
                "expectedRevision",
                "idempotencyKey"
            ]
        },
        "setGrantsParams": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "clientId": {
                    "type": "string",
                    "format": "uuid"
                },
                "expectedRevision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9223372036854775807
                },
                "grants": {
                    "type": "array",
                    "maxItems": 4096,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/grant"
                    }
                },
                "idempotencyKey": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                }
            },
            "required": [
                "clientId",
                "expectedRevision",
                "grants",
                "idempotencyKey"
            ]
        },
        "listParams": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "cursor": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "limit": {
                    "anyOf": [
                        {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 1000
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": []
        },
        "record": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "clientId": {
                    "type": "string",
                    "format": "uuid"
                },
                "principalId": {
                    "type": "string",
                    "pattern": "^mcp:[0-9a-f-]{36}$"
                },
                "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9223372036854775807
                },
                "createdAtMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                },
                "revokedAtMs": {
                    "anyOf": [
                        {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9223372036854775807
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "grants": {
                    "type": "array",
                    "maxItems": 4096,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/grant"
                    }
                }
            },
            "required": [
                "clientId",
                "principalId",
                "displayName",
                "revision",
                "createdAtMs",
                "revokedAtMs",
                "grants"
            ]
        },
        "listResult": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "items": {
                    "type": "array",
                    "maxItems": 64,
                    "items": {
                        "$ref": "#/$defs/record"
                    }
                },
                "nextCursor": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "items",
                "nextCursor"
            ]
        },
        "credentialResult": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "clientId": {
                    "type": "string",
                    "format": "uuid"
                },
                "credentialId": {
                    "type": "string",
                    "format": "uuid"
                },
                "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9223372036854775807
                },
                "credential": {
                    "type": "string",
                    "minLength": 43,
                    "maxLength": 256
                }
            },
            "required": [
                "clientId",
                "credentialId",
                "revision",
                "credential"
            ]
        }
    },
    "x-alcomd-methods": {
        "mcp.clients.list": {
            "params": {
                "$ref": "#/$defs/listParams"
            },
            "result": {
                "$ref": "#/$defs/listResult"
            },
            "permission": "mcp.clients.read"
        },
        "mcp.clients.create": {
            "params": {
                "$ref": "#/$defs/createParams"
            },
            "result": {
                "$ref": "#/$defs/record"
            },
            "permission": "mcp.clients.manage",
            "idempotencyKeyRequired": true
        },
        "mcp.clients.setGrants": {
            "params": {
                "$ref": "#/$defs/setGrantsParams"
            },
            "result": {
                "$ref": "#/$defs/record"
            },
            "permission": "mcp.clients.manage",
            "idempotencyKeyRequired": true
        },
        "mcp.clients.revoke": {
            "params": {
                "$ref": "#/$defs/mutationParams"
            },
            "result": {
                "$ref": "#/$defs/record"
            },
            "permission": "mcp.clients.manage",
            "idempotencyKeyRequired": true
        },
        "mcp.clients.issueCredential": {
            "params": {
                "$ref": "#/$defs/mutationParams"
            },
            "result": {
                "$ref": "#/$defs/credentialResult"
            },
            "permission": "mcp.clients.manage",
            "localOwnerOnly": true,
            "idempotencyKeyRequired": true
        }
    }
}
