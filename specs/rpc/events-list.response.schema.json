{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.cqmhv.com/schema/rpc/v1/events-list.response.json",
    "title": "ALCOMD RPC v1 events.list response",
    "type": "object",
    "additionalProperties": true,
    "required": ["id", "result"],
    "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "result": {
            "type": "object",
            "additionalProperties": true,
            "required": ["events", "nextSequence"],
            "properties": {
                "events": {"type": "array", "maxItems": 1000, "items": {"$ref": "event.schema.json"}},
                "nextSequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
            }
        }
    }
}
