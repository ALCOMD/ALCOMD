{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.cqmhv.com/schema/extensions/manifest-v1.json",
    "title": "ALCOMD Extension Manifest v1 parsed TOML object",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema", "id", "name", "version", "api", "publisher_name",
        "publisher_key_fingerprint", "license", "entrypoints", "interfaces", "permissions"
    ],
    "properties": {
        "schema": {"const": 1},
        "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 255,
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
        },
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "version": {
            "type": "string",
            "minLength": 5,
            "maxLength": 128,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "api": {"const": 1},
        "publisher_name": {"type": "string", "minLength": 1, "maxLength": 120},
        "publisher_key_fingerprint": {
            "type": "string",
            "pattern": "^ed25519-sha256:[0-9a-f]{64}$"
        },
        "license": {"type": "string", "minLength": 1, "maxLength": 128},
        "entrypoints": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component"],
            "properties": {
                "component": {"const": "component/extension.wasm"}
            }
        },
        "ui": {
            "type": "object",
            "additionalProperties": false,
            "required": ["protocol"],
            "properties": {
                "protocol": {"const": "portable-v1"}
            }
        },
        "interfaces": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "optional"],
            "properties": {
                "required": {"$ref": "#/$defs/interfaces"},
                "optional": {"$ref": "#/$defs/interfaces"}
            }
        },
        "permissions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "optional"],
            "properties": {
                "required": {"$ref": "#/$defs/permissions"},
                "optional": {"$ref": "#/$defs/permissions"}
            }
        }
    },
    "$defs": {
        "interfaces": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
        },
        "permissions": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9.-]*$"
            }
        }
    }
}
