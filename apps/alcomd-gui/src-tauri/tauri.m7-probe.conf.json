{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "ALCOMD M7 Isolation Probe",
    "version": "0.0.0",
    "identifier": "com.cqmhv.alcomd.m7-probe",
    "build": {
        "frontendDist": "../m7-probe-dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [],
        "security": {
            "capabilities": [
                {
                    "identifier": "m7-probe-main-only",
                    "description": "Test-only positive control for the M7 WebView isolation probe.",
                    "windows": ["m7-isolation-probe"],
                    "permissions": ["core:app:allow-name"]
                }
            ]
        }
    },
    "bundle": {
        "active": false
    }
}
