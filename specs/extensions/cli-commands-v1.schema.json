{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.vrclearn.com/schema/extensions/cli-commands-v1.json",
    "title": "Signed extension CLI commands",
    "x-max-serialized-bytes": 65536,
    "type": "object",
    "additionalProperties": false,
    "required": [
        "version",
        "commands"
    ],
    "properties": {
        "version": {
            "const": 1
        },
        "commands": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "name",
                    "title",
                    "description",
                    "inputSchema",
                    "outputSchema",
                    "uses"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,31}$"
                    },
                    "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                    },
                    "description": {
                        "type": "string",
                        "maxLength": 2048
                    },
                    "inputSchema": {
                        "type": "object"
                    },
                    "outputSchema": {
                        "type": "object"
                    },
                    "uses": {
                        "type": "array",
                        "maxItems": 6,
                        "uniqueItems": true,
                        "items": {
                            "enum": [
                                "projects.list",
                                "projects.get",
                                "packages.planUninstall",
                                "packages.applyPlan",
                                "operations.get",
                                "operations.cancel"
                            ]
                        }
                    }
                }
            }
        }
    },
    "$defs": {
        "preview": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "title",
                "description",
                "requiredPermissions",
                "effect"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                },
                "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                },
                "description": {
                    "type": "string",
                    "maxLength": 2048
                },
                "requiredPermissions": {
                    "type": "array",
                    "maxItems": 8,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                    }
                },
                "effect": {
                    "enum": [
                        "pure",
                        "read",
                        "plan",
                        "apply",
                        "cancel"
                    ]
                }
            }
        }
    },
    "x-schema-policy": {
        "draft": "2020-12",
        "externalRefs": false,
        "dynamicRefs": false,
        "cyclicRefs": false,
        "headerMapping": false,
        "validatorProcess": "supervised extension Host"
    }
}
