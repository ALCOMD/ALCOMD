{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.cqmhv.com/schema/config/settings-v3.json",
    "title": "ALCOMD Config Schema 3 settings",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema", "revision", "appearance", "packages", "locale"],
    "properties": {
        "schema": {"const": 3},
        "revision": {"$ref": "#/$defs/revision"},
        "appearance": {"$ref": "#/$defs/appearance"},
        "packages": {"$ref": "#/$defs/packages"},
        "locale": {"$ref": "#/$defs/locale"},
        "unity": {"$ref": "#/$defs/unitySettings"}
    },
    "$defs": {
        "revision": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "mode": {"enum": ["system", "light", "dark"]},
        "scheme": {"enum": ["tonal-spot", "fidelity", "monochrome", "neutral", "vibrant", "expressive", "content", "rainbow", "fruit-salad"]},
        "sourceColor": {"type": ["string", "null"], "pattern": "^#[0-9A-F]{6}$"},
        "density": {"enum": ["default", "compact"]},
        "motion": {"enum": ["system", "full", "reduced"]},
        "locale": {"enum": ["system", "en-US", "zh-CN", "ja-JP"]},
        "appearance": {
            "type": "object", "additionalProperties": false,
            "required": ["mode", "scheme", "sourceColor", "density", "motion"],
            "properties": {"mode": {"$ref": "#/$defs/mode"}, "scheme": {"$ref": "#/$defs/scheme"}, "sourceColor": {"$ref": "#/$defs/sourceColor"}, "density": {"$ref": "#/$defs/density"}, "motion": {"$ref": "#/$defs/motion"}}
        },
        "hiddenRepositoryIds": {
            "type": "array", "maxItems": 256, "uniqueItems": true,
            "items": {"$ref": "#/$defs/uuid"},
            "x-alcomd-order": "canonical-lexical-ascending",
            "x-alcomd-duplicates": "invalid_request"
        },
        "packages": {
            "type": "object", "additionalProperties": false,
            "required": ["showPrerelease", "hiddenRepositoryIds", "hideLocalUserPackages"],
            "properties": {"showPrerelease": {"type": "boolean"}, "hiddenRepositoryIds": {"$ref": "#/$defs/hiddenRepositoryIds"}, "hideLocalUserPackages": {"type": "boolean"}}
        },
        "hubPath": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001F\\u007F]+$", "x-alcomd-maxUtf8Bytes": 4096, "x-alcomd-validation": "Core-normalized absolute usable executable on explicit update"},
        "unitySettings": {"type": "object", "additionalProperties": false, "required": ["hubPath"], "properties": {"hubPath": {"$ref": "#/$defs/hubPath"}}},
        "partialUnityUpdate": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"hubPath": {"$ref": "#/$defs/hubPath"}}},
        "settings": {
            "type": "object", "additionalProperties": false,
            "required": ["appearance", "packages", "locale", "unity"],
            "properties": {"appearance": {"$ref": "#/$defs/appearance"}, "packages": {"$ref": "#/$defs/packages"}, "locale": {"$ref": "#/$defs/locale"}, "unity": {"$ref": "#/$defs/unitySettings"}}
        },
        "partialPackagesUpdate": {
            "type": "object", "additionalProperties": false, "minProperties": 1,
            "properties": {"showPrerelease": {"type": "boolean"}, "hiddenRepositoryIds": {"$ref": "#/$defs/hiddenRepositoryIds"}, "hideLocalUserPackages": {"type": "boolean"}}
        },
        "partialUpdate": {
            "type": "object", "additionalProperties": false, "minProperties": 1,
            "properties": {
                "appearance": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"mode": {"$ref": "#/$defs/mode"}, "scheme": {"$ref": "#/$defs/scheme"}, "sourceColor": {"$ref": "#/$defs/sourceColor"}, "density": {"$ref": "#/$defs/density"}, "motion": {"$ref": "#/$defs/motion"}}},
                "packages": {"$ref": "#/$defs/partialPackagesUpdate"},
                "locale": {"$ref": "#/$defs/locale"},
                "unity": {"$ref": "#/$defs/partialUnityUpdate"}
            }
        }
    },
    "x-alcomd-migration": {"from": [1, 2], "to": 3, "v1Path": "v1-to-v2-to-v3", "defaultScheme": "vibrant", "preserveRevision": true, "preserveExistingSettings": true, "runBeforeReady": true, "failure": "restore-valid-input-authority-and-fail-closed"},
    "x-alcomd-storage": {"path": "config/settings.toml", "writer": "alcomd", "maxUtf8Bytes": 16384, "maxHiddenRepositoryIds": 256, "unknownFields": "fail-closed", "replacement": "same-directory-synced-temp-then-recoverable-rename"}
}
