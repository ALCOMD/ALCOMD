{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.cqmhv.com/schema/rpc/v1/m3-project-repository.json",
    "title": "ALCOMD RPC v1 M3 project and repository contract",
    "$defs": {
        "uuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "idempotencyKey": {
            "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[!-~]+$"
        },
        "absolutePath": {"type": "string", "minLength": 1, "maxLength": 32768},
        "issue": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "component", "item"],
            "properties": {
                "code": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*$"},
                "component": {
                    "enum": ["project-version", "vpm-manifest", "upm-manifest", "repository", "package", "version"]
                },
                "item": {"type": "string", "maxLength": 2048},
                "line": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
                "column": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
            }
        },
        "dependency": {
            "type": "object", "additionalProperties": false, "required": ["packageId", "value"],
            "properties": {
                "packageId": {"type": "string", "minLength": 1, "maxLength": 1024},
                "value": {"type": "string", "minLength": 1, "maxLength": 1024}
            }
        },
        "projectSnapshot": {
            "type": "object",
            "additionalProperties": true,
            "required": [
                "projectId", "rootPath", "projectType", "unityVersion", "unityRevision",
                "vpmManifest", "upmManifest", "directDependencies", "lockedDependencies",
                "issues", "observedAtMs", "revision"
            ],
            "properties": {
                "projectId": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
                "registeredAtMs": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
                "rootPath": {"$ref": "#/$defs/absolutePath"},
                "projectType": {
                    "enum": [
                        "avatars", "worlds", "vpm-starter", "upm-avatars", "upm-worlds",
                        "upm-starter", "legacy-sdk2", "legacy-worlds", "legacy-avatars", "unknown"
                    ]
                },
                "unityVersion": {"type": "string", "minLength": 1, "maxLength": 128},
                "unityRevision": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
                "vpmManifest": {"enum": ["missing", "valid"]},
                "upmManifest": {"enum": ["missing", "valid"]},
                "directDependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}, "maxItems": 4096},
                "lockedDependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}, "maxItems": 4096},
                "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}, "maxItems": 1024},
                "observedAtMs": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
                "revision": {"oneOf": [{"$ref": "#/$defs/revision"}, {"type": "null"}]}
            }
        },
        "repositorySource": {
            "oneOf": [
                {
                    "type": "object", "additionalProperties": false, "required": ["kind", "path"],
                    "properties": {"kind": {"const": "local"}, "path": {"$ref": "#/$defs/absolutePath"}}
                },
                {
                    "type": "object", "additionalProperties": false, "required": ["kind", "url"],
                    "properties": {
                        "kind": {"const": "remote"},
                        "url": {"type": "string", "minLength": 1, "maxLength": 32768}
                    }
                }
            ]
        },
        "repository": {
            "type": "object",
            "additionalProperties": true,
            "required": ["repositoryId", "source", "declaredId", "name", "declaredUrl", "issues", "revision", "refreshedAtMs"],
            "properties": {
                "repositoryId": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
                "source": {"$ref": "#/$defs/repositorySource"},
                "declaredId": {"type": ["string", "null"], "minLength": 1, "maxLength": 1024},
                "name": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
                "declaredUrl": {"type": ["string", "null"], "minLength": 1, "maxLength": 32768},
                "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}, "maxItems": 1024},
                "revision": {"oneOf": [{"$ref": "#/$defs/revision"}, {"type": "null"}]},
                "refreshedAtMs": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
            }
        },
        "packageVersion": {
            "type": "object",
            "additionalProperties": true,
            "required": ["packageId", "version", "displayName", "description", "yanked", "unity"],
            "properties": {
                "packageId": {"type": "string", "minLength": 1, "maxLength": 1024},
                "version": {"type": "string", "minLength": 1, "maxLength": 1024},
                "displayName": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
                "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 65536},
                "yanked": {"type": "boolean"},
                "unity": {"type": ["string", "null"], "minLength": 1, "maxLength": 1024}
            }
        },
        "registryCursor": {
            "type": "object", "additionalProperties": false, "required": ["registeredAtMs", "id"],
            "properties": {
                "registeredAtMs": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
                "id": {"$ref": "#/$defs/uuid"}
            }
        },
        "packageCursor": {
            "type": "object", "additionalProperties": false, "required": ["packageId", "version"],
            "properties": {
                "packageId": {"type": "string", "minLength": 1, "maxLength": 1024},
                "version": {"type": "string", "minLength": 1, "maxLength": 1024}
            }
        },
        "pageLimit": {"type": "integer", "minimum": 1, "maximum": 1000},
        "projectInspectParams": {
            "type": "object", "additionalProperties": false, "required": ["path", "discoveryMode"],
            "properties": {
                "path": {"$ref": "#/$defs/absolutePath"},
                "discoveryMode": {"enum": ["exact-root", "search-parents"]}
            }
        },
        "registryListParams": {
            "type": "object", "additionalProperties": false,
            "properties": {
                "cursor": {"oneOf": [{"$ref": "#/$defs/registryCursor"}, {"type": "null"}]},
                "limit": {"$ref": "#/$defs/pageLimit"}
            }
        },
        "projectIdParams": {
            "type": "object", "additionalProperties": false, "required": ["projectId"],
            "properties": {"projectId": {"$ref": "#/$defs/uuid"}}
        },
        "projectRegisterParams": {
            "type": "object", "additionalProperties": false, "required": ["path", "idempotencyKey"],
            "properties": {
                "path": {"$ref": "#/$defs/absolutePath"},
                "idempotencyKey": {"$ref": "#/$defs/idempotencyKey"}
            }
        },
        "projectMutationParams": {
            "type": "object", "additionalProperties": false, "required": ["projectId", "expectedRevision", "idempotencyKey"],
            "properties": {
                "projectId": {"$ref": "#/$defs/uuid"},
                "expectedRevision": {"$ref": "#/$defs/revision"},
                "idempotencyKey": {"$ref": "#/$defs/idempotencyKey"}
            }
        },
        "repositoryInspectParams": {
            "type": "object", "additionalProperties": false, "required": ["source"],
            "properties": {"source": {"$ref": "#/$defs/repositorySource"}}
        },
        "repositoryIdParams": {
            "type": "object", "additionalProperties": false, "required": ["repositoryId"],
            "properties": {"repositoryId": {"$ref": "#/$defs/uuid"}}
        },
        "repositoryPackagesParams": {
            "type": "object", "additionalProperties": false, "required": ["repositoryId"],
            "properties": {
                "repositoryId": {"$ref": "#/$defs/uuid"},
                "cursor": {"oneOf": [{"$ref": "#/$defs/packageCursor"}, {"type": "null"}]},
                "limit": {"$ref": "#/$defs/pageLimit"}
            }
        },
        "repositoryRegisterParams": {
            "type": "object", "additionalProperties": false, "required": ["source", "idempotencyKey"],
            "properties": {
                "source": {"$ref": "#/$defs/repositorySource"},
                "idempotencyKey": {"$ref": "#/$defs/idempotencyKey"}
            }
        },
        "repositoryMutationParams": {
            "type": "object", "additionalProperties": false, "required": ["repositoryId", "expectedRevision", "idempotencyKey"],
            "properties": {
                "repositoryId": {"$ref": "#/$defs/uuid"},
                "expectedRevision": {"$ref": "#/$defs/revision"},
                "idempotencyKey": {"$ref": "#/$defs/idempotencyKey"}
            }
        }
    },
    "type": "object",
    "additionalProperties": true
}
