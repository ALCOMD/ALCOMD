{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://alcomd.vrclearn.com/schema/rpc/v1/native-sdk-v1.schema.json",
    "title": "ALCOMD native SDK v1 additional wire shapes",
    "$defs": {
        "BackupsListResult": {
            "type": "object",
            "properties": {
                "backups": {
                    "type": "array",
                    "items": {
                        "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m5-backup-create.json#/$defs/backupRecord"
                    }
                },
                "nextCursor": {
                    "type": "string"
                }
            },
            "required": [
                "backups"
            ]
        },
        "EmptyParams": {
            "type": "object",
            "additionalProperties": false
        },
        "PackageBulkIntent": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "kind",
                        "packageId",
                        "includePrerelease"
                    ],
                    "properties": {
                        "kind": {
                            "const": "install"
                        },
                        "packageId": {
                            "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/packageId"
                        },
                        "versionRange": {
                            "oneOf": [
                                {
                                    "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/versionText"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "source": {
                            "oneOf": [
                                {
                                    "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/sourceSelector"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "includePrerelease": {
                            "type": "boolean"
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "kind",
                        "packageId",
                        "includePrerelease"
                    ],
                    "properties": {
                        "kind": {
                            "const": "upgrade"
                        },
                        "packageId": {
                            "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/packageId"
                        },
                        "versionRange": {
                            "oneOf": [
                                {
                                    "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/versionText"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "source": {
                            "oneOf": [
                                {
                                    "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/sourceSelector"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "includePrerelease": {
                            "type": "boolean"
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "kind",
                        "packageId"
                    ],
                    "properties": {
                        "kind": {
                            "const": "remove"
                        },
                        "packageId": {
                            "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/packageId"
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "kind",
                        "packageId"
                    ],
                    "properties": {
                        "kind": {
                            "const": "reinstall"
                        },
                        "packageId": {
                            "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/packageId"
                        },
                        "source": {
                            "oneOf": [
                                {
                                    "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/sourceSelector"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        "PackageChangeSet": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "formatVersion",
                "mutations",
                "dependencyEdges",
                "vpmManifestSha256"
            ],
            "if": {
                "required": [
                    "legacyRemovals"
                ]
            },
            "then": {
                "properties": {
                    "formatVersion": {
                        "const": 4
                    }
                }
            },
            "allOf": [
                {
                    "if": {
                        "required": [
                            "unityCompatibilityOverrides"
                        ]
                    },
                    "then": {
                        "properties": {
                            "formatVersion": {
                                "const": 4
                            }
                        }
                    }
                },
                {
                    "if": {
                        "required": [
                            "removalConflicts"
                        ]
                    },
                    "then": {
                        "properties": {
                            "formatVersion": {
                                "const": 4
                            },
                            "mutations": {
                                "items": {
                                    "properties": {
                                        "kind": {
                                            "const": "remove"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            ],
            "properties": {
                "removalConflicts": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1024,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "packageId",
                            "requiredBy"
                        ],
                        "properties": {
                            "packageId": {
                                "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/packageId"
                            },
                            "requiredBy": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 4096,
                                "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                        "packageId",
                                        "range"
                                    ],
                                    "properties": {
                                        "packageId": {
                                            "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/packageId"
                                        },
                                        "range": {
                                            "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/versionText"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "unityCompatibilityOverrides": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "packageId",
                            "version"
                        ],
                        "properties": {
                            "packageId": {
                                "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/packageId"
                            },
                            "version": {
                                "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/versionText"
                            }
                        }
                    }
                },
                "formatVersion": {
                    "enum": [
                        1,
                        2,
                        3,
                        4
                    ]
                },
                "mutations": {
                    "type": "array",
                    "maxItems": 1024,
                    "items": {
                        "$ref": "#/$defs/PackageMutation"
                    }
                },
                "dependencyEdges": {
                    "type": "array",
                    "maxItems": 4096,
                    "items": {
                        "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/dependencyEdge"
                    }
                },
                "legacyRemovals": {
                    "type": "array",
                    "maxItems": 4096,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "path",
                            "kind",
                            "packageId"
                        ],
                        "properties": {
                            "path": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 1024
                            },
                            "kind": {
                                "enum": [
                                    "file",
                                    "directory"
                                ]
                            },
                            "packageId": {
                                "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/packageId"
                            }
                        }
                    }
                },
                "vpmManifestSha256": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/sha256"
                }
            }
        },
        "PackageMutation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "kind",
                "packageId",
                "fromVersion",
                "toVersion",
                "source"
            ],
            "properties": {
                "kind": {
                    "enum": [
                        "install",
                        "remove",
                        "replace"
                    ]
                },
                "packageId": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/packageId"
                },
                "fromVersion": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "minLength": 1,
                    "maxLength": 1024
                },
                "toVersion": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "minLength": 1,
                    "maxLength": 1024
                },
                "source": {
                    "oneOf": [
                        {
                            "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/sourcePin"
                        },
                        {
                            "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/userPackageSourcePinV2"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            }
        },
        "PackagePlan": {
            "type": "object",
            "additionalProperties": true,
            "required": [
                "planId",
                "action",
                "state",
                "projectId",
                "projectRevision",
                "changeSetFingerprint",
                "changeSet"
            ],
            "properties": {
                "planId": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/uuid"
                },
                "action": {
                    "enum": [
                        "install",
                        "remove",
                        "upgrade",
                        "downgrade",
                        "resolve",
                        "reinstall",
                        "bulk"
                    ]
                },
                "state": {
                    "enum": [
                        "unapplied",
                        "applied"
                    ]
                },
                "projectId": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/uuid"
                },
                "projectRevision": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/revision"
                },
                "changeSetFingerprint": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/sha256"
                },
                "changeSet": {
                    "$ref": "#/$defs/PackageChangeSet"
                }
            }
        },
        "PackagePlanBulkParams": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "projectId",
                "expectedRevision",
                "intents"
            ],
            "properties": {
                "projectId": {
                    "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/uuid"
                },
                "expectedRevision": {
                    "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/revision"
                },
                "intents": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 256,
                    "items": {
                        "$ref": "#/$defs/PackageBulkIntent"
                    }
                }
            }
        },
        "PackagePlanDowngradeParams": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "projectId",
                "expectedRevision",
                "packageId",
                "version"
            ],
            "properties": {
                "projectId": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/uuid"
                },
                "expectedRevision": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/revision"
                },
                "packageId": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/packageId"
                },
                "version": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/versionText"
                },
                "allowUnityIncompatible": {
                    "type": "boolean",
                    "default": false
                },
                "repositoryId": {
                    "oneOf": [
                        {
                            "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/uuid"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "source": {
                    "oneOf": [
                        {
                            "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/sourceSelector"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            }
        },
        "PackagePlanInstallParams": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "projectId",
                "expectedRevision",
                "packageId"
            ],
            "properties": {
                "projectId": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/uuid"
                },
                "expectedRevision": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/revision"
                },
                "packageId": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/packageId"
                },
                "versionRange": {
                    "oneOf": [
                        {
                            "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/versionText"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "repositoryId": {
                    "oneOf": [
                        {
                            "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m4-package-transaction.json#/$defs/uuid"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "includePrerelease": {
                    "type": "boolean",
                    "default": false
                },
                "allowUnityIncompatible": {
                    "type": "boolean",
                    "default": false
                },
                "source": {
                    "oneOf": [
                        {
                            "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/sourceSelector"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            }
        },
        "ProjectResult": {
            "type": "object",
            "properties": {
                "project": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m3-project-repository.json#/$defs/projectSnapshot"
                }
            },
            "required": [
                "project"
            ]
        },
        "ProjectUnregisterResult": {
            "type": "object",
            "properties": {
                "projectId": {
                    "type": "string"
                },
                "revision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                },
                "unregistered": {
                    "type": "boolean"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "projectId",
                "revision",
                "unregistered",
                "replayed"
            ]
        },
        "ProjectWriteResult": {
            "type": "object",
            "properties": {
                "project": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m3-project-repository.json#/$defs/projectSnapshot"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "project",
                "replayed"
            ]
        },
        "RepositoriesListResult": {
            "type": "object",
            "properties": {
                "repositories": {
                    "type": "array",
                    "items": {
                        "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m3-project-repository.json#/$defs/repository"
                    }
                },
                "nextCursor": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m3-project-repository.json#/$defs/registryCursor"
                }
            },
            "required": [
                "repositories"
            ]
        },
        "RepositoryPackagesResult": {
            "type": "object",
            "properties": {
                "packages": {
                    "type": "array",
                    "items": {
                        "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m3-project-repository.json#/$defs/packageVersion"
                    }
                },
                "nextCursor": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m3-project-repository.json#/$defs/packageCursor"
                }
            },
            "required": [
                "packages"
            ]
        },
        "RepositoryResult": {
            "type": "object",
            "properties": {
                "repository": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m3-project-repository.json#/$defs/repository"
                }
            },
            "required": [
                "repository"
            ]
        },
        "RepositoryUnregisterResult": {
            "type": "object",
            "properties": {
                "repositoryId": {
                    "type": "string"
                },
                "revision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                },
                "unregistered": {
                    "type": "boolean"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "repositoryId",
                "revision",
                "unregistered",
                "replayed"
            ]
        },
        "RepositoryWriteResult": {
            "type": "object",
            "properties": {
                "repository": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m3-project-repository.json#/$defs/repository"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "repository",
                "replayed"
            ]
        },
        "SettingsGetResult": {
            "type": "object",
            "additionalProperties": true,
            "required": [
                "configSchema",
                "revision",
                "settings",
                "unityHub",
                "directories"
            ],
            "properties": {
                "configSchema": {
                    "const": 13
                },
                "revision": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m7-official-gui.json#/$defs/revision"
                },
                "settings": {
                    "$ref": "https://alcomd.vrclearn.com/schema/config/settings-v13.json#/$defs/settings"
                },
                "unityHub": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m7-official-gui.json#/$defs/unityHubLocation"
                },
                "directories": {
                    "$ref": "https://alcomd.vrclearn.com/schema/config/settings-v13.json#/$defs/storageDirectories"
                }
            }
        },
        "UnityInstallationRemoveResult": {
            "type": "object",
            "properties": {
                "installationId": {
                    "type": "string"
                },
                "removed": {
                    "type": "boolean"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "installationId",
                "removed",
                "replayed"
            ]
        },
        "UnityInstallationResult": {
            "type": "object",
            "properties": {
                "installation": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m5-unity.json#/$defs/unityInstallation"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "installation",
                "replayed"
            ]
        },
        "UnityLaunchResult": {
            "type": "object",
            "properties": {
                "launch": {
                    "$ref": "https://alcomd.vrclearn.com/schema/rpc/v1/m5-unity.json#/$defs/launchRecord"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "launch",
                "replayed"
            ]
        },
        "UserPackageCursor": {
            "type": "object",
            "properties": {
                "updatedAtMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                },
                "userPackageId": {
                    "type": "string"
                }
            },
            "required": [
                "updatedAtMs",
                "userPackageId"
            ]
        },
        "UserPackageRemoveResult": {
            "type": "object",
            "properties": {
                "userPackageId": {
                    "type": "string"
                },
                "revision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                },
                "removed": {
                    "type": "boolean"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "userPackageId",
                "revision",
                "removed",
                "replayed"
            ]
        },
        "UserPackageResult": {
            "type": "object",
            "properties": {
                "userPackage": {
                    "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/userPackageRecord"
                }
            },
            "required": [
                "userPackage"
            ]
        },
        "UserPackageWriteResult": {
            "type": "object",
            "properties": {
                "userPackage": {
                    "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/userPackageRecord"
                },
                "replayed": {
                    "type": "boolean"
                }
            },
            "required": [
                "userPackage",
                "replayed"
            ]
        },
        "UserPackagesListResult": {
            "type": "object",
            "properties": {
                "userPackages": {
                    "type": "array",
                    "items": {
                        "$ref": "https://alcomd.vrclearn.com/schema/proposals/m7-p6-package-closure.json#/$defs/userPackageRecord"
                    }
                },
                "nextCursor": {
                    "$ref": "#/$defs/UserPackageCursor"
                }
            },
            "required": [
                "userPackages"
            ]
        }
    }
}
