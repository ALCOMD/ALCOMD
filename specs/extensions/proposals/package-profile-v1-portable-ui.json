{
    "status": "m7-stop-a-proposal-only",
    "replacesAfterApproval": "specs/extensions/package-profile-v1.json",
    "format": "alcomd-extension-package-v1",
    "suffix": ".alcomdext",
    "container": "zip",
    "zip64": false,
    "compressionMethods": ["stored", "deflate"],
    "requiredRootEntries": [
        "alcomd-extension.toml",
        "META-INF/alcomd-signature-v1.json",
        "component/extension.wasm"
    ],
    "allowedRoots": ["alcomd-extension.toml", "META-INF/", "component/"],
    "limits": {
        "archiveBytes": 67108864,
        "entries": 1024,
        "singleRegularFileBytes": 33554432,
        "totalUncompressedBytes": 134217728,
        "manifestBytes": 65536,
        "signatureEnvelopeBytes": 8192,
        "componentBytes": 33554432,
        "pathDepth": 16,
        "normalizedPathUtf8Bytes": 512,
        "expansionRatio": 100
    },
    "rejected": [
        "encrypted", "data-after-eocd", "traversal", "absolute", "device", "unc",
        "symlink", "reparse-point", "duplicate", "case-collision", "unicode-collision",
        "file-directory-collision", "special-entry", "unsupported-codec", "ui-root",
        "html-css-javascript", "static-image-font-web-asset"
    ],
    "normalization": "forward-slash+nfc+full-unicode-casefold-collision-v1",
    "contentDigest": "alcomd-extension-content-sha256-v1"
}
